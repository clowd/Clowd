<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>Clowd.Video</RootNamespace>
    <!-- The whole playback engine is a thin managed layer over the FFmpeg C API. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CA2007</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- 7.1.1 is the FFmpeg.AutoGen series generated against FFmpeg 7.1
         (avcodec 61 / avformat 61 / avutil 59 / swscale 8 / swresample 5) — the exact
         majors of the DLLs shipped in the obs-express folder. FFmpegLoader asserts the
         runtime majors match at initialize time. -->
    <PackageReference Include="FFmpeg.AutoGen.Abstractions" Version="7.1.1" />
    <PackageReference Include="FFmpeg.AutoGen.Bindings.DynamicallyLoaded" Version="7.1.1" />
    <!-- WASAPI output for the audio master clock; all call sites are Windows-only today. -->
    <PackageReference Include="NAudio.Wasapi" Version="2.3.0" />
  </ItemGroup>
</Project>
