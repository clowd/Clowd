{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "clowd_ui",
  "version": "0.1.0",
  "identifier": "com.clowd.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "../../assets/regular/regular-64x64.png",
      "../../assets/regular/regular-48x48.png",
      "../../assets/regular/regular-32x32.png",
      "../../assets/regular/regular-24x24.png",
      "../../assets/regular/regular-20x20.png",
      "../../assets/regular/regular-16x16.png",
      "../../assets/regular/regular.ico"
    ]
  }
}