<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:semi="https://irihi.tech/semi"
             x:Class="Clowd.App"
             Name="Clowd"
             RequestedThemeVariant="Default">

    <Application.Styles>
        <semi:SemiTheme />
        <!-- Ursa's Semi theme must come after semi:SemiTheme. Ursa 2.0 renamed it from
             SemiTheme to UrsaSemiTheme and moved it into the https://irihi.tech/semi
             namespace alongside Semi.Avalonia's own theme. -->
        <semi:UrsaSemiTheme />
        <StyleInclude Source="avares://Clowd.Ui/Assets/AppResources.axaml" />

    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Clowd.Ui/Assets/VectorGeometries.axaml" />
                <ResourceInclude Source="avares://Clowd.Ui/Assets/VectorIcons.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <!-- macOS app menu. Avalonia.Native fills in an "About Avalonia" item when the Application
         has no menu of its own, so setting one here replaces it with ours. -->
    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="About Clowd" Click="AppMenuAbout_Click" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="Recents &amp; Uploads" Click="AppMenuRecents_Click" />
            <NativeMenuItem Header="Settings…" Gesture="Cmd+OemComma" Click="AppMenuSettings_Click" />
        </NativeMenu>
    </NativeMenu.Menu>

    <!-- The TrayIcon + NativeMenu are created in code (App.axaml.cs SetupTrayIcon) so the
         menu can be rebuilt when hotkey settings change (decision table #48). -->

</Application>
