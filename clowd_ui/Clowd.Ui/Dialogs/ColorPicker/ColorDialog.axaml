<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cp="using:Clowd.UI.Dialogs.ColorPicker"
        xmlns:helpers="using:Clowd.UI.Helpers"
        xmlns:util="using:Clowd.Util"
        x:Class="Clowd.UI.Dialogs.ColorPicker.ColorDialog"
        Title="ColorEditor"
        SizeToContent="WidthAndHeight"
        CanResize="False"
        UseLayoutRounding="True"
        Background="{DynamicResource ApplicationBackgroundBrush}">

    <Window.Styles>
        <Style Selector="TextBlock.lbl">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="Consolas" />
        </Style>
        <Style Selector="cp|ColorSlider">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Background" Value="{x:Static util:CheckerBrushes.Medium}" />
        </Style>
        <Style Selector="TextBox.val">
            <Setter Property="Margin" Value="10,2,0,1" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.copy">
            <Setter Property="Margin" Value="10,0,0,0" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="Auto,Auto">

        <Grid Grid.Column="0" RowDefinitions="*,Auto">
            <cp:ColorWheel Width="200"
                           Height="200"
                           Margin="20"
                           CurrentColor="{Binding CurrentColor, Mode=TwoWay}" />

            <WrapPanel x:Name="ColorPalette"
                       Grid.Row="1"
                       Width="256"
                       Height="96"
                       Margin="10,0,10,10"
                       VerticalAlignment="Bottom"
                       Background="{x:Static util:CheckerBrushes.Medium}"
                       ItemHeight="16"
                       ItemWidth="16"
                       Orientation="Horizontal" />
        </Grid>

        <Grid Grid.Column="1"
              Margin="10"
              ColumnDefinitions="Auto,180,58"
              RowDefinitions="24,16,24,24,24,24,24,16,24,24,24,24,16,*,28">

            <Control x:Name="tabReset" Focusable="True" />

            <TextBlock Classes="lbl" Text="HEX:" />
            <TextBox x:Name="txtHex"
                     Grid.Column="1"
                     Classes="val"
                     Margin="0"
                     helpers:SelectTextOnFocus.Active="True" />
            <Button x:Name="btnCopyHex"
                    Grid.Column="2"
                    Classes="copy"
                    Click="CopyHexExecuted"
                    Content="Copy HEX" />

            <TextBlock Classes="lbl"
                       Grid.Row="2"
                       Grid.Column="1"
                       HorizontalAlignment="Left"
                       Text="{Binding TextRgb}" />
            <Button x:Name="btnCopyRgb"
                    Grid.Row="2"
                    Grid.Column="2"
                    Classes="copy"
                    Click="CopyRgbExecuted"
                    Content="Copy RGB" />

            <TextBlock Classes="lbl" Grid.Row="3" Text="R:" />
            <!-- Slider values are synced from code-behind (UpdateBrushes / ValueChanged);
                 TwoWay bindings to CurrentColor.* do not reliably write drag values back. -->
            <cp:ColorSlider x:Name="sliderR"
                            Grid.Row="3"
                            Grid.Column="1"
                            SliderBrush="{Binding SliderR}"
                            ValueMax="255" />
            <TextBox x:Name="txtClrR"
                     Grid.Row="3"
                     Grid.Column="2"
                     Classes="val"
                     helpers:SelectTextOnFocus.Active="True" />

            <TextBlock Classes="lbl" Grid.Row="4" Text="G:" />
            <cp:ColorSlider x:Name="sliderG"
                            Grid.Row="4"
                            Grid.Column="1"
                            SliderBrush="{Binding SliderG}"
                            ValueMax="255" />
            <TextBox x:Name="txtClrG"
                     Grid.Row="4"
                     Grid.Column="2"
                     Classes="val"
                     helpers:SelectTextOnFocus.Active="True" />

            <TextBlock Classes="lbl" Grid.Row="5" Text="B:" />
            <cp:ColorSlider x:Name="sliderB"
                            Grid.Row="5"
                            Grid.Column="1"
                            SliderBrush="{Binding SliderB}"
                            ValueMax="255" />
            <TextBox x:Name="txtClrB"
                     Grid.Row="5"
                     Grid.Column="2"
                     Classes="val"
                     helpers:SelectTextOnFocus.Active="True" />

            <TextBlock Classes="lbl" Grid.Row="6" Text="A:" />
            <cp:ColorSlider x:Name="sliderA"
                            Grid.Row="6"
                            Grid.Column="1"
                            SliderBrush="{Binding SliderA}"
                            ValueMax="1" />
            <TextBox x:Name="txtClrA"
                     Grid.Row="6"
                     Grid.Column="2"
                     Classes="val"
                     helpers:SelectTextOnFocus.Active="True" />

            <TextBlock Classes="lbl"
                       Grid.Row="8"
                       Grid.Column="1"
                       HorizontalAlignment="Left"
                       Text="{Binding TextHsl}" />
            <Button x:Name="btnCopyHsl"
                    Grid.Row="8"
                    Grid.Column="2"
                    Classes="copy"
                    Click="CopyHslExecuted"
                    Content="Copy HSL" />

            <TextBlock Classes="lbl" Grid.Row="9" Text="H:" />
            <cp:ColorSlider x:Name="sliderH"
                            Grid.Row="9"
                            Grid.Column="1"
                            SliderBrush="{Binding SliderH}"
                            ValueMax="360" />
            <TextBox x:Name="txtClrH"
                     Grid.Row="9"
                     Grid.Column="2"
                     Classes="val"
                     helpers:SelectTextOnFocus.Active="True" />

            <TextBlock Classes="lbl" Grid.Row="10" Text="S:" />
            <cp:ColorSlider x:Name="sliderS"
                            Grid.Row="10"
                            Grid.Column="1"
                            SliderBrush="{Binding SliderS}"
                            ValueMax="1" />
            <TextBox x:Name="txtClrS"
                     Grid.Row="10"
                     Grid.Column="2"
                     Classes="val"
                     helpers:SelectTextOnFocus.Active="True" />

            <TextBlock Classes="lbl" Grid.Row="11" Text="L:" />
            <cp:ColorSlider x:Name="sliderL"
                            Grid.Row="11"
                            Grid.Column="1"
                            SliderBrush="{Binding SliderL}"
                            ValueMax="1" />
            <TextBox x:Name="txtClrL"
                     Grid.Row="11"
                     Grid.Column="2"
                     Classes="val"
                     helpers:SelectTextOnFocus.Active="True" />

            <StackPanel Grid.Row="14"
                        Grid.ColumnSpan="3"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="10">
                <Border Width="108"
                        Background="{x:Static util:CheckerBrushes.Medium}"
                        BorderBrush="{Binding Foreground}"
                        BorderThickness="1">
                    <Border x:Name="currentSwatch" ClipToBounds="True">
                        <Path x:Name="pathPrevColor"
                              Data="M 0,0 H 60 L 48,28 H 0 Z"
                              PointerPressed="PrevColorClicked" />
                    </Border>
                </Border>
                <Button x:Name="btnCancel"
                        Padding="12,0"
                        Click="CloseClicked"
                        IsCancel="True"
                        Content="Cancel" />
                <Button x:Name="btnOK"
                        Theme="{StaticResource SolidButton}"
                        Classes="Primary"
                        Padding="14,0"
                        Click="OKClicked"
                        IsDefault="True"
                        Content="OK" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
