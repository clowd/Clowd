<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Clowd.UI.Controls"
        xmlns:cp="using:Clowd.UI.Dialogs.ColorPicker"
        xmlns:helpers="using:Clowd.UI.Helpers"
        xmlns:util="using:Clowd.Util"
        x:Class="Clowd.UI.Dialogs.ColorPicker.ColorDialog"
        Title="Color Editor"
        SizeToContent="WidthAndHeight"
        CanResize="False"
        UseLayoutRounding="True"
        Background="{DynamicResource ApplicationBackgroundBrush}">

    <Window.Styles>
        <!-- labels and value readouts are monospaced (channel data aligns nicely); the grid is
             sized generously so Consolas at theme size never clips -->
        <Style Selector="TextBlock.lbl">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontFamily" Value="Consolas" />
        </Style>
        <Style Selector="cp|ColorSlider">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Background" Value="{x:Static util:CheckerBrushes.Medium}" />
        </Style>
        <!-- .val and .copy share the fixed value column: identical left margin + Stretch keeps
             the textboxes and copy buttons the exact same width -->
        <Style Selector="TextBox.val">
            <Setter Property="Margin" Value="10,2,0,2" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="Consolas" />
        </Style>
        <Style Selector="Button.copy">
            <Setter Property="Margin" Value="10,0,0,0" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="Auto,Auto">

        <Grid Grid.Column="0" RowDefinitions="*,Auto">
            <cp:ColorWheel Width="200"
                           Height="200"
                           Margin="20"
                           CurrentColor="{Binding CurrentColor, Mode=TwoWay}" />

            <WrapPanel x:Name="ColorPalette"
                       Grid.Row="1"
                       Width="256"
                       Height="96"
                       Margin="10,0,10,10"
                       VerticalAlignment="Bottom"
                       Background="{x:Static util:CheckerBrushes.Medium}"
                       ItemHeight="16"
                       ItemWidth="16"
                       Orientation="Horizontal" />
        </Grid>

        <!-- rows/columns are sized for the theme font (the old 24px rows and 58px value
             column were tuned for 9px Consolas and clipped anything larger) -->
        <Grid Grid.Column="1"
              Margin="12"
              ColumnDefinitions="Auto,190,86"
              RowDefinitions="30,12,30,30,30,30,30,12,30,30,30,30,16,*,32">

            <Control x:Name="tabReset" Focusable="True" />

            <TextBlock Classes="lbl" Text="HEX:" />
            <TextBox x:Name="txtHex"
                     Grid.Column="1"
                     Classes="val"
                     Margin="0"
                     helpers:SelectTextOnFocus.Active="True" />
            <controls:AcceleratedButton x:Name="btnCopyHex"
                                        Grid.Column="2"
                                        Classes="copy"
                                        Click="CopyHexExecuted"
                                        Content="Copy HE_X" />

            <TextBlock Classes="lbl"
                       Grid.Row="2"
                       Grid.Column="1"
                       HorizontalAlignment="Left"
                       Text="{Binding TextRgb}" />
            <controls:AcceleratedButton x:Name="btnCopyRgb"
                                        Grid.Row="2"
                                        Grid.Column="2"
                                        Classes="copy"
                                        Click="CopyRgbExecuted"
                                        Content="Copy _RGB" />

            <TextBlock Classes="lbl" Grid.Row="3" Text="R:" />
            <!-- Slider values are synced from code-behind (UpdateBrushes / ValueChanged);
                 TwoWay bindings to CurrentColor.* do not reliably write drag values back. -->
            <cp:ColorSlider x:Name="sliderR"
                            Grid.Row="3"
                            Grid.Column="1"
                            SliderBrush="{Binding SliderR}"
                            ValueMax="255" />
            <TextBox x:Name="txtClrR"
                     Grid.Row="3"
                     Grid.Column="2"
                     Classes="val"
                     helpers:SelectTextOnFocus.Active="True" />

            <TextBlock Classes="lbl" Grid.Row="4" Text="G:" />
            <cp:ColorSlider x:Name="sliderG"
                            Grid.Row="4"
                            Grid.Column="1"
                            SliderBrush="{Binding SliderG}"
                            ValueMax="255" />
            <TextBox x:Name="txtClrG"
                     Grid.Row="4"
                     Grid.Column="2"
                     Classes="val"
                     helpers:SelectTextOnFocus.Active="True" />

            <TextBlock Classes="lbl" Grid.Row="5" Text="B:" />
            <cp:ColorSlider x:Name="sliderB"
                            Grid.Row="5"
                            Grid.Column="1"
                            SliderBrush="{Binding SliderB}"
                            ValueMax="255" />
            <TextBox x:Name="txtClrB"
                     Grid.Row="5"
                     Grid.Column="2"
                     Classes="val"
                     helpers:SelectTextOnFocus.Active="True" />

            <TextBlock Classes="lbl" Grid.Row="6" Text="A:" />
            <cp:ColorSlider x:Name="sliderA"
                            Grid.Row="6"
                            Grid.Column="1"
                            SliderBrush="{Binding SliderA}"
                            ValueMax="1" />
            <TextBox x:Name="txtClrA"
                     Grid.Row="6"
                     Grid.Column="2"
                     Classes="val"
                     helpers:SelectTextOnFocus.Active="True" />

            <TextBlock Classes="lbl"
                       Grid.Row="8"
                       Grid.Column="1"
                       HorizontalAlignment="Left"
                       Text="{Binding TextHsl}" />
            <controls:AcceleratedButton x:Name="btnCopyHsl"
                                        Grid.Row="8"
                                        Grid.Column="2"
                                        Classes="copy"
                                        Click="CopyHslExecuted"
                                        Content="Copy _HSL" />

            <TextBlock Classes="lbl" Grid.Row="9" Text="H:" />
            <cp:ColorSlider x:Name="sliderH"
                            Grid.Row="9"
                            Grid.Column="1"
                            SliderBrush="{Binding SliderH}"
                            ValueMax="360" />
            <TextBox x:Name="txtClrH"
                     Grid.Row="9"
                     Grid.Column="2"
                     Classes="val"
                     helpers:SelectTextOnFocus.Active="True" />

            <TextBlock Classes="lbl" Grid.Row="10" Text="S:" />
            <cp:ColorSlider x:Name="sliderS"
                            Grid.Row="10"
                            Grid.Column="1"
                            SliderBrush="{Binding SliderS}"
                            ValueMax="1" />
            <TextBox x:Name="txtClrS"
                     Grid.Row="10"
                     Grid.Column="2"
                     Classes="val"
                     helpers:SelectTextOnFocus.Active="True" />

            <TextBlock Classes="lbl" Grid.Row="11" Text="L:" />
            <cp:ColorSlider x:Name="sliderL"
                            Grid.Row="11"
                            Grid.Column="1"
                            SliderBrush="{Binding SliderL}"
                            ValueMax="1" />
            <TextBox x:Name="txtClrL"
                     Grid.Row="11"
                     Grid.Column="2"
                     Classes="val"
                     helpers:SelectTextOnFocus.Active="True" />

            <StackPanel Grid.Row="14"
                        Grid.ColumnSpan="3"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="10">
                <Border Width="108"
                        Height="30"
                        VerticalAlignment="Center"
                        CornerRadius="4"
                        Background="{x:Static util:CheckerBrushes.Medium}"
                        BorderBrush="{Binding Foreground}"
                        BorderThickness="1">
                    <!-- the rounded Clip (not just ClipToBounds) keeps the previous-color
                         wedge from poking out of the corners -->
                    <Border x:Name="currentSwatch" ClipToBounds="True" CornerRadius="3">
                        <Border.Clip>
                            <RectangleGeometry Rect="0,0,106,28" RadiusX="3" RadiusY="3" />
                        </Border.Clip>
                        <Path x:Name="pathPrevColor"
                              Data="M 0,0 H 60 L 48,28 H 0 Z"
                              PointerPressed="PrevColorClicked" />
                    </Border>
                </Border>
                <!-- affirmative-first, matching MessageDialog / FontDialog (Windows order) -->
                <controls:AcceleratedButton x:Name="btnOK"
                                            Theme="{StaticResource SolidButton}"
                                            Classes="Primary"
                                            Padding="14,0"
                                            Click="OKClicked"
                                            IsDefault="True"
                                            Content="_OK" />
                <controls:AcceleratedButton x:Name="btnCancel"
                                            Padding="12,0"
                                            Click="CloseClicked"
                                            IsCancel="True"
                                            Content="_Cancel" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
