<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Clowd.UI.Controls"
             xmlns:local="using:Clowd.UI.Dialogs.ColorPicker"
             xmlns:util="using:Clowd.Util"
             x:Class="Clowd.UI.Dialogs.ColorPicker.MiniColorDialog">

    <UserControl.Styles>
        <!-- one component of the color readout: a value box with its channel letter beneath,
             the way devtools lays out its rgba/hsla fields -->
        <Style Selector="TextBox.comp">
            <Setter Property="Height" Value="24" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="1,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#5A5A5A" />
            <Setter Property="CaretBrush" Value="White" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.complbl">
            <Setter Property="Margin" Value="0,1,0,0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Foreground" Value="#9A9A9A" />
        </Style>
    </UserControl.Styles>

    <!-- WPF DropShadowEffect replaced by BoxShadow (decision table #61). -->
    <Border Padding="8"
            Background="#202124"
            BorderBrush="#464648"
            BorderThickness="1"
            CornerRadius="8"
            BoxShadow="0 2 8 0 #80000000">
        <Grid Width="192" RowDefinitions="120,Auto,Auto,Auto,Auto,Auto,Auto">

            <Border x:Name="CanvasBackground"
                    Grid.Row="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="Black"
                    CornerRadius="2">
                <!-- SV square: horizontal white->hue gradient (set from code) under a vertical
                     white->transparent OpacityMask (decision table #62). -->
                <Border x:Name="SvSquare"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        CornerRadius="2"
                        IsHitTestVisible="False">
                    <Border.OpacityMask>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                            <GradientStop Offset="0" Color="White" />
                            <GradientStop Offset="1" Color="Transparent" />
                        </LinearGradientBrush>
                    </Border.OpacityMask>
                </Border>
            </Border>

            <Canvas Grid.Row="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    IsHitTestVisible="False">
                <Border x:Name="CanvasPointer"
                        Width="12"
                        Height="12"
                        BorderBrush="Black"
                        BorderThickness="1"
                        CornerRadius="10">
                    <Border Width="10"
                            Height="10"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            BorderBrush="White"
                            BorderThickness="1"
                            CornerRadius="10" />
                </Border>
            </Canvas>

            <!-- Slider values are synced from code-behind (Update / ValueChanged); TwoWay
                 bindings to CurrentColor.* were unreliable and moved other controls. -->
            <local:ColorSlider x:Name="HueSlider"
                               Grid.Row="1"
                               Height="16"
                               Margin="0,8"
                               CornerRadius="2"
                               ValueMax="360">
                <local:ColorSlider.SliderBrush>
                    <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                        <GradientStop Offset="0" Color="Red" />
                        <GradientStop Offset="0.1666" Color="Yellow" />
                        <GradientStop Offset="0.3333" Color="Lime" />
                        <GradientStop Offset="0.5" Color="Cyan" />
                        <GradientStop Offset="0.6666" Color="Blue" />
                        <GradientStop Offset="0.8333" Color="Magenta" />
                        <GradientStop Offset="1" Color="Red" />
                    </LinearGradientBrush>
                </local:ColorSlider.SliderBrush>
            </local:ColorSlider>

            <Border Grid.Row="2"
                    Margin="0,4"
                    Background="{x:Static util:CheckerBrushes.Medium}"
                    CornerRadius="2">
                <!-- SliderBrush (transparent -> opaque current color) is set from code. -->
                <local:ColorSlider x:Name="AlphaSlider"
                                   Height="16"
                                   CornerRadius="2"
                                   ValueMax="1" />
            </Border>

            <!-- Color readout. HEX is a single full-width box; RGB and HSL split into one box
                 per channel (the notation cycler lives in the bottom row). Slot 0 is reused as
                 the hex box, spanning all four columns — see UpdateComponentLayout. -->
            <Grid x:Name="grdComponents"
                  Grid.Row="3"
                  Margin="0,8"
                  ColumnDefinitions="*,*,*,*">
                <StackPanel x:Name="pnlComp0" Margin="1,0">
                    <TextBox x:Name="txtComp0" Classes="comp" />
                    <TextBlock x:Name="lblComp0" Classes="complbl" />
                </StackPanel>
                <StackPanel x:Name="pnlComp1" Grid.Column="1" Margin="1,0">
                    <TextBox x:Name="txtComp1" Classes="comp" />
                    <TextBlock x:Name="lblComp1" Classes="complbl" />
                </StackPanel>
                <StackPanel x:Name="pnlComp2" Grid.Column="2" Margin="1,0">
                    <TextBox x:Name="txtComp2" Classes="comp" />
                    <TextBlock x:Name="lblComp2" Classes="complbl" />
                </StackPanel>
                <StackPanel x:Name="pnlComp3" Grid.Column="3" Margin="1,0">
                    <TextBox x:Name="txtComp3" Classes="comp" />
                    <TextBlock x:Name="lblComp3" Classes="complbl" />
                </StackPanel>
            </Grid>

            <WrapPanel x:Name="pnlPalette"
                       Grid.Row="4"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Bottom"
                       Background="{x:Static util:CheckerBrushes.Medium}"
                       ItemHeight="16"
                       ItemWidth="16"
                       Orientation="Horizontal">
                <local:ColorPaletteItem Clicked="PaletteItemClicked" Color="Transparent" />
                <local:ColorPaletteItem Clicked="PaletteItemClicked" Color="Black" />
                <local:ColorPaletteItem Clicked="PaletteItemClicked" Color="#404040" />
                <local:ColorPaletteItem Clicked="PaletteItemClicked" Color="#808080" />
                <local:ColorPaletteItem Clicked="PaletteItemClicked" Color="#A0A0A0" />
                <local:ColorPaletteItem Clicked="PaletteItemClicked" Color="#C0C0C0" />
                <local:ColorPaletteItem Clicked="PaletteItemClicked" Color="White" />
                <local:ColorPaletteItem Clicked="PaletteItemClicked" Color="Firebrick" />
                <local:ColorPaletteItem Clicked="PaletteItemClicked" Color="Red" />
                <local:ColorPaletteItem Clicked="PaletteItemClicked" Color="OrangeRed" />
                <local:ColorPaletteItem Clicked="PaletteItemClicked" Color="Salmon" />
                <local:ColorPaletteItem Clicked="PaletteItemClicked" Color="Orange" />
                <local:ColorPaletteItem Clicked="PaletteItemClicked" Color="Yellow" />
                <local:ColorPaletteItem Clicked="PaletteItemClicked" Color="GreenYellow" />
                <local:ColorPaletteItem Clicked="PaletteItemClicked" Color="Lime" />
                <local:ColorPaletteItem Clicked="PaletteItemClicked" Color="LightSeaGreen" />
                <local:ColorPaletteItem Clicked="PaletteItemClicked" Color="Cyan" />
                <local:ColorPaletteItem Clicked="PaletteItemClicked" Color="#0094FF" />
                <local:ColorPaletteItem Clicked="PaletteItemClicked" Color="#0026FF" />
                <local:ColorPaletteItem Clicked="PaletteItemClicked" Color="#4800FF" />
                <local:ColorPaletteItem Clicked="PaletteItemClicked" Color="#B200FF" />
                <local:ColorPaletteItem Clicked="PaletteItemClicked" Color="#FF00DC" />
                <local:ColorPaletteItem Clicked="PaletteItemClicked" Color="HotPink" />
                <local:ColorPaletteItem Clicked="PaletteItemClicked" Color="Pink" />
            </WrapPanel>

            <!-- recently used custom colors (RecentColorHistory); populated from code-behind and
                 exactly one 12-swatch row wide, so the panel never reflows the dialog -->
            <WrapPanel x:Name="pnlRecent"
                       Grid.Row="5"
                       Margin="0,6,0,0"
                       HorizontalAlignment="Stretch"
                       Background="{x:Static util:CheckerBrushes.Medium}"
                       ItemHeight="16"
                       ItemWidth="16"
                       Orientation="Horizontal" />

            <DockPanel Grid.Row="6"
                       Margin="0,8,0,0"
                       HorizontalAlignment="Stretch">
                <controls:ToolButton Click="ButtonPopoutClicked"
                                     DockPanel.Dock="Left"
                                     IconPath="{StaticResource IconPopout}"
                                     ToolTip.Tip="Open in full color picker" />
                <local:EyedropperButton x:Name="btnEyedropper"
                                        DockPanel.Dock="Left"
                                        IconPath="{StaticResource IconEyedropper}"
                                        ToolTip.Tip="Drag onto any pixel on screen to pick its color" />
                <!-- notation cycler; fixed width so cycling HEX/RGB/HSL never reflows the row -->
                <Button x:Name="btnTextFormat"
                        Width="40"
                        Height="24"
                        MinWidth="0"
                        MinHeight="0"
                        Padding="0"
                        VerticalAlignment="Center"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Background="Transparent"
                        BorderBrush="#5A5A5A"
                        Click="ButtonTextFormatClicked"
                        DockPanel.Dock="Right"
                        FontFamily="Consolas"
                        FontSize="11"
                        Foreground="White"
                        ToolTip.Tip="Switch between HEX, RGB and HSL" />
                <Rectangle />
            </DockPanel>
        </Grid>
    </Border>

</UserControl>
