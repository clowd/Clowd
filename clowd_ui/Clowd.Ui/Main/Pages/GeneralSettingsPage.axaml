<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Clowd.UI.Pages.GeneralSettingsPage">

    <ScrollViewer>
        <StackPanel Margin="0,0,24,24" Spacing="16">
            <!-- WPF GroupBox -> HeaderedContentControl using Semi's keyed GroupBox ControlTheme
                 (decision table #54; the Semi implicit HeaderedContentControl theme is plain,
                 the groupbox look is the keyed "GroupBox" theme). -->
            <!-- The WPF "Updates" group (Squirrel) is not available in this build. -->
            <HeaderedContentControl Header="Behavior" Theme="{StaticResource GroupBox}">
                <StackPanel Spacing="8">
                    <CheckBox IsChecked="{Binding ConfirmClose}">
                        <TextBlock Text="Ask/confirm before exiting" />
                    </CheckBox>
                </StackPanel>
            </HeaderedContentControl>
            <HeaderedContentControl Header="Shell" Theme="{StaticResource GroupBox}">
                <StackPanel Spacing="8">
                    <CheckBox IsChecked="{Binding RegisterExplorerContextMenu}" IsEnabled="False">
                        <TextBlock Text="Add context menu to Explorer (not available in this build)" />
                    </CheckBox>
                    <CheckBox IsChecked="{Binding RegisterAutoStart}" IsEnabled="False">
                        <TextBlock Text="Start Clowd with Windows (not available in this build)" />
                    </CheckBox>
                </StackPanel>
            </HeaderedContentControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
