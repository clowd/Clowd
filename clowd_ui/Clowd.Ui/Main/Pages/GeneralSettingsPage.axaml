<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Clowd.UI.Controls"
    x:Class="Clowd.UI.Pages.GeneralSettingsPage">

    <UserControl.Styles>
        <!-- Vertical rhythm matched to the generated settings pages (SettingsControlFactory
             .AddRowToGrid): 24px between one setting and the next, 2px between a control and its
             own caption. Each setting is a "Setting"-classed StackPanel holding the control
             followed by its caption; the group's own panel spaces those blocks apart. -->
        <Style Selector="StackPanel.SettingsGroup">
            <Setter Property="Spacing" Value="24" />
        </Style>
        <Style Selector="StackPanel.Setting">
            <Setter Property="Spacing" Value="2" />
        </Style>
        <Style Selector="StackPanel.SettingRow">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Spacing" Value="12" />
        </Style>
        <!-- Permission status pill: the class is toggled from code-behind so the colours stay with
             the rest of the page's styling rather than being poked in as brushes. -->
        <Style Selector="TextBlock.PermissionStatus">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.PermissionStatus.Granted">
            <Setter Property="Foreground" Value="{DynamicResource SemiColorSuccess}" />
        </Style>
        <Style Selector="TextBlock.PermissionStatus.Missing">
            <Setter Property="Foreground" Value="{DynamicResource SemiColorWarning}" />
        </Style>
        <Style Selector="TextBlock.Caption">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MaxWidth" Value="560" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
    </UserControl.Styles>

    <controls:FadeEdgeScrollViewer>
        <StackPanel Margin="0,0,16,16" Spacing="16">
            <!-- WPF GroupBox -> HeaderedContentControl using Semi's keyed GroupBox ControlTheme
                 (decision table #54; the Semi implicit HeaderedContentControl theme is plain,
                 the groupbox look is the keyed "GroupBox" theme). -->
            <!-- The WPF "Shell" group's auto-start checkbox lives under Behavior in this build; the
                 context menu entry it kept is Windows-only and is disabled elsewhere
                 (see InitializeContextMenu). -->

            <!-- macOS only, and deliberately first: until Screen Recording is granted Clowd cannot
                 capture anything at all, so on a fresh Mac install this is the one thing on the page
                 that matters. Collapsed entirely on Windows/Linux, where there is nothing to grant
                 (MacPermissions.IsRelevant), leaving Updates first as before. Status is re-read on
                 every window activation, since the user grants these over in System Settings and
                 then comes back. -->
            <HeaderedContentControl x:Name="PermissionsGroup"
                                    Header="Permissions"
                                    IsVisible="False"
                                    Theme="{StaticResource GroupBox}">
                <StackPanel Classes="SettingsGroup">
                    <StackPanel Classes="Setting" Spacing="8">
                        <StackPanel Classes="SettingRow">
                            <TextBlock VerticalAlignment="Center" Text="Screen Recording" />
                            <TextBlock x:Name="ScreenRecordingStatus" Classes="PermissionStatus" VerticalAlignment="Center" />
                            <Button x:Name="ScreenRecordingButton" Click="OnScreenRecordingClick" />
                        </StackPanel>
                        <TextBlock x:Name="ScreenRecordingCaption" Classes="Caption" />
                    </StackPanel>

                    <StackPanel Classes="Setting" Spacing="8">
                        <StackPanel Classes="SettingRow">
                            <TextBlock VerticalAlignment="Center" Text="Accessibility" />
                            <TextBlock x:Name="AccessibilityStatus" Classes="PermissionStatus" VerticalAlignment="Center" />
                            <Button x:Name="AccessibilityButton" Click="OnAccessibilityClick" />
                        </StackPanel>
                        <TextBlock x:Name="AccessibilityCaption" Classes="Caption" />
                    </StackPanel>
                </StackPanel>
            </HeaderedContentControl>

            <HeaderedContentControl Header="Updates" Theme="{StaticResource GroupBox}">
                <StackPanel Classes="SettingsGroup">
                    <StackPanel Classes="Setting" Spacing="8">
                        <TextBlock x:Name="VersionText" />
                        <StackPanel Classes="SettingRow">
                            <Button x:Name="UpdateButton" Content="Check for Updates" Click="OnUpdateButtonClick" />
                            <ProgressBar x:Name="UpdateProgress"
                                         Width="180"
                                         VerticalAlignment="Center"
                                         Minimum="0" Maximum="100"
                                         IsVisible="False" />
                        </StackPanel>
                        <TextBlock x:Name="UpdateStatusText" Classes="Caption" />
                    </StackPanel>

                    <StackPanel Classes="Setting" Spacing="8">
                        <CheckBox x:Name="AutoDownloadCheck" IsChecked="{Binding AutoDownloadUpdates}">
                            <TextBlock Text="Automatically check for and download updates" TextWrapping="Wrap" />
                        </CheckBox>
                        <StackPanel Classes="SettingRow" IsEnabled="{Binding AutoDownloadUpdates}">
                            <TextBlock VerticalAlignment="Center" Text="Check" />
                            <ComboBox x:Name="UpdateIntervalCombo" MinWidth="160" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Classes="Setting">
                        <CheckBox x:Name="AutoApplyCheck" IsChecked="{Binding AutoApplyUpdates}">
                            <TextBlock Text="Automatically restart Clowd to apply updates in the background"
                                       TextWrapping="Wrap" />
                        </CheckBox>
                        <TextBlock Classes="Caption"
                                   Text="The restart happens only once you have been away from the computer for 10 minutes, and never while a capture, recording or upload is running." />
                    </StackPanel>

                    <StackPanel x:Name="PrereleaseSection" Classes="Setting">
                        <CheckBox x:Name="PrereleaseCheck" IsChecked="{Binding IncludePrereleaseUpdates}">
                            <TextBlock Text="Opt-in to experimental builds" TextWrapping="Wrap" />
                        </CheckBox>
                        <TextBlock x:Name="PrereleaseHelpText" Classes="Caption"
                                   Text="Bleeding edge releases may have newer preview features, but also may have more bugs than stable releases." />
                    </StackPanel>
                </StackPanel>
            </HeaderedContentControl>
            <HeaderedContentControl Header="Appearance" Theme="{StaticResource GroupBox}">
                <StackPanel Classes="SettingsGroup">
                    <StackPanel Classes="Setting">
                        <StackPanel Classes="SettingRow">
                            <TextBlock VerticalAlignment="Center" Text="Theme" />
                            <ComboBox x:Name="ThemeCombo" MinWidth="160" />
                        </StackPanel>
                        <TextBlock Classes="Caption"
                                   Text="Choose the light or dark appearance, or follow the Windows setting." />
                    </StackPanel>
                </StackPanel>
            </HeaderedContentControl>
            <HeaderedContentControl Header="Behavior" Theme="{StaticResource GroupBox}">
                <StackPanel Classes="SettingsGroup">
                    <StackPanel Classes="Setting">
                        <CheckBox x:Name="AutoStartCheck" IsChecked="{Binding RegisterAutoStart}">
                            <TextBlock Text="Start Clowd when your computer starts up" />
                        </CheckBox>
                        <TextBlock x:Name="AutoStartStatusText" Classes="Caption" IsVisible="False" />
                    </StackPanel>

                    <StackPanel Classes="Setting">
                        <CheckBox IsChecked="{Binding StartMinimized}">
                            <TextBlock Text="Start Clowd minimised" />
                        </CheckBox>
                        <TextBlock Classes="Caption"
                                   Text="Clowd starts in the notification area without opening this window." />
                    </StackPanel>

                    <StackPanel Classes="Setting">
                        <CheckBox IsChecked="{Binding ConfirmClose}">
                            <TextBlock Text="Ask/confirm before exiting" />
                        </CheckBox>
                    </StackPanel>

                    <StackPanel Classes="Setting">
                        <StackPanel Classes="SettingRow">
                            <TextBlock VerticalAlignment="Center" Text="Tray icon click" />
                            <ComboBox x:Name="TrayClickCombo" MinWidth="160" />
                        </StackPanel>
                        <TextBlock Classes="Caption"
                                   Text="What a single click on the tray icon does. The right-click menu always offers everything." />
                    </StackPanel>
                </StackPanel>
            </HeaderedContentControl>
            <HeaderedContentControl Header="Shell" Theme="{StaticResource GroupBox}">
                <StackPanel Classes="SettingsGroup">
                    <StackPanel Classes="Setting">
                        <CheckBox x:Name="ContextMenuCheck" IsChecked="{Binding RegisterExplorerContextMenu}">
                            <TextBlock Text="Add 'Upload with Clowd' to the Explorer context menu" TextWrapping="Wrap" />
                        </CheckBox>
                        <TextBlock x:Name="ContextMenuCaption" Classes="Caption" />
                        <Button x:Name="ContextMenuSettingsButton" IsVisible="False" Content="Open System Settings"
                                Click="OnContextMenuSettingsClick" />
                    </StackPanel>
                </StackPanel>
            </HeaderedContentControl>
        </StackPanel>
    </controls:FadeEdgeScrollViewer>
</UserControl>
