<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Clowd.UI.Controls"
    x:Class="Clowd.UI.Pages.AboutPage">

    <UserControl.Styles>
        <!-- Flat, full-width clickable row for a single open-source dependency. UserControl-level
             styles override the Semi Button ControlTheme, so the row reads as a list entry with a
             subtle hover fill rather than a filled button. -->
        <Style Selector="Button.CreditRow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.CreditRow /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.CreditRow:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiColorFill0}" />
        </Style>
        <Style Selector="Button.CreditRow:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiColorFill1}" />
        </Style>
    </UserControl.Styles>

    <controls:FadeEdgeScrollViewer>
        <StackPanel Margin="0,0,16,16" Spacing="8">
            <Viewbox Width="60" HorizontalAlignment="Left">
                <Path Width="16" Height="16" Data="{StaticResource PathLogoSmall16}" Fill="{StaticResource ClowdAccentBrush}" />
            </Viewbox>

            <TextBlock Classes="Title" Text="Clowd" />
            <TextBlock Classes="Base" Text="{Binding ClowdVersion}" />

            <TextBlock Classes="Body"
                       Text="Ever wanted a screen capturing tool that just had everything you needed and doesn't need to be tweaked endlessly? This is what Clowd strives to be." />
            <TextBlock Classes="Body"
                       Text="From quick but powerful pixel-perfect screen selection and extremely fast 1-button screen recording, to editing/composing images and uploading to share." />
            <TextBlock Classes="Body"
                       Text="My settings (this window) can be accessed from the tray icon. Explore to see what I can do!" />

            <HyperlinkButton Padding="0" Content="Read more online" NavigateUri="https://github.com/clowd/Clowd" />

            <TextBlock Classes="Body"
                       Text="Clowd is made possible in part by each of the following open source projects. Click any entry to open its project page." />

            <!-- One section per component (UI / capture engine); rows are generated from
                 Assets/credits.json — regenerate with tools/gen-credits.sh. -->
            <ItemsControl ItemsSource="{Binding Sections}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Classes="Base" Margin="0,0,0,2" Text="{Binding Title}" />
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Classes="CreditRow" Command="{Binding OpenCommand}">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Grid.Column="0"
                                                            Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Classes="Body" Text="{Binding Name}" />
                                                    <TextBlock Classes="Body"
                                                               Margin="8,0,0,0"
                                                               Opacity="0.4"
                                                               Text="{Binding Version}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1"
                                                           Classes="Body"
                                                           VerticalAlignment="Center"
                                                           Opacity="0.55"
                                                           Text="{Binding License}" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Classes="Body"
                       Margin="0,8,0,0"
                       Text="Missed your project in this list? Feel free to reach out through our GitHub." />
        </StackPanel>
    </controls:FadeEdgeScrollViewer>
</UserControl>
