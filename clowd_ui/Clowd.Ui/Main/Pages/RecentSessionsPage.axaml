<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Clowd.UI"
    xmlns:controls="using:Clowd.UI.Controls"
    xmlns:services="using:Clowd.UI.Services"
    xmlns:clowd="using:Clowd"
    x:Class="Clowd.UI.RecentSessionsPage">

    <UserControl.Resources>
        <local:UiDateTimeConverter x:Key="ConvUiDateTime" />

        <!-- one finished upload: link (click copies) + launch/delete, shared by the standalone list and
             session rows. The buttons sit right beside the link; the link is the row's flexible child,
             so when the row runs short the URL ellipsizes rather than the buttons being pushed out. -->
        <DataTemplate x:Key="UploadRecordTemplate" DataType="clowd:UploadRecord">
            <controls:ShrinkingRowPanel Spacing="6" VerticalAlignment="Center">
                <Path Height="10"
                      VerticalAlignment="Center"
                      Stretch="Uniform"
                      Fill="{DynamicResource SemiColorWarning}"
                      Data="{StaticResource IconLightning}"
                      IsVisible="{Binding Accelerated}"
                      ToolTip.Tip="Accelerated upload" />
                <HyperlinkButton controls:ShrinkingRowPanel.Shrink="True"
                                 Padding="0"
                                 MinHeight="0"
                                 VerticalAlignment="Center"
                                 Click="CopyUrlClicked"
                                 ToolTip.Tip="{Binding Url, StringFormat='Copy \'{0}\''}">
                    <TextBlock Text="{Binding Url}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                </HyperlinkButton>
                <StackPanel Classes="rowActions"
                            Orientation="Horizontal"
                            Spacing="2"
                            VerticalAlignment="Center">
                    <Button Classes="rowActionSmall"
                            Click="OpenUrlClicked"
                            ToolTip.Tip="Open in browser"
                            AutomationProperties.Name="Open in browser">
                        <Viewbox>
                            <Path Width="24" Height="24" Fill="{DynamicResource SemiColorText1}" Data="{StaticResource IconOpenInNew}" />
                        </Viewbox>
                    </Button>
                    <Button Classes="rowActionSmall"
                            Click="DeleteUploadClicked"
                            IsVisible="{Binding CanDelete}"
                            ToolTip.Tip="Delete upload"
                            AutomationProperties.Name="Delete upload">
                        <Viewbox>
                            <Path Width="24" Height="24" Fill="{DynamicResource SemiColorText1}" Data="{StaticResource IconDelete}" />
                        </Viewbox>
                    </Button>
                </StackPanel>
            </controls:ShrinkingRowPanel>
        </DataTemplate>

        <!-- one in-flight upload: progress + status + cancel -->
        <DataTemplate x:Key="ActiveUploadTemplate" DataType="local:ActiveUpload">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ProgressBar Width="140"
                             Minimum="0"
                             Maximum="100"
                             VerticalAlignment="Center"
                             Value="{Binding Progress, Mode=OneWay}" />
                <TextBlock VerticalAlignment="Center" Opacity="0.6" Text="{Binding Status}" />
                <Button Classes="rowActionSmall"
                        Click="CancelUploadClicked"
                        ToolTip.Tip="Cancel upload"
                        AutomationProperties.Name="Cancel upload">
                    <Viewbox>
                        <!-- 26px canvas; sized for the same reason as the play glyph above -->
                        <Path Width="26" Height="26" Fill="{DynamicResource SemiColorText1}" Data="{StaticResource IconClose}" />
                    </Viewbox>
                </Button>
            </StackPanel>
        </DataTemplate>

        <!-- one in-flight gif conversion: progress + status + cancel (mirrors ActiveUploadTemplate) -->
        <DataTemplate x:Key="GifConversionTemplate" DataType="services:GifConversion">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ProgressBar Width="140"
                             Minimum="0"
                             Maximum="100"
                             VerticalAlignment="Center"
                             Value="{Binding Progress, Mode=OneWay}" />
                <!-- fixed width: the status carries a percentage that changes width as it counts up,
                     which would otherwise walk the cancel button left and right underneath the cursor. -->
                <TextBlock Width="120"
                           VerticalAlignment="Center"
                           Opacity="0.6"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap"
                           Text="{Binding Status}" />
                <Button Classes="rowActionSmall"
                        Click="CancelGifClicked"
                        ToolTip.Tip="Cancel conversion"
                        AutomationProperties.Name="Cancel conversion">
                    <Viewbox>
                        <!-- 26px canvas; sized for the same reason as the play glyph above -->
                        <Path Width="26" Height="26" Fill="{DynamicResource SemiColorText1}" Data="{StaticResource IconClose}" />
                    </Viewbox>
                </Button>
            </StackPanel>
        </DataTemplate>

        <!-- one in-flight video render: progress + status + cancel (the same row as GifConversionTemplate) -->
        <DataTemplate x:Key="VideoRenderTemplate" DataType="services:VideoRender">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ProgressBar Width="140"
                             Minimum="0"
                             Maximum="100"
                             VerticalAlignment="Center"
                             Value="{Binding Progress, Mode=OneWay}" />
                <!-- fixed width, for the same reason as the gif row above -->
                <TextBlock Width="120"
                           VerticalAlignment="Center"
                           Opacity="0.6"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap"
                           Text="{Binding Status}" />
                <Button Classes="rowActionSmall"
                        Click="CancelRenderClicked"
                        ToolTip.Tip="Cancel render"
                        AutomationProperties.Name="Cancel render">
                    <Viewbox>
                        <!-- 26px canvas; sized for the same reason as the play glyph above -->
                        <Path Width="26" Height="26" Fill="{DynamicResource SemiColorText1}" Data="{StaticResource IconClose}" />
                    </Viewbox>
                </Button>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="ListBox.sessions">
            <Setter Property="Background" Value="Transparent" />
            <!-- the left gutter the link brackets are drawn in. It has to be the ListBox's own
                 padding rather than a margin on anything outside it: the ListBox clips at its
                 bounds, so a bracket drawn in space the ListBox does not own is cut off. The group
                 header carries the same indent so headers and cards stay flush with each other. -->
            <Setter Property="Padding" Value="12,0,0,0" />
        </Style>
        <Style Selector="ListBox.sessions ListBoxItem">
            <Setter Property="Padding" Value="4" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <!-- a ListBoxItem clips its content to its own bounds (TemplatedControl flips
                 Avalonia's usual ClipToBounds=false default). The link bracket is drawn in the
                 gutter to the left of this padding, and its chain-link glyph hangs above the row
                 onto the one before it, so that clip has to come off. Nothing else in the template
                 reaches outside the row: the pulse overlay's -4 margin only cancels this padding. -->
            <Setter Property="ClipToBounds" Value="False" />
        </Style>
        <!-- row actions appear on hover / selection; hidden but layout-stable otherwise. Applies to
             both the card's own action bar and the per-upload buttons on the link rows. -->
        <Style Selector="ListBox.sessions ListBoxItem StackPanel.rowActions">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="ListBox.sessions ListBoxItem:pointerover StackPanel.rowActions,
                         ListBox.sessions ListBoxItem:selected StackPanel.rowActions">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="IsHitTestVisible" Value="True" />
        </Style>
        <Style Selector="ListBox.sessions ListBoxItem controls|CollapsingButtonBar.rowActions">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="ListBox.sessions ListBoxItem:pointerover controls|CollapsingButtonBar.rowActions,
                         ListBox.sessions ListBoxItem:selected controls|CollapsingButtonBar.rowActions">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="IsHitTestVisible" Value="True" />
        </Style>
        <Style Selector="Button.rowAction">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.rowAction:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiColorFill1}" />
        </Style>
        <!-- compact inline action used by the upload rows -->
        <Style Selector="Button.rowActionSmall">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.rowActionSmall:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiColorFill1}" />
        </Style>
        <!-- the favourite toggle beside a row's name. It follows the row-action rule — invisible
             but layout-stable until the row is hovered or selected — with one addition: a row that
             is already starred shows its star whatever the pointer is doing, because the star is
             the only thing on the row that says so. -->
        <Style Selector="Button.starToggle">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="3" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Width" Value="21" />
            <Setter Property="Height" Value="21" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="ListBox.sessions ListBoxItem:pointerover Button.starToggle,
                         ListBox.sessions ListBoxItem:selected Button.starToggle">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="IsHitTestVisible" Value="True" />
        </Style>
        <Style Selector="Button.starToggle.on">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="IsHitTestVisible" Value="True" />
        </Style>
        <Style Selector="Button.starToggle:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiColorFill1}" />
        </Style>
        <!-- the glyph fills are set here rather than on the Path itself: a local value beats a
             style setter in Avalonia, so a Fill written on the element would make the hover rule
             below dead weight. -->
        <Style Selector="Path.starGlyph">
            <Setter Property="Fill" Value="{DynamicResource SemiColorText1}" />
        </Style>
        <Style Selector="Path.starGlyphOn">
            <Setter Property="Fill" Value="{DynamicResource ClowdStarBrush}" />
        </Style>
        <!-- hovering the star itself (not just the row) turns it gold, so it reads as the control
             it is rather than as a status mark that happens to sit there. -->
        <Style Selector="Button.starToggle:pointerover Path.starGlyph">
            <Setter Property="Fill" Value="{DynamicResource ClowdStarBrush}" />
        </Style>
        <Style Selector="Button.starToggle:pointerover Path.starGlyphOn">
            <Setter Property="Opacity" Value="0.65" />
        </Style>
    </UserControl.Styles>

    <controls:FadeEdgeScrollViewer x:Name="SessionScroller">
        <StackPanel Margin="0,0,16,16">

            <!-- zero state: shown until the first capture exists, and again whenever the header's
                 filter matches nothing. Its wording is set by UpdateEmptyState, which knows which of
                 the two it is. -->
            <StackPanel IsVisible="{Binding !Groups.Count}" Margin="0,24,0,0" Spacing="6">
                <TextBlock x:Name="EmptyTitle" Classes="Base" />
                <TextBlock x:Name="EmptyDetail" Opacity="0.7" TextWrapping="Wrap" />
            </StackPanel>

            <!-- VM-side grouping replaces the WPF CollectionViewSource (decision table #52). -->
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Margin="12,8,0,8" Classes="H6" Text="{Binding Name}" />
                            <ListBox Classes="sessions"
                                     SelectionMode="Single"
                                     KeyDown="SessionListKeyDown"
                                     SelectionChanged="SessionSelectionChanged"
                                     ItemsSource="{Binding Items}">
                                <!-- stated explicitly for CacheLength: it defaults to 0, so the
                                     realized set would be exactly the visible rows with no
                                     look-ahead at all and every preview would pop in as it
                                     scrolled into view. Half a viewport on each side gives the
                                     engine's buffer bands something to work on. (There is no
                                     CacheLengthUnit in Avalonia 12.1 — the unit is viewports.) -->
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel CacheLength="0.5" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Background="Transparent"
                                              DoubleTapped="ViewDoubleClick"
                                              ColumnDefinitions="Auto,12,*">
                                            <Grid.ContextMenu>
                                                <ContextMenu>
                                                    <!-- an entry a child process is still writing (a converting gif, a rendering
                                                         edit) has no usable file yet: everything but Delete (which cancels, see
                                                         DeleteWithConfirmation) is disabled until it lands — that is IsIdle. -->
                                                    <!-- same order as the row's action bar, so the ⋮ overflow menu (which is
                                                         generated from those buttons) and this one agree. -->
                                                    <MenuItem Header="Edit image" Click="OpenItemClicked" IsVisible="{Binding ShowOpen}"
                                                              IsEnabled="{Binding IsIdle}" />
                                                    <MenuItem Header="Copy" Click="CopyItemClicked" IsVisible="{Binding CanCopy}"
                                                              IsEnabled="{Binding IsIdle}" />
                                                    <MenuItem Header="Edit video" Click="EditVideoClicked" IsVisible="{Binding ShowEditVideo}"
                                                              IsEnabled="{Binding IsIdle}" />
                                                    <MenuItem Header="Render video" Click="RenderVideoClicked" IsVisible="{Binding ShowRender}"
                                                              IsEnabled="{Binding IsIdle}" />
                                                    <MenuItem Header="Play" Click="PlayItemClicked" IsVisible="{Binding CanPlay}"
                                                              IsEnabled="{Binding IsIdle}" />
                                                    <MenuItem Header="Create GIF" Click="CreateGifClicked" IsVisible="{Binding CanCreateGif}"
                                                              IsEnabled="{Binding IsIdle}" />
                                                    <MenuItem Header="Upload" Click="UploadItemClicked" IsVisible="{Binding CanUpload}" />
                                                    <MenuItem Header="Show in folder" Click="ShowInFolderClicked" IsVisible="{Binding CanShowInFolder}"
                                                              IsEnabled="{Binding IsIdle}" />
                                                    <!-- the same toggle as the row's star, in the words a menu wants:
                                                         what clicking it does, not what the entry currently is. -->
                                                    <MenuItem Header="{Binding StarMenuHeader}" Click="ToggleStarClicked" />
                                                    <MenuItem Header="Delete" Click="DeleteItemClicked" />
                                                </ContextMenu>
                                            </Grid.ContextMenu>
                                            <!-- what PulseSelection animates to point out a row the app selected on the
                                                 user's behalf. First child, so it washes over the selection color but
                                                 stays behind the row's own content; -4 cancels the ListBoxItem padding so
                                                 it covers the whole card. Carries no content, so it adds no height. -->
                                            <Border Name="PulseOverlay"
                                                    Grid.ColumnSpan="3"
                                                    Margin="-4"
                                                    CornerRadius="6"
                                                    Opacity="0"
                                                    IsHitTestVisible="False"
                                                    Background="{DynamicResource SemiColorWarning}" />
                                            <!--  The bracket joining an entry to the one it was made from: out of the
                                                  left edge of one preview, round into the gutter, down past a chain-link
                                                  glyph, and back into the left edge of the preview below. A render sits
                                                  above the project it came from, a GIF above the video it came from.

                                                  Each row draws only its own half — the lower half when this row was
                                                  made from the row below (LinkedToNext), the upper half when the row
                                                  above was made from this one (LinkedToPrevious) — and the two halves
                                                  meet in the channel between the cards. That is what keeps the arms on
                                                  the previews' centre line whatever either row's height turns out to
                                                  be: the two star rows below split THIS row at its own centre, which is
                                                  where its (vertically centred) preview's centre is, and neither half
                                                  has to know anything about the other row.

                                                  Geometry, in this container's own space: it is 10px wide and starts
                                                  6px left of the card's content, so its right edge lands exactly on the
                                                  preview's left edge (the preview's own 4px margin) and its left edge —
                                                  where the vertical run sits — is 2px outside the card, in the gutter
                                                  the ListBox's padding reserves. The corner pieces are 10x10 with a 6px
                                                  arc, and each straight run stops 7px short of the row boundary, which
                                                  is what leaves the glyph (20px tall, centred on the 10px channel) 2px
                                                  of air at each end. The runs are set back further than the glyph so the
                                                  bracket reads as guide work and the join reads as the mark.  -->
                                            <Grid Width="10"
                                                  Margin="-6,0,0,0"
                                                  HorizontalAlignment="Left"
                                                  RowDefinitions="*,*">
                                                <!--  upper half: down from the channel above, then round into this
                                                      row's preview  -->
                                                <Rectangle Grid.Row="0"
                                                           Width="1.5"
                                                           Margin="0,7,0,10"
                                                           HorizontalAlignment="Left"
                                                           Opacity="0.28"
                                                           Fill="{DynamicResource SemiColorText1}"
                                                           IsVisible="{Binding LinkedToPrevious}" />
                                                <Path Grid.Row="0"
                                                      Width="10"
                                                      Height="10"
                                                      VerticalAlignment="Bottom"
                                                      Stretch="None"
                                                      Stroke="{DynamicResource SemiColorText1}"
                                                      StrokeThickness="1.5"
                                                      Opacity="0.28"
                                                      IsVisible="{Binding LinkedToPrevious}"
                                                      Data="M0.75,0 V4 A6,6 0 0 0 6.75,10 H10" />
                                                <!--  lower half: out of this row's preview, then down to the channel
                                                      below  -->
                                                <Rectangle Grid.Row="1"
                                                           Width="1.5"
                                                           Margin="0,10,0,7"
                                                           HorizontalAlignment="Left"
                                                           Opacity="0.28"
                                                           Fill="{DynamicResource SemiColorText1}"
                                                           IsVisible="{Binding LinkedToNext}" />
                                                <Path Grid.Row="1"
                                                      Width="10"
                                                      Height="10"
                                                      VerticalAlignment="Top"
                                                      Stretch="None"
                                                      Stroke="{DynamicResource SemiColorText1}"
                                                      StrokeThickness="1.5"
                                                      Opacity="0.28"
                                                      IsVisible="{Binding LinkedToNext}"
                                                      Data="M10,0 H6.75 A6,6 0 0 0 0.75,6 V10" />
                                                <!--  the glyph on the join, drawn by the lower of the two rows. Its
                                                      20x10 box is rotated a quarter turn about its own centre, so it
                                                      reads as 10 wide by 20 tall on the vertical run; the rotation is
                                                      a render transform and costs no layout, and the negative margins
                                                      put that centre on the channel above this row.  -->
                                                <Viewbox Grid.Row="0"
                                                         Width="20"
                                                         Height="10"
                                                         Margin="-9.25,-10,0,0"
                                                         Opacity="0.45"
                                                         HorizontalAlignment="Left"
                                                         VerticalAlignment="Top"
                                                         IsVisible="{Binding LinkedToPrevious}">
                                                    <Viewbox.RenderTransform>
                                                        <RotateTransform Angle="90" />
                                                    </Viewbox.RenderTransform>
                                                    <Path Width="20"
                                                          Height="10"
                                                          Fill="{DynamicResource SemiColorText1}"
                                                          Data="{StaticResource IconLinkTight}"
                                                          ToolTip.Tip="The item above was made from this one" />
                                                </Viewbox>
                                            </Grid>
                                            <!-- one control, not a converter stack: the preview a row
                                                 deserves depends on what is actually on disk beside
                                                 its session file, which is a worker's question, and
                                                 the tile is keyed on the session directory so it
                                                 survives this list's frequent container rebuilds. -->
                                            <Border Width="110"
                                                    Height="75"
                                                    Margin="4"
                                                    VerticalAlignment="Center">
                                                <controls:SessionPreviewTile Session="{Binding}" />
                                            </Border>
                                            <!-- two stacked rows: the header line (name / date, with the card's
                                                 actions docked right) and the uploads block underneath it. Keeping
                                                 the uploads on their own line is what stops a long link — or its
                                                 buttons — from ever running into the action bar. -->
                                            <StackPanel Grid.Column="2"
                                                        VerticalAlignment="Center"
                                                        Spacing="2">
                                                <!-- a DockPanel, not a Grid: a Grid measures an Auto column with an
                                                     infinite width, so the action bar would never find out that the row
                                                     is too narrow for all of its buttons. Docked first so it is measured
                                                     against the full row width, of which it leaves ReservedWidth to the
                                                     name beside it. -->
                                                <DockPanel LastChildFill="True">
                                                    <!-- while a gif or an edited video is being written the row owns no
                                                         finished file — its only action is the cancel button in the progress
                                                         row below. -->
                                                    <controls:CollapsingButtonBar DockPanel.Dock="Right"
                                                                                  Classes="rowActions"
                                                                                  ButtonClasses="rowAction"
                                                                                  ReservedWidth="140"
                                                                                  IsVisible="{Binding IsIdle}"
                                                                                  Margin="8,0,4,0"
                                                                                  Spacing="2"
                                                                                  VerticalAlignment="Center">
                                                        <!-- Edit leads because it is what double-click does. "Show in folder" and
                                                             Delete trail the bar in that order: they are the two actions every kind
                                                             of entry offers, so they hold the same two slots on every row. -->
                                                        <!-- a recording or gif has a poster frame, but putting that still on the
                                                             clipboard is never what "copy" meant for a video — so it has no Copy. -->
                                                        <Button Classes="rowAction"
                                                                Click="OpenItemClicked"
                                                                IsVisible="{Binding ShowOpen}"
                                                                ToolTip.Tip="Edit image"
                                                                AutomationProperties.Name="Edit image">
                                                            <Viewbox>
                                                                <Path Width="24" Height="24" Fill="{DynamicResource SemiColorText1}" Data="{StaticResource IconEditScreenshot}" />
                                                            </Viewbox>
                                                        </Button>
                                                        <Button Classes="rowAction"
                                                                Click="CopyItemClicked"
                                                                IsVisible="{Binding CanCopy}"
                                                                ToolTip.Tip="Copy image to clipboard"
                                                                AutomationProperties.Name="Copy image to clipboard">
                                                            <Viewbox>
                                                                <Path Width="172" Height="172" Fill="{DynamicResource SemiColorText1}" Data="{StaticResource IconCopySmall}" />
                                                            </Viewbox>
                                                        </Button>
                                                        <!-- leads the project actions because it is also what double-click
                                                             and Enter do: editing is the default thing to do with a
                                                             project, rendering it is the deliberate one. -->
                                                        <Button Classes="rowAction"
                                                                Click="EditVideoClicked"
                                                                IsVisible="{Binding ShowEditVideo}"
                                                                ToolTip.Tip="Edit video"
                                                                AutomationProperties.Name="Edit video">
                                                            <Viewbox>
                                                                <Path Width="24" Height="24" Fill="{DynamicResource SemiColorText1}" Data="{StaticResource IconEditRecording}" />
                                                            </Viewbox>
                                                        </Button>
                                                        <!-- the same action (and the same glyph) as the video editor's own
                                                             Render button, for a project the user does not need to open. -->
                                                        <Button Classes="rowAction"
                                                                Click="RenderVideoClicked"
                                                                IsVisible="{Binding ShowRender}"
                                                                ToolTip.Tip="Render into a video"
                                                                AutomationProperties.Name="Render into a video">
                                                            <Viewbox>
                                                                <!-- IconProcess is drawn on a 24px canvas (AppStyles icon table) -->
                                                                <Path Width="24" Height="24" Fill="{DynamicResource SemiColorText1}" Data="{StaticResource IconProcess}" />
                                                            </Viewbox>
                                                        </Button>
                                                        <Button Classes="rowAction"
                                                                Click="PlayItemClicked"
                                                                IsVisible="{Binding CanPlay}"
                                                                ToolTip.Tip="Play video"
                                                                AutomationProperties.Name="Play video">
                                                            <Viewbox>
                                                                <!-- IconPlay is drawn on a 172px canvas (AppStyles icon table), not the 24px
                                                                     material canvas the other row icons use. Without the explicit canvas size the
                                                                     Path measures to the glyph's right/bottom edge, so its leading padding is kept
                                                                     and its trailing padding is not — the Viewbox then scales a box the triangle
                                                                     sits off-center in. -->
                                                                <Path Width="172" Height="172" Fill="{DynamicResource SemiColorText1}" Data="{StaticResource IconPlay}" />
                                                            </Viewbox>
                                                        </Button>
                                                        <Button Classes="rowAction"
                                                                Click="CreateGifClicked"
                                                                IsVisible="{Binding CanCreateGif}"
                                                                ToolTip.Tip="Create GIF"
                                                                AutomationProperties.Name="Create GIF">
                                                            <Viewbox>
                                                                <!-- IconVideoGIF is a 36x24 wordmark canvas (AppStyles icon table) rather
                                                                     than the 24px material canvas, so it needs its size stated for the same
                                                                     reason as the play glyph above. -->
                                                                <Path Width="36" Height="24" Fill="{DynamicResource SemiColorText1}" Data="{StaticResource IconVideoGIF}" />
                                                            </Viewbox>
                                                        </Button>
                                                        <Button Classes="rowAction"
                                                                Click="UploadItemClicked"
                                                                IsVisible="{Binding CanUpload}"
                                                                ToolTip.Tip="Upload"
                                                                AutomationProperties.Name="Upload">
                                                            <Viewbox>
                                                                <!-- the paper plane, the same "upload" affordance the editor's toolbar
                                                                     uses; a 24px canvas (AppStyles icon table). -->
                                                                <Path Width="24" Height="24" Fill="{DynamicResource SemiColorText1}" Data="{StaticResource IconUpload}" />
                                                            </Viewbox>
                                                        </Button>
                                                        <Button Classes="rowAction"
                                                                Click="ShowInFolderClicked"
                                                                IsVisible="{Binding CanShowInFolder}"
                                                                ToolTip.Tip="Show in folder"
                                                                AutomationProperties.Name="Show in folder">
                                                            <Viewbox>
                                                                <Path Width="24" Height="24" Fill="{DynamicResource SemiColorText1}" Data="{StaticResource IconFolderOpen}" />
                                                            </Viewbox>
                                                        </Button>
                                                        <Button Classes="rowAction"
                                                                Click="DeleteItemClicked"
                                                                ToolTip.Tip="Delete"
                                                                AutomationProperties.Name="Delete">
                                                            <Viewbox>
                                                                <Path Width="24" Height="24" Fill="{DynamicResource SemiColorText1}" Data="{StaticResource IconDelete}" />
                                                            </Viewbox>
                                                        </Button>
                                                    </controls:CollapsingButtonBar>

                                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                                        <!-- the marker sits immediately after the name rather than at the far
                                                             right of the row, so the name has to give up the width for it —
                                                             which is what ShrinkingRowPanel is for (a StackPanel would measure
                                                             the name against infinity and never trim it). -->
                                                        <controls:ShrinkingRowPanel Spacing="6">
                                                            <TextBlock Classes="Base"
                                                                       controls:ShrinkingRowPanel.Shrink="True"
                                                                       VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       TextWrapping="NoWrap"
                                                                       ToolTip.Tip="{Binding Name}"
                                                                       Text="{Binding Name}" />
                                                            <Viewbox Width="15"
                                                                     Height="15"
                                                                     VerticalAlignment="Center"
                                                                     IsVisible="{Binding IsProject}"
                                                                     ToolTip.Tip="{Binding ProjectTooltip}">
                                                                <Path Width="24" Height="24" Fill="{StaticResource ClowdAccentBrush}" Data="{StaticResource IconVideoProject}" />
                                                            </Viewbox>
                                                            <!-- last on the line, so it sits to the right of the project marker on
                                                                 the rows that carry one and immediately after the name on the rows
                                                                 that do not. Not in the action bar: that bar collapses into a ⋮ menu
                                                                 on a narrow row, and a mark showing state has to stay visible. The
                                                                 "on" class is what keeps a starred row's star showing when the
                                                                 pointer is elsewhere (see the styles above). -->
                                                            <Button Classes="starToggle"
                                                                    Classes.on="{Binding Starred}"
                                                                    Click="ToggleStarClicked"
                                                                    ToolTip.Tip="{Binding StarTooltip}"
                                                                    AutomationProperties.Name="Star">
                                                                <Viewbox>
                                                                    <!-- the two states are separate glyphs rather than one path
                                                                         changing fill: the filled star is a solid silhouette and the
                                                                         outline is an even-odd ring, so neither can stand in for the
                                                                         other. Only ever one of them is visible. -->
                                                                    <Panel>
                                                                        <Path Classes="starGlyph"
                                                                              Width="24"
                                                                              Height="24"
                                                                              IsVisible="{Binding !Starred}"
                                                                              Data="{StaticResource IconStarOutline}" />
                                                                        <Path Classes="starGlyphOn"
                                                                              Width="24"
                                                                              Height="24"
                                                                              IsVisible="{Binding Starred}"
                                                                              Data="{StaticResource IconStarFilled}" />
                                                                    </Panel>
                                                                </Viewbox>
                                                            </Button>
                                                        </controls:ShrinkingRowPanel>
                                                        <!-- date, then the upload's size on the same line. The size is its
                                                             own TextBlock rather than part of the date string so the
                                                             separator can hide with it: a capture has no size to report,
                                                             and neither does an upload made before it was recorded. -->
                                                        <StackPanel Orientation="Horizontal" Spacing="0">
                                                            <TextBlock Classes="Body"
                                                                       Text="{Binding CreatedUtc, Converter={StaticResource ConvUiDateTime}}" />
                                                            <TextBlock Classes="Body"
                                                                       Text=" · "
                                                                       IsVisible="{Binding ShowUploadSize}" />
                                                            <TextBlock Classes="Body"
                                                                       Text="{Binding UploadSizeText}"
                                                                       IsVisible="{Binding ShowUploadSize}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </DockPanel>

                                                <!-- separates the card's own line from everything to do with its uploads -->
                                                <Border Height="1"
                                                        Margin="0,3,4,1"
                                                        Background="{DynamicResource SemiColorBorder}" />

                                                <TextBlock Opacity="0.6"
                                                           Text="Not uploaded"
                                                           IsVisible="{Binding ShowNotUploaded}" />
                                                <!-- a project is never uploaded; what it is waiting for is a render -->
                                                <TextBlock Opacity="0.6"
                                                           Text="{Binding RenderStatusText}"
                                                           IsVisible="{Binding ShowRenderStatus}" />
                                                <ItemsControl ItemsSource="{Binding AllUploads}"
                                                              ItemTemplate="{StaticResource UploadRecordTemplate}" />
                                                <ContentControl Content="{Binding ActiveUpload}"
                                                                ContentTemplate="{StaticResource ActiveUploadTemplate}"
                                                                IsVisible="{Binding ActiveUpload, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                <ContentControl Content="{Binding ActiveGifConversion}"
                                                                ContentTemplate="{StaticResource GifConversionTemplate}"
                                                                IsVisible="{Binding ActiveGifConversion, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                <ContentControl Content="{Binding ActiveRender}"
                                                                ContentTemplate="{StaticResource VideoRenderTemplate}"
                                                                IsVisible="{Binding ActiveRender, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </controls:FadeEdgeScrollViewer>
</UserControl>
