<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Clowd.UI"
    xmlns:clowd="using:Clowd"
    x:Class="Clowd.UI.RecentSessionsPage">

    <UserControl.Resources>
        <local:ImagePathToBitmapConverter x:Key="ConvCacheImage" />
        <local:UiDateTimeConverter x:Key="ConvUiDateTime" />

        <!-- one finished upload: link + date + copy/delete, shared by the standalone list and session rows -->
        <DataTemplate x:Key="UploadRecordTemplate" DataType="clowd:UploadRecord">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <HyperlinkButton Padding="0"
                                 MaxWidth="360"
                                 VerticalAlignment="Center"
                                 NavigateUri="{Binding Url}"
                                 ToolTip.Tip="{Binding Url}">
                    <TextBlock Text="{Binding Url}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                </HyperlinkButton>
                <TextBlock VerticalAlignment="Center"
                           Opacity="0.6"
                           Text="{Binding UploadedUtc, Converter={StaticResource ConvUiDateTime}}" />
                <Button Classes="rowActionSmall"
                        Click="CopyUrlClicked"
                        ToolTip.Tip="Copy link"
                        AutomationProperties.Name="Copy link">
                    <Viewbox>
                        <Path Width="172" Height="172" Fill="{DynamicResource SemiColorText1}" Data="{StaticResource IconCopySmall}" />
                    </Viewbox>
                </Button>
                <Button Classes="rowActionSmall"
                        Click="DeleteUploadClicked"
                        IsVisible="{Binding CanDelete}"
                        ToolTip.Tip="Delete upload"
                        AutomationProperties.Name="Delete upload">
                    <Viewbox>
                        <Path Width="24" Height="24" Fill="{DynamicResource SemiColorText1}" Data="{StaticResource IconDelete}" />
                    </Viewbox>
                </Button>
            </StackPanel>
        </DataTemplate>

        <!-- one in-flight upload: progress + status + cancel -->
        <DataTemplate x:Key="ActiveUploadTemplate" DataType="local:ActiveUpload">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ProgressBar Width="140"
                             Minimum="0"
                             Maximum="100"
                             VerticalAlignment="Center"
                             Value="{Binding Progress, Mode=OneWay}" />
                <TextBlock VerticalAlignment="Center" Opacity="0.6" Text="{Binding Status}" />
                <Button Classes="rowActionSmall"
                        Click="CancelUploadClicked"
                        ToolTip.Tip="Cancel upload"
                        AutomationProperties.Name="Cancel upload">
                    <Viewbox>
                        <Path Fill="{DynamicResource SemiColorText1}" Data="{StaticResource IconClose}" />
                    </Viewbox>
                </Button>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="ListBox.sessions">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ListBox.sessions ListBoxItem">
            <Setter Property="Padding" Value="4" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <!-- row actions appear on hover / selection; hidden but layout-stable otherwise -->
        <Style Selector="ListBox.sessions ListBoxItem StackPanel.rowActions">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="ListBox.sessions ListBoxItem:pointerover StackPanel.rowActions,
                         ListBox.sessions ListBoxItem:selected StackPanel.rowActions">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="IsHitTestVisible" Value="True" />
        </Style>
        <Style Selector="Button.rowAction">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
        </Style>
        <Style Selector="Button.rowAction:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiColorFill1}" />
        </Style>
        <!-- compact inline action used by the upload rows -->
        <Style Selector="Button.rowActionSmall">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="3" />
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
        </Style>
        <Style Selector="Button.rowActionSmall:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiColorFill1}" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel Margin="0,0,16,16">

            <!-- zero state: shown until the first capture exists -->
            <StackPanel IsVisible="{Binding !Groups.Count}" Margin="0,24,0,0" Spacing="6">
                <TextBlock Classes="Base" Text="No captures yet" />
                <TextBlock Opacity="0.7" TextWrapping="Wrap" Text="{Binding EmptyHint}" />
            </StackPanel>

            <!-- uploads: in-flight standalone uploads and finished (non-session) upload results -->
            <StackPanel>
                <TextBlock Margin="0,8" Classes="H6" Text="Uploads">
                    <TextBlock.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.Or}">
                            <Binding Path="!!Uploads.Standalone.Count" />
                            <Binding Path="!!Uploads.Completed.Count" />
                        </MultiBinding>
                    </TextBlock.IsVisible>
                </TextBlock>

                <ItemsControl ItemsSource="{Binding Uploads.Standalone}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="local:ActiveUpload">
                            <StackPanel Margin="0,2">
                                <TextBlock Classes="Base" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ActiveUploadTemplate}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl ItemsSource="{Binding Uploads.Completed}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="clowd:UploadRecord">
                            <StackPanel Margin="0,2">
                                <TextBlock Classes="Base"
                                           TextTrimming="CharacterEllipsis"
                                           Text="{Binding FileName}"
                                           IsVisible="{Binding FileName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource UploadRecordTemplate}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- VM-side grouping replaces the WPF CollectionViewSource (decision table #52). -->
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Margin="0,8" Classes="H6" Text="{Binding Name}" />
                            <ListBox Classes="sessions"
                                     SelectionMode="Single"
                                     KeyDown="SessionListKeyDown"
                                     ItemsSource="{Binding Items}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Background="Transparent"
                                              DoubleTapped="ViewDoubleClick"
                                              RowDefinitions="25,25,Auto"
                                              ColumnDefinitions="Auto,12,*,Auto">
                                            <Grid.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Open" Click="OpenItemClicked" />
                                                    <MenuItem Header="Copy" Click="CopyItemClicked" />
                                                    <MenuItem Header="Delete" Click="DeleteItemClicked" />
                                                </ContextMenu>
                                            </Grid.ContextMenu>
                                            <Border Grid.RowSpan="3"
                                                    Width="110"
                                                    Height="75"
                                                    Margin="4"
                                                    Background="{x:Static clowd:AppStyles.CheckerboardBrushSmall}">
                                                <Image Source="{Binding PreviewImgPath, Converter={StaticResource ConvCacheImage}}"
                                                       Stretch="Uniform" />
                                            </Border>
                                            <TextBlock Grid.Row="0"
                                                       Grid.Column="2"
                                                       VerticalAlignment="Center"
                                                       Classes="Base"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap"
                                                       ToolTip.Tip="{Binding Name}"
                                                       Text="{Binding Name}" />
                                            <TextBlock Grid.Row="1"
                                                       Grid.Column="2"
                                                       VerticalAlignment="Center"
                                                       Classes="Body"
                                                       Text="{Binding CreatedUtc, Converter={StaticResource ConvUiDateTime}}" />
                                            <StackPanel Grid.Row="2"
                                                        Grid.Column="2"
                                                        VerticalAlignment="Center">
                                                <TextBlock Opacity="0.6"
                                                           Text="Not uploaded"
                                                           IsVisible="{Binding ShowNotUploaded}" />
                                                <ItemsControl ItemsSource="{Binding AllUploads}"
                                                              ItemTemplate="{StaticResource UploadRecordTemplate}" />
                                                <ContentControl Content="{Binding ActiveUpload}"
                                                                ContentTemplate="{StaticResource ActiveUploadTemplate}"
                                                                IsVisible="{Binding ActiveUpload, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="3"
                                                        Grid.RowSpan="3"
                                                        Classes="rowActions"
                                                        Margin="8,0,4,0"
                                                        Orientation="Horizontal"
                                                        Spacing="2"
                                                        VerticalAlignment="Center">
                                                <Button Classes="rowAction"
                                                        Click="OpenItemClicked"
                                                        ToolTip.Tip="Open in editor"
                                                        AutomationProperties.Name="Open in editor">
                                                    <Viewbox>
                                                        <Path Width="24" Height="24" Fill="{DynamicResource SemiColorText1}" Data="{StaticResource IconOpenInNew}" />
                                                    </Viewbox>
                                                </Button>
                                                <Button Classes="rowAction"
                                                        Click="CopyItemClicked"
                                                        ToolTip.Tip="Copy image to clipboard"
                                                        AutomationProperties.Name="Copy image to clipboard">
                                                    <Viewbox>
                                                        <Path Width="172" Height="172" Fill="{DynamicResource SemiColorText1}" Data="{StaticResource IconCopySmall}" />
                                                    </Viewbox>
                                                </Button>
                                                <Button Classes="rowAction"
                                                        Click="DeleteItemClicked"
                                                        ToolTip.Tip="Delete capture"
                                                        AutomationProperties.Name="Delete capture">
                                                    <Viewbox>
                                                        <Path Width="24" Height="24" Fill="{DynamicResource SemiColorText1}" Data="{StaticResource IconDelete}" />
                                                    </Viewbox>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
