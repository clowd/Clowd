<ui:SystemThemedWindow
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:u="https://irihi.tech/ursa"
    xmlns:ui="using:Clowd.UI"
    x:Class="Clowd.UI.MainWindow"
    Title="Clowd"
    Width="800"
    Height="600"
    MinWidth="560"
    MinHeight="360"
    WindowStartupLocation="CenterScreen">

    <!-- Replaces the WPFUI NavigationFluent / Breadcrumb / Frame shell (decision table #53):
         Ursa NavMenu navigation on the left + a cached ContentControl hosting the pages.
         Spacing: 16px window padding on the left/top edges; right/bottom are left to the
         content column so page ScrollViewers can run their scrollbars to the window edge
         (pages keep a 0,0,16,16 content margin for clearance). -->
    <Grid Margin="16,16,0,0" RowDefinitions="Auto,*" ColumnDefinitions="Auto,*">

        <Grid Grid.Row="0" Grid.Column="0" Margin="6,0,0,24" ColumnDefinitions="Auto,*">
            <Viewbox Width="40" Height="40" HorizontalAlignment="Left">
                <Path Width="16" Height="16" Data="{StaticResource PathLogoSmall16}" Fill="{StaticResource ClowdAccentBrush}" />
            </Viewbox>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock FontWeight="Medium" Text="CLOWD" />
                <TextBlock Opacity="0.6" Text="Screen Capture Tool" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Grid.Column="0" RowDefinitions="Auto,*">

            <StackPanel Grid.Row="0" Margin="0,0,0,12" Spacing="8">
                <Button x:Name="NewEditorButton"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Click="NewEditor_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Width="16" Height="16" Data="{StaticResource IconNavEditor}" />
                        <TextBlock Text="New Editor" />
                    </StackPanel>
                </Button>

                <Button x:Name="NewCaptureButton"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Click="NewCapture_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Width="16" Height="16" Data="{StaticResource IconNavCapture}" />
                        <TextBlock Text="Screen Capture" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <u:NavMenu x:Name="NavList"
                       Grid.Row="1"
                       Margin="0,0,0,16"
                       MinWidth="150">
                <u:NavMenuItem Header="Recent" Tag="RecentSessions">
                    <u:NavMenuItem.Icon>
                        <PathIcon Width="16" Height="16" Data="{StaticResource IconNavRecent}" />
                    </u:NavMenuItem.Icon>
                </u:NavMenuItem>
                <u:NavMenuItem IsSeparator="True" />
                <u:NavMenuItem Header="General" Tag="SettingsGeneral">
                    <u:NavMenuItem.Icon>
                        <PathIcon Width="16" Height="16" Data="{StaticResource IconNavGeneral}" />
                    </u:NavMenuItem.Icon>
                </u:NavMenuItem>
                <u:NavMenuItem Header="Hotkeys" Tag="SettingsHotkeys">
                    <u:NavMenuItem.Icon>
                        <PathIcon Width="16" Height="16" Data="{StaticResource IconNavHotkeys}" />
                    </u:NavMenuItem.Icon>
                </u:NavMenuItem>
                <u:NavMenuItem Header="Capture" Tag="SettingsCapture">
                    <u:NavMenuItem.Icon>
                        <PathIcon Width="16" Height="16" Data="{StaticResource IconNavCapture}" />
                    </u:NavMenuItem.Icon>
                </u:NavMenuItem>
                <u:NavMenuItem Header="Recording" Tag="SettingsRecording">
                    <u:NavMenuItem.Icon>
                        <PathIcon Width="16" Height="16" Data="{StaticResource IconVideo}" />
                    </u:NavMenuItem.Icon>
                </u:NavMenuItem>
                <u:NavMenuItem Header="Editor" Tag="SettingsEditor">
                    <u:NavMenuItem.Icon>
                        <PathIcon Width="16" Height="16" Data="{StaticResource IconNavEditor}" />
                    </u:NavMenuItem.Icon>
                </u:NavMenuItem>
                <u:NavMenuItem Header="Uploads" Tag="SettingsUploads">
                    <u:NavMenuItem.Icon>
                        <PathIcon Width="16" Height="16" Data="{StaticResource IconNavUploads}" />
                    </u:NavMenuItem.Icon>
                </u:NavMenuItem>
                <u:NavMenuItem IsSeparator="True" />
                <u:NavMenuItem Header="About" Tag="About">
                    <u:NavMenuItem.Icon>
                        <PathIcon Width="16" Height="16" Data="{StaticResource IconNavAbout}" />
                    </u:NavMenuItem.Icon>
                </u:NavMenuItem>
            </u:NavMenu>

        </Grid>

        <Grid Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Margin="24,0,0,0" RowDefinitions="Auto,*">
            <!-- The page header lives outside PageHost, so both the title and introduction stay
                 visible while the settings page scrolls underneath them. -->
            <!-- The title keeps only the width it needs (Auto) and the slot beside it takes the
                 rest, so it is the page's header control — not the title — that has to give way
                 when the window is narrow. -->
            <Grid Margin="0,8,16,16" RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*">
                <TextBlock x:Name="PageTitle" Classes="Subtitle" VerticalAlignment="Center" />
                <ContentControl x:Name="PageHeaderContent"
                                Grid.Column="1"
                                Margin="16,0,0,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center" />
                <TextBlock x:Name="PageIntro"
                           Grid.Row="1"
                           Grid.ColumnSpan="2"
                           Margin="0,8,0,0"
                           Classes="Body"
                           Opacity="0.7"
                           TextWrapping="Wrap" />
            </Grid>
            <TransitioningContentControl x:Name="PageHost" Grid.Row="1">
                <TransitioningContentControl.PageTransition>
                    <CrossFade Duration="0:0:0.12" />
                </TransitioningContentControl.PageTransition>
            </TransitioningContentControl>
        </Grid>
    </Grid>
</ui:SystemThemedWindow>
