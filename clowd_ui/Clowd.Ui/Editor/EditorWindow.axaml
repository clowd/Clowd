<local:SystemThemedWindow
    x:Class="Clowd.UI.EditorWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:colors="clr-namespace:Clowd.UI.Dialogs.ColorPicker"
    xmlns:controls="clr-namespace:Clowd.UI.Controls"
    xmlns:conv="clr-namespace:Clowd.UI.Converters"
    xmlns:draw="clr-namespace:Clowd.Drawing;assembly=Clowd.Drawing"
    xmlns:local="clr-namespace:Clowd.UI"
    xmlns:util="clr-namespace:Clowd.Util"
    DragDrop.AllowDrop="True"
    Title="Edit - Clowd"
    Width="1050"
    Height="750"
    FontSize="13"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterScreen">
    <!--  Entries go in directly, with no <ResourceDictionary> wrapper: the wrapper assigns a
          fresh dictionary over Resources and so drops what the base window put there in its
          constructor (the MacTitleBarGutter* keys the toolbar's traffic-light spacer binds to).  -->
    <Window.Resources>
        <!--  The chrome brushes this window used to declare (the icon ink, the side panel's
              slab, the canvas surround and its edge line) are all app-wide in AppResources
              now, since the video editor wears every one of them too.  -->

        <draw:ToolTypeConverter x:Key="convToolType" />
        <conv:ColorToBrushConverter x:Key="convColorToBrush" />
        <conv:EnumMatchToBooleanConverter x:Key="enumMatch" />
        <conv:StringToFontFamilyConverter x:Key="convFontFamily" />
    </Window.Resources>

    <!--  Classes selects the editor chrome, and ApplyChrome sets it from General.EditorLayout
          (live — an editor already open follows the setting). "compact" is the legacy
          flat/square look (30px buttons, hairline rules, opaque #535353 chrome); "modern"
          floats the bars on the window's own background (Mica on Win11) with 40px rounded
          buttons in 50px strips and a rounded, shadowed canvas. Only the styles below differ —
          the tree is the same either way, which is what makes the switch a class swap.  -->
    <Grid x:Name="rootGrid">
        <Grid.Styles>
            <!--  ===== Modern chrome =====  -->

            <!--  Icon ink is its own brush, a touch lighter than body text (see the window's
                  ThemeDictionaries). The checked button keeps white, since its fill is then the
                  accent.  -->
            <Style Selector="Grid.modern controls|ToolButton">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="10" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Foreground" Value="{DynamicResource ClowdEditorIconBrush}" />
            </Style>
            <Style Selector="Grid.modern controls|ToolButton:checked">
                <Setter Property="Foreground" Value="White" />
            </Style>
            <!--  The theme's own hover fill, not the template's white veil: a white veil over
                  #FAFAFA is no hover at all.  -->
            <Style Selector="Grid.modern controls|ToolButton /template/ Border#_hover">
                <Setter Property="Background" Value="{DynamicResource SemiColorFill1}" />
            </Style>
            <Style Selector="Grid.modern controls|ToolButton.wide">
                <Setter Property="Padding" Value="9" />
            </Style>
            <Style Selector="Grid.modern controls|ToolButton.tight">
                <Setter Property="Padding" Value="11" />
            </Style>

            <!--  The active tool wears the accent rather than the dense look's white veil: on a
                  backdrop a lighter grey is not a strong enough mark, and the accent is already
                  what this app means by "selected" everywhere else.  -->
            <Style Selector="Grid.modern controls|ToolButton:checked /template/ Border#_bg">
                <Setter Property="Background" Value="{DynamicResource SemiColorPrimary}" />
            </Style>

            <!--  45px strips: a 36px item lane, a 4px gutter, and 5px on the edge that faces
                  the canvas — 4 of gutter plus 1 for the canvas shadow, which falls across the
                  rest of it. The buttons carry 2px of their own on the flow axis, which is the gap
                  between one item and the next; the lane stays 36 so the strip width does not move.  -->
            <Style Selector="Grid.modern controls|DockAndWrapPanel#ToolBar">
                <Setter Property="ItemWidth" Value="36" />
                <Setter Property="Margin" Value="4,0,5,4" />
            </Style>
            <Style Selector="Grid.modern controls|DockAndWrapPanel#ToolBar > controls|ToolButton">
                <Setter Property="Margin" Value="0,1" />
            </Style>
            <Style Selector="Grid.modern controls|DockAndWrapPanel#PropertiesBar">
                <Setter Property="ItemHeight" Value="36" />
                <Setter Property="Margin" Value="4,4,4,5" />
            </Style>
            <Style Selector="Grid.modern controls|DockAndWrapPanel#PropertiesBar > controls|ToolButton">
                <Setter Property="Margin" Value="1,0" />
            </Style>
            <Style Selector="Grid.modern controls|DockAndWrapPanel#PropertiesBar &gt; StackPanel">
                <Setter Property="Height" Value="36" />
                <Setter Property="Margin" Value="6,0,6,0" />
            </Style>

            <!--  Ursa's numeric field for the modern chrome. Sized for three digits and a unit,
                  which is every value in this bar (-180 ° is the longest), plus the spinner
                  column the compact box does not have.  -->
            <Style Selector="Grid.modern controls|ThemedSpinner">
                <Setter Property="IsModern" Value="True" />
                <Setter Property="Width" Value="94" />
            </Style>
            <Style Selector="Grid.modern controls|ThemedSpinner.wideField">
                <Setter Property="Width" Value="102" />
            </Style>

            <!--  Semi's ComboBox carries its own chevron and padding, so it needs more room than
                  the compact picker for the same words.  -->
            <Style Selector="Grid.modern controls|ThemedDropDown">
                <Setter Property="IsModern" Value="True" />
                <Setter Property="MinWidth" Value="96" />
            </Style>

            <!--  The font button. No Theme setter at all here — leaving it unset IS the modern
                  look, since that is Semi's own button; the Compact rule below is the one that
                  substitutes the bar's flat chrome.  -->
            <Style Selector="Grid.modern Button.fieldButton">
                <Setter Property="MinWidth" Value="96" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="Margin" Value="4,0,0,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
            </Style>

            <!--  The check box grows with the rest of the bar and takes the same radius family as
                  the buttons. Both values are in the box's own units — the template scales it into
                  a Viewbox, so the radius shrinks along with it.  -->
            <Style Selector="Grid.modern controls|CaptionedCheckBox">
                <Setter Property="CornerRadius" Value="4" />
                <!--  the bar is the window's own background here, so the box follows the app's
                      variant instead of the Compact chrome's fixed dark  -->
                <Setter Property="BoxVariant" Value="{x:Null}" />
            </Style>
            <Style Selector="Grid.modern controls|CaptionedCheckBox /template/ Viewbox#PART_Box">
                <Setter Property="Width" Value="14" />
                <Setter Property="Height" Value="14" />
            </Style>
            <Style Selector="Grid.modern controls|CaptionedCheckBox /template/ TextBlock#PART_Caption">
                <Setter Property="FontSize" Value="11" />
            </Style>

            <!--  Semi's text box is padded for a form field, not for a 3-digit number sharing its
                  box with a unit: at that width the padding is what clips the last digit while
                  blank space sits beside it. The digits get the space instead, and the unit's own
                  inset is set on the TextBlock ThemedSpinner puts there.  -->
            <Style Selector="Grid.modern controls|ScrollableUrsaSpinner /template/ TextBox#PART_TextBox">
                <Setter Property="Padding" Value="4,0,0,0" />
                <Setter Property="MinWidth" Value="0" />
            </Style>

            <Style Selector="Grid.modern Border.swatchOuter">
                <Setter Property="Width" Value="28" />
                <Setter Property="Height" Value="28" />
                <Setter Property="CornerRadius" Value="4" />
            </Style>
            <Style Selector="Grid.modern Border.colorSwatch">
                <Setter Property="CornerRadius" Value="3.5" />
            </Style>
            <Style Selector="Grid.modern Border.colorFill">
                <Setter Property="CornerRadius" Value="3" />
            </Style>

            <!--  The hairline rules divided one flat surface from another; on the backdrop there
                  are no surfaces left to divide, and the gap does the work instead.  -->
            <Style Selector="Grid.modern Rectangle.chromeRule">
                <Setter Property="IsVisible" Value="False" />
            </Style>

            <!--  The layers sidebar joins the bars on the backdrop: no slab of its own, a themed
                  header, and rows the panel styles itself (see LayersPanel.axaml).  -->
            <Style Selector="Grid.modern controls|LayersPanel">
                <Setter Property="IsModern" Value="True" />
            </Style>
            <Style Selector="Grid.modern Border#sidebarBorder">
                <Setter Property="Background" Value="{DynamicResource ClowdEditorSidebarBrush}" />
            </Style>
            <Style Selector="Grid.modern Border#sidebarHeader">
                <Setter Property="Background" Value="{DynamicResource SemiColorFill1}" />
                <Setter Property="Padding" Value="14,8" />
            </Style>
            <Style Selector="Grid.modern Border#sidebarHeader TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource SemiColorText2}" />
            </Style>

            <!--  The content is the one thing that is still a surface: it sits on top of the
                  backdrop, rounded on the corner where the two bars meet it and lifted off it by
                  a shadow alone. No edge line — the two bars are the only place one would fall,
                  and a hairline fades out over the corner arc exactly where the radius needs it
                  most. The shadow is the separation the hairline rules used to give, and it is
                  cast by the whole content block so that opening the sidebar does not cut it
                  short halfway along the top edge.  -->
            <Style Selector="Grid.modern Border#contentSurface">
                <Setter Property="CornerRadius" Value="12,0,0,0" />
                <Setter Property="BoxShadow" Value="{DynamicResource ClowdEditorSurfaceShadow}" />
            </Style>
            <Style Selector="Grid.modern Border#canvasSurface">
                <Setter Property="CornerRadius" Value="12,0,0,0" />
            </Style>
            <Style Selector="Grid.modern Border#canvasClip">
                <Setter Property="CornerRadius" Value="12,0,0,0" />
            </Style>

            <!--  The surface's edge. A border on contentSurface itself would never be seen: the
                  canvas and the sidebar cover it exactly, so the line is a sibling laid over them
                  instead, and hit-test invisible so the canvas underneath still takes every
                  pointer event. Top and left only — those are the two edges the bars face, and
                  the other two run into the window frame.  -->
            <Style Selector="Grid.modern Border#contentOutline">
                <Setter Property="CornerRadius" Value="12,0,0,0" />
                <Setter Property="BorderThickness" Value="1,1,0,0" />
            </Style>

            <!--  ===== Compact chrome ===== (the legacy look; every value is the original)  -->

            <Style Selector="Grid.compact controls|DockAndWrapPanel#ToolBar">
                <Setter Property="ItemWidth" Value="30" />
                <Setter Property="Margin" Value="0,4,0,0" />
            </Style>
            <Style Selector="Grid.compact controls|DockAndWrapPanel#PropertiesBar">
                <Setter Property="ItemHeight" Value="30" />
            </Style>
            <Style Selector="Grid.compact controls|DockAndWrapPanel#PropertiesBar &gt; StackPanel">
                <Setter Property="Height" Value="30" />
                <Setter Property="Margin" Value="4,0,4,0" />
            </Style>
            <!--  The bar's own flat button chrome (AppResources), which the modern chrome drops in
                  favour of Semi's.  -->
            <!--  The sidebar's own fills. On the element they would be local values, which no
                   chrome style could override.  -->
            <Style Selector="Grid.compact Border#sidebarBorder">
                <Setter Property="Background" Value="#454545" />
            </Style>
            <Style Selector="Grid.compact Border#sidebarHeader">
                <Setter Property="Background" Value="#3d3d3d" />
            </Style>
            <Style Selector="Grid.compact Border#sidebarHeader TextBlock">
                <Setter Property="Foreground" Value="White" />
            </Style>

            <Style Selector="Grid.compact Button.fieldButton">
                <Setter Property="Theme" Value="{DynamicResource InnerToolButtonTheme}" />
            </Style>

            <Style Selector="Grid.compact controls|ThemedSpinner.wideField">
                <Setter Property="Width" Value="82" />
            </Style>

            <Style Selector="Grid.compact Border.swatchOuter">
                <Setter Property="Width" Value="22" />
                <Setter Property="Height" Value="22" />
            </Style>
        </Grid.Styles>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:DockAndWrapPanel
            x:Name="PropertiesBar"
            HorizontalAlignment="Stretch"
            Background="Transparent"
            Orientation="Horizontal">
            <controls:DockAndWrapPanel.Styles>
                <Style Selector="StackPanel">
                    <Setter Property="Orientation" Value="Horizontal" />
                </Style>

                <!--  A starred session's star is gold — the same mark the Recent page's rows carry,
                      so the state reads identically wherever it is shown. Unstarred keeps the
                      strip's white and the outline glyph (both set in SyncStarButton).  -->
                <Style Selector="controls|ToolButton.starOn">
                    <Setter Property="Foreground" Value="{DynamicResource ClowdStarBrush}" />
                </Style>

                <!--  A bare Border carries no focus adorner, so the swatches paint their own
                      keyboard ring: the white inner edge takes the same brush the theme's focus
                      adorner draws every other control's ring in (the accent tint AccentTheme
                      publishes for both variants), so tabbing along the bar reads as one ring.  -->
                <Style Selector="Border.colorSwatch:focus-visible">
                    <Setter Property="BorderBrush" Value="{DynamicResource AdornerLayerBorderBrush}" />
                </Style>
            </controls:DockAndWrapPanel.Styles>

            <!--  Clears the macOS traffic lights, which float over this bar once the client
                  area is extended. Zero-width off macOS.  -->
            <Border Width="{DynamicResource MacTitleBarGutterHorz}" />

            <StackPanel>
                <TextBlock
                    VerticalAlignment="Center"
                    FontWeight="Bold"
                    Text="{Binding ElementName=drawingCanvas, Path=SubjectName, Mode=OneWay}" />
            </StackPanel>

            <StackPanel IsVisible="{Binding ElementName=drawingCanvas, Path=IsCanvasSubject, Mode=OneWay}">
                <TextBlock VerticalAlignment="Center" Text="Zoom" />
                <controls:ThemedSpinner
                    DisplayScale="100"
                    Min="0.1"
                    SpinAmount="0.1"
                    Suffix="%"
                    Value="{Binding ElementName=drawingCanvas, Path=ContentScale, Mode=TwoWay}" />
                <controls:ResetDefaultButton
                    Margin="4,0,0,0"
                    CurrentValue="{Binding ElementName=drawingCanvas, Path=ContentScale, Mode=TwoWay}"
                    DefaultValue="1" />
            </StackPanel>

            <StackPanel IsVisible="{Binding ElementName=drawingCanvas, Path=IsCanvasSubject, Mode=OneWay}">
                <TextBlock VerticalAlignment="Center" Text="Background" />
                <Border
                    Margin="4,0,0,0"
                    BorderBrush="Black"
                    BorderThickness="1"
                    Classes="swatchOuter">
                    <Border
                        x:Name="backgroundColorSwatch"
                        Background="{x:Static util:CheckerBrushes.Light}"
                        BorderBrush="White"
                        BorderThickness="1"
                        Classes="colorSwatch"
                        Cursor="Hand"
                        Focusable="True"
                        KeyDown="backgroundColor_KeyDown"
                        PointerPressed="backgroundColor_Click">
                        <Border Background="{Binding ElementName=drawingCanvas, Path=ArtworkBackground, Mode=OneWay, Converter={StaticResource convColorToBrush}}" Classes="colorFill" />
                    </Border>
                </Border>
            </StackPanel>

            <StackPanel IsVisible="{Binding ElementName=drawingCanvas, Path=SubjectSkill, Mode=OneWay, Converter={StaticResource enumMatch}, ConverterParameter=Stroke}">
                <TextBlock VerticalAlignment="Center" Text="Stroke" />
                <controls:ThemedSpinner
                    Min="0"
                    SnapToWholeNumber="True"
                    SpinAmount="1"
                    Suffix="px"
                    Value="{Binding ElementName=drawingCanvas, Path=LineWidth, Mode=TwoWay}" />
            </StackPanel>

            <StackPanel IsVisible="{Binding ElementName=drawingCanvas, Path=SubjectSkill, Mode=OneWay, Converter={StaticResource enumMatch}, ConverterParameter=Color}">
                <TextBlock VerticalAlignment="Center" Text="Color" />
                <Border
                    Margin="4,0,0,0"
                    BorderBrush="Black"
                    BorderThickness="1"
                    Classes="swatchOuter"
                    IsVisible="{Binding ElementName=chkColorAuto, Path=!IsChecked}">
                    <Border
                        x:Name="objectColorSwatch"
                        Background="{x:Static util:CheckerBrushes.Light}"
                        BorderBrush="White"
                        BorderThickness="1"
                        Classes="colorSwatch"
                        Cursor="Hand"
                        Focusable="True"
                        KeyDown="objectColor_KeyDown"
                        PointerPressed="objectColor_Click">
                        <Border Background="{Binding ElementName=drawingCanvas, Path=ObjectColor, Mode=OneWay, Converter={StaticResource convColorToBrush}}" Classes="colorFill" />
                    </Border>
                </Border>
                <controls:CaptionedCheckBox
                    x:Name="chkColorAuto"
                    Margin="4,0,0,0"
                    Caption="Auto"
                    IsChecked="{Binding ElementName=drawingCanvas, Path=ObjectColorAuto, Mode=TwoWay}"
                    IsVisible="{Binding ElementName=drawingCanvas, Path=SubjectSkill, Mode=OneWay, Converter={StaticResource enumMatch}, ConverterParameter=AutoColor}" />
            </StackPanel>

            <StackPanel IsVisible="{Binding ElementName=drawingCanvas, Path=SubjectSkill, Mode=OneWay, Converter={StaticResource enumMatch}, ConverterParameter=Font}">
                <TextBlock VerticalAlignment="Center" Text="Font" />
                <Button
                    Classes="fieldButton"
                    Click="font_Click"
                    Content="{Binding ElementName=drawingCanvas, Path=TextFontFamilyName, Mode=OneWay}"
                    FontFamily="{Binding ElementName=drawingCanvas, Path=TextFontFamilyName, Mode=OneWay, Converter={StaticResource convFontFamily}}"
                    FontStretch="{Binding ElementName=drawingCanvas, Path=TextFontStretch, Mode=OneWay}"
                    FontStyle="{Binding ElementName=drawingCanvas, Path=TextFontStyle, Mode=OneWay}" />
            </StackPanel>

            <StackPanel IsVisible="{Binding ElementName=drawingCanvas, Path=SubjectSkill, Mode=OneWay, Converter={StaticResource enumMatch}, ConverterParameter=Angle}">
                <TextBlock VerticalAlignment="Center" Text="Angle" />
                <controls:ThemedSpinner
                    Max="180"
                    Min="-180"
                    SnapToWholeNumber="True"
                    SpinAmount="10"
                    Suffix="°"
                    Value="{Binding ElementName=drawingCanvas, Path=ObjectAngle, Mode=TwoWay}" />
                <controls:ResetDefaultButton
                    Margin="4,0,0,0"
                    CurrentValue="{Binding ElementName=drawingCanvas, Path=ObjectAngle, Mode=TwoWay}"
                    DefaultValue="0" />
            </StackPanel>

            <StackPanel IsVisible="{Binding ElementName=drawingCanvas, Path=SubjectSkill, Mode=OneWay, Converter={StaticResource enumMatch}, ConverterParameter=BlurRadius}">
                <TextBlock VerticalAlignment="Center" Text="Blur" />
                <controls:ThemedSpinner
                    Min="1"
                    SnapToWholeNumber="True"
                    SpinAmount="1"
                    Suffix="px"
                    Value="{Binding ElementName=drawingCanvas, Path=BlurRadius, Mode=TwoWay}" />
            </StackPanel>

            <StackPanel IsVisible="{Binding ElementName=drawingCanvas, Path=SubjectSkill, Mode=OneWay, Converter={StaticResource enumMatch}, ConverterParameter=Radius}">
                <TextBlock VerticalAlignment="Center" Text="Radius" />
                <!-- A window's corner radius runs to three digits plus the unit, which sits tight
                     at the default field width. -->
                <controls:ThemedSpinner
                    Classes="wideField"
                    Min="0"
                    SnapToWholeNumber="True"
                    SpinAmount="1"
                    Suffix="px"
                    Value="{Binding ElementName=drawingCanvas, Path=CornerRadius, Mode=TwoWay}" />
            </StackPanel>

            <StackPanel IsVisible="{Binding ElementName=drawingCanvas, Path=SubjectSkill, Mode=OneWay, Converter={StaticResource enumMatch}, ConverterParameter=DashStyle}">
                <TextBlock VerticalAlignment="Center" Text="Dash" />
                <controls:ThemedDropDown
                    ItemsSource="{x:Static draw:DrawingCanvas.DashStyleValues}"
                    SelectedItem="{Binding ElementName=drawingCanvas, Path=DashStyle, Mode=TwoWay}" />
            </StackPanel>

            <StackPanel IsVisible="{Binding ElementName=drawingCanvas, Path=SubjectSkill, Mode=OneWay, Converter={StaticResource enumMatch}, ConverterParameter=ObscureMode}">
                <TextBlock VerticalAlignment="Center" Text="Mode" />
                <controls:ThemedDropDown
                    ItemsSource="{x:Static draw:DrawingCanvas.ObscureModeValues}"
                    SelectedItem="{Binding ElementName=drawingCanvas, Path=ObscureMode, Mode=TwoWay}"
                    ToolTip.Tip="How obscured regions are rendered" />
            </StackPanel>

            <controls:ToolButton
                Classes="wide"
                Command="{Binding ElementName=drawingCanvas, Path=CommandCropImage}"
                IconPath="{StaticResource IconCrop}"
                IsVisible="{Binding ElementName=drawingCanvas, Path=SubjectSkill, Mode=OneWay, Converter={StaticResource enumMatch}, ConverterParameter=Crop}"
                ToolTip.Tip="Crop Image" />

            <controls:ToolButton
                Classes="wide iconNudgeRight"
                CanToggle="True"
                IconPath="{StaticResource IconToolPointerFilled}"
                IsChecked="{Binding ElementName=drawingCanvas, Path=ObjectCursorVisible, Mode=TwoWay}"
                IsVisible="{Binding ElementName=drawingCanvas, Path=SubjectSkill, Mode=OneWay, Converter={StaticResource enumMatch}, ConverterParameter=Cursor}"
                ToolTip.Tip="Toggle Captured Mouse Cursor" />

            <!--  Star/unstar this session — the same toggle as the Recent page's row star, and
                  first in the docked group so it lands leftmost in the right-hand cluster. Glyph,
                  tint and tooltip are pushed from code (SyncStarButton) rather than bound: this
                  window is its own DataContext and does not raise PropertyChanged.  -->
            <controls:ToolButton
                x:Name="btnStar"
                Classes="wide"
                controls:DockAndWrapPanel.DockToEnd="True"
                Click="star_Click" />

            <controls:ToolButton
                x:Name="btnUpload"
                Classes="wide"
                controls:DockAndWrapPanel.DockToEnd="True"
                Command="{Binding CommandUpload}"
                IconPath="{StaticResource IconUpload}"
                ToolTip.Tip="Upload&#10;Right-click to choose upload destination." />

            <controls:ToolButton
                Classes="wide"
                controls:DockAndWrapPanel.DockToEnd="True"
                Command="{Binding CommandCopy}"
                IconPath="{StaticResource IconCopySmall}"
                ToolTip.Tip="Copy" />

            <controls:ToolButton
                Classes="wide"
                controls:DockAndWrapPanel.DockToEnd="True"
                Command="{Binding CommandSave}"
                IconPath="{StaticResource IconSaveSmall}"
                ToolTip.Tip="Save" />

            <Rectangle
                Width="1"
                Height="20"
                Margin="6,0"
                VerticalAlignment="Center"
                controls:DockAndWrapPanel.DockToEnd="True"
                Classes="chromeRule"
                Fill="#666666" />

            <controls:ToolButton
                Classes="wide"
                controls:DockAndWrapPanel.DockToEnd="True"
                CanToggle="True"
                IconPath="{StaticResource IconLayers}"
                IsChecked="{Binding SidebarVisible, Mode=TwoWay}"
                ToolTip.Tip="Layers panel" />

            <controls:ToolButton
                Classes="wide"
                controls:DockAndWrapPanel.DockToEnd="True"
                CanToggle="True"
                IconPath="{StaticResource IconPinned}"
                IsChecked="{Binding Topmost, Mode=TwoWay}"
                ToolTip.Tip="Always on top" />

        </controls:DockAndWrapPanel>

        <Grid x:Name="contentGrid" Grid.Row="1">
            <Grid.Styles>
                <!--  The splitter is an invisible 8px grab zone straddling the sidebar's edge (its
                      column is 2px wide; negative margins overlap the neighbors) drawing only the
                      2px edge line — resizing should feel like grabbing the panel edge, not a
                      separate handle. Hover/drag brighten the line.  -->
                <Style Selector="GridSplitter#sidebarSplitter /template/ Rectangle#splitterLine">
                    <Setter Property="Fill" Value="#666666" />
                </Style>
                <Style Selector="GridSplitter#sidebarSplitter:pointerover /template/ Rectangle#splitterLine">
                    <Setter Property="Fill" Value="#999999" />
                </Style>
                <Style Selector="GridSplitter#sidebarSplitter:pressed /template/ Rectangle#splitterLine">
                    <Setter Property="Fill" Value="#B8B8B8" />
                </Style>
            </Grid.Styles>

            <!--  Column 3 is the resizable sidebar (reached in code as SidebarColumn); its pixel
                  Width/MinWidth are driven by ApplySidebarVisible, MaxWidth bounds the drag.  -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition
                    Width="230"
                    MinWidth="140"
                    MaxWidth="600" />
            </Grid.ColumnDefinitions>

            <Rectangle
                Grid.Column="0"
                Height="1"
                Margin="4,0,4,0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                Classes="chromeRule"
                Fill="#666666" />

            <!--  ItemWidth is required for DockToEnd to work in a vertical panel (see
                  DockAndWrapPanel.canDock); it and the strip margin are set per chrome above,
                  since the button is 30px dense and 40px modern.  -->
            <controls:DockAndWrapPanel
                x:Name="ToolBar"
                Grid.Column="0"
                Orientation="Vertical"
                UseLayoutRounding="True">

                <!--  The vector/raster tool buttons are generated in code-behind (RebuildToolStrip)
                      and inserted at the front of this panel; the fixed Undo/Redo/customize
                      buttons below dock to the bottom of the strip.  -->

                <controls:ToolButton
                    controls:DockAndWrapPanel.DockToEnd="True"
                    Command="{Binding ElementName=drawingCanvas, Path=CommandUndo, Mode=OneWay}"
                    IconPath="{StaticResource IconUndo}"
                    ToolTip.Tip="Undo (Ctrl+Z)" />

                <controls:ToolButton
                    controls:DockAndWrapPanel.DockToEnd="True"
                    Command="{Binding ElementName=drawingCanvas, Path=CommandRedo, Mode=OneWay}"
                    IconPath="{StaticResource IconRedo}"
                    ToolTip.Tip="Redo (Ctrl+Y)" />

                <controls:ToolButton
                    x:Name="btnCustomize"
                    Classes="wide"
                    controls:DockAndWrapPanel.DockToEnd="True"
                    Click="customize_Click"
                    IconPath="{StaticResource IconCustomize}"
                    ToolTip.Tip="Customize toolbar…" />

            </controls:DockAndWrapPanel>

            <!--  The surface the editor's content sits on: the canvas and, when it is open, the
                  layers sidebar. It is what casts the shadow onto the two bars, so the sidebar
                  does not punch a hole in it by being a separate slab beside the canvas. It also
                  fills the 2px the splitter column takes between the two.  -->
            <Border
                x:Name="contentSurface"
                Grid.Column="1"
                Grid.ColumnSpan="3"
                Background="{DynamicResource ClowdEditorCanvasBrush}" />

            <!--  Two borders, not one: ClipToBounds is what rounds the canvas off at the corner,
                  and it clips the control's own drawing too — so this pair cannot be collapsed
                  into contentSurface above, which has to draw a shadow outside its own bounds.
                  The outer also carries the fill, so the 1px seam between the two rounded curves
                  has the canvas colour behind it rather than the backdrop, which otherwise
                  softens the corner.  -->
            <Border
                x:Name="canvasSurface"
                Grid.Column="1"
                Background="{DynamicResource ClowdEditorCanvasBrush}">
                <Border
                    x:Name="canvasClip"
                    Background="{DynamicResource ClowdEditorCanvasBrush}"
                    ClipToBounds="True">
                    <draw:DrawingCanvas
                        x:Name="drawingCanvas"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch" />
                </Border>
            </Border>

            <GridSplitter
                x:Name="sidebarSplitter"
                Grid.Column="2"
                Width="8"
                Margin="-3,0"
                ZIndex="1"
                Background="Transparent"
                IsVisible="False"
                ResizeBehavior="PreviousAndNext"
                ResizeDirection="Columns"
                DragCompleted="sidebarSplitter_DragCompleted">
                <GridSplitter.Template>
                    <ControlTemplate>
                        <Panel Name="splitterZone" Background="{TemplateBinding Background}">
                            <Rectangle
                                Name="splitterLine"
                                Width="2"
                                HorizontalAlignment="Center" />
                        </Panel>
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>

            <Border
                x:Name="sidebarBorder"
                Grid.Column="3"
                IsVisible="False">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border
                        x:Name="sidebarHeader"
                        Grid.Row="0"
                        Padding="10,6">
                        <TextBlock
                            FontSize="11"
                            FontWeight="Bold"
                            Text="LAYERS" />
                    </Border>

                    <controls:LayersPanel
                        x:Name="layersPanel"
                        Grid.Row="1" />
                </Grid>
            </Border>

            <!--  The line along the content surface's lip, over the canvas and the sidebar rather
                  than under them (see the chrome style). Above the splitter too, so the top edge
                  runs unbroken across the gap between the two.  -->
            <Border
                x:Name="contentOutline"
                Grid.Column="1"
                Grid.ColumnSpan="3"
                ZIndex="2"
                BorderBrush="{DynamicResource ClowdEditorSurfaceEdgeBrush}"
                IsHitTestVisible="False" />

        </Grid>

        <!--  Anchored to the swatch that opened it (PlacementTarget is set in code), never to the
              pointer: the pointer is only where the swatch is when the swatch was clicked, and a
              keyboard open put the picker wherever the mouse happened to be sitting. The offsets
              cancel the dialog's 10px shadow margin, so the popup's visible edge lines up with the
              swatch's left edge and sits 2px under it.  -->
        <Popup
            x:Name="miniColorPopup"
            HorizontalOffset="-10"
            IsLightDismissEnabled="True"
            Placement="BottomEdgeAlignedLeft"
            VerticalOffset="-8">
            <colors:MiniColorDialog
                x:Name="miniColor"
                Margin="10"
                Realtime="True" />
        </Popup>

        <!--  The shared customize flyout (Controls/CustomizeToolbarPopup): rows, chrome picker
              and reset buttons all live in there; this window supplies the tools and acts on what
              the user does to them (see InitCustomizePopup).  -->
        <controls:CustomizeToolbarPopup x:Name="customizePopup" />

    </Grid>
</local:SystemThemedWindow>
