<local:SystemThemedWindow
    x:Class="Clowd.UI.EditorWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:colors="clr-namespace:Clowd.UI.Dialogs.ColorPicker"
    xmlns:controls="clr-namespace:Clowd.UI.Controls"
    xmlns:conv="clr-namespace:Clowd.UI.Converters"
    xmlns:draw="clr-namespace:Clowd.Drawing;assembly=Clowd.Drawing"
    xmlns:local="clr-namespace:Clowd.UI"
    xmlns:util="clr-namespace:Clowd.Util"
    Title="Edit - Clowd"
    Width="1050"
    Height="750"
    FontSize="13"
    Foreground="White"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <draw:ToolTypeConverter x:Key="convToolType" />
        <conv:ColorToBrushConverter x:Key="convColorToBrush" />
        <conv:EnumMatchToBooleanConverter x:Key="enumMatch" />
        <conv:StringToFontFamilyConverter x:Key="convFontFamily" />

        <!--  WPF "InnerToolButtonStyle" (the font preview button)  -->
        <ControlTheme x:Key="InnerToolButtonTheme" TargetType="Button">
            <Setter Property="Background" Value="#454545" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#666666" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Padding" Value="10,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid>
                        <Rectangle
                            Name="_bg"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch" />
                        <Border
                            Padding="{TemplateBinding Padding}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter
                                Name="PART_ContentPresenter"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter>
            <Style Selector="^ /template/ Rectangle#_bg">
                <Setter Property="Fill" Value="#454545" />
            </Style>
            <Style Selector="^:pointerover /template/ Rectangle#_bg">
                <Setter Property="Fill" Value="#66FFFFFF" />
            </Style>
        </ControlTheme>
    </Window.Resources>

    <Grid x:Name="rootGrid" Background="#535353">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:DockAndWrapPanel
            x:Name="PropertiesBar"
            HorizontalAlignment="Stretch"
            ItemHeight="30"
            Orientation="Horizontal">
            <controls:DockAndWrapPanel.Styles>
                <Style Selector="StackPanel">
                    <Setter Property="Margin" Value="4,0,4,0" />
                    <Setter Property="Height" Value="30" />
                    <Setter Property="Orientation" Value="Horizontal" />
                </Style>
            </controls:DockAndWrapPanel.Styles>

            <StackPanel>
                <TextBlock VerticalAlignment="Center">
                    <Run Text="{Binding ElementName=drawingCanvas, Path=SubjectType, Mode=OneWay}" />
                    <Run FontWeight="Bold" Text="{Binding ElementName=drawingCanvas, Path=SubjectName, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>

            <StackPanel>
                <TextBlock VerticalAlignment="Center" Text="Zoom:" />
                <controls:SpinnerTextBox
                    DisplayScale="100"
                    Min="0.1"
                    SpinAmount="0.1"
                    Suffix="%"
                    Value="{Binding ElementName=drawingCanvas, Path=ContentScale, Mode=TwoWay}" />
                <controls:ResetDefaultButton
                    Margin="4,0,0,0"
                    CurrentValue="{Binding ElementName=drawingCanvas, Path=ContentScale, Mode=TwoWay}"
                    DefaultValue="1" />
            </StackPanel>

            <StackPanel IsVisible="{Binding ElementName=drawingCanvas, Path=SubjectSkill, Mode=OneWay, Converter={StaticResource enumMatch}, ConverterParameter=CanvasBackground}">
                <TextBlock VerticalAlignment="Center" Text="Canvas:" />
                <Border
                    Width="22"
                    Height="22"
                    Margin="4,0,0,0"
                    BorderBrush="Black"
                    BorderThickness="1">
                    <Border
                        Background="{x:Static util:CheckerBrushes.Light}"
                        BorderBrush="White"
                        BorderThickness="1"
                        Cursor="Hand"
                        PointerPressed="backgroundColor_Click">
                        <Rectangle Fill="{Binding ElementName=drawingCanvas, Path=ArtworkBackground, Mode=OneWay, Converter={StaticResource convColorToBrush}}" />
                    </Border>
                </Border>
            </StackPanel>

            <StackPanel IsVisible="{Binding ElementName=drawingCanvas, Path=SubjectSkill, Mode=OneWay, Converter={StaticResource enumMatch}, ConverterParameter=Stroke}">
                <TextBlock VerticalAlignment="Center" Text="Stroke:" />
                <controls:SpinnerTextBox
                    Min="0"
                    SnapToWholeNumber="True"
                    SpinAmount="1"
                    Suffix="px"
                    Value="{Binding ElementName=drawingCanvas, Path=LineWidth, Mode=TwoWay}" />
            </StackPanel>

            <StackPanel IsVisible="{Binding ElementName=drawingCanvas, Path=SubjectSkill, Mode=OneWay, Converter={StaticResource enumMatch}, ConverterParameter=Color}">
                <TextBlock VerticalAlignment="Center" Text="Color:" />
                <Border
                    Width="22"
                    Height="22"
                    Margin="4,0,0,0"
                    BorderBrush="Black"
                    BorderThickness="1"
                    IsVisible="{Binding ElementName=chkColorAuto, Path=!IsChecked}">
                    <Border
                        Background="{x:Static util:CheckerBrushes.Light}"
                        BorderBrush="White"
                        BorderThickness="1"
                        Cursor="Hand"
                        PointerPressed="objectColor_Click">
                        <Rectangle Fill="{Binding ElementName=drawingCanvas, Path=ObjectColor, Mode=OneWay, Converter={StaticResource convColorToBrush}}" />
                    </Border>
                </Border>
                <StackPanel
                    Height="20"
                    Margin="4,0,0,0"
                    VerticalAlignment="Center"
                    IsVisible="{Binding ElementName=drawingCanvas, Path=SubjectSkill, Mode=OneWay, Converter={StaticResource enumMatch}, ConverterParameter=AutoColor}"
                    Orientation="Vertical">
                    <Viewbox Width="10" Height="10">
                        <CheckBox
                            x:Name="chkColorAuto"
                            Margin="0"
                            Padding="0"
                            HorizontalAlignment="Center"
                            MinWidth="0"
                            MinHeight="0"
                            IsChecked="{Binding ElementName=drawingCanvas, Path=ObjectColorAuto, Mode=TwoWay}" />
                    </Viewbox>
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="8"
                        Text="Auto" />
                </StackPanel>
            </StackPanel>

            <StackPanel IsVisible="{Binding ElementName=drawingCanvas, Path=SubjectSkill, Mode=OneWay, Converter={StaticResource enumMatch}, ConverterParameter=Font}">
                <TextBlock VerticalAlignment="Center" Text="Font:" />
                <Button
                    Click="font_Click"
                    Content="{Binding ElementName=drawingCanvas, Path=TextFontFamilyName, Mode=OneWay}"
                    FontFamily="{Binding ElementName=drawingCanvas, Path=TextFontFamilyName, Mode=OneWay, Converter={StaticResource convFontFamily}}"
                    FontStretch="{Binding ElementName=drawingCanvas, Path=TextFontStretch, Mode=OneWay}"
                    FontStyle="{Binding ElementName=drawingCanvas, Path=TextFontStyle, Mode=OneWay}"
                    Theme="{StaticResource InnerToolButtonTheme}" />
            </StackPanel>

            <StackPanel IsVisible="{Binding ElementName=drawingCanvas, Path=SubjectSkill, Mode=OneWay, Converter={StaticResource enumMatch}, ConverterParameter=Angle}">
                <TextBlock VerticalAlignment="Center" Text="Angle:" />
                <controls:SpinnerTextBox
                    Max="180"
                    Min="-180"
                    SnapToWholeNumber="True"
                    SpinAmount="10"
                    Suffix="°"
                    Value="{Binding ElementName=drawingCanvas, Path=ObjectAngle, Mode=TwoWay}" />
                <controls:ResetDefaultButton
                    Margin="4,0,0,0"
                    CurrentValue="{Binding ElementName=drawingCanvas, Path=ObjectAngle, Mode=TwoWay}"
                    DefaultValue="0" />
            </StackPanel>

            <StackPanel IsVisible="{Binding ElementName=drawingCanvas, Path=SubjectSkill, Mode=OneWay, Converter={StaticResource enumMatch}, ConverterParameter=BlurRadius}">
                <TextBlock VerticalAlignment="Center" Text="Blur:" />
                <controls:SpinnerTextBox
                    Min="1"
                    SnapToWholeNumber="True"
                    SpinAmount="1"
                    Suffix="px"
                    Value="{Binding ElementName=drawingCanvas, Path=BlurRadius, Mode=TwoWay}" />
            </StackPanel>

            <controls:ToolButton
                Padding="6"
                Command="{Binding ElementName=drawingCanvas, Path=CommandCropImage}"
                IconPath="{StaticResource IconCrop}"
                IsVisible="{Binding ElementName=drawingCanvas, Path=SubjectSkill, Mode=OneWay, Converter={StaticResource enumMatch}, ConverterParameter=Crop}"
                ToolTip.Tip="Crop Image" />

            <controls:ToolButton
                Padding="6"
                CanToggle="True"
                IconPath="{StaticResource IconToolPointerFilled}"
                IsChecked="{Binding ElementName=drawingCanvas, Path=ObjectCursorVisible, Mode=TwoWay}"
                IsVisible="{Binding ElementName=drawingCanvas, Path=SubjectSkill, Mode=OneWay, Converter={StaticResource enumMatch}, ConverterParameter=Cursor}"
                ToolTip.Tip="Toggle Captured Mouse Cursor" />

            <controls:ToolButton
                x:Name="btnUpload"
                Padding="6"
                controls:DockAndWrapPanel.DockToEnd="True"
                Command="{Binding CommandUpload}"
                IconPath="{StaticResource IconClowd}"
                ToolTip.Tip="Upload&#10;Right-click to choose upload destination." />

            <controls:ToolButton
                Padding="6"
                controls:DockAndWrapPanel.DockToEnd="True"
                Command="{Binding CommandCopy}"
                IconPath="{StaticResource IconCopySmall}"
                ToolTip.Tip="Copy" />

            <controls:ToolButton
                Padding="6"
                controls:DockAndWrapPanel.DockToEnd="True"
                Command="{Binding CommandSave}"
                IconPath="{StaticResource IconSaveSmall}"
                ToolTip.Tip="Save" />

            <Rectangle
                Width="1"
                Height="20"
                Margin="6,0"
                VerticalAlignment="Center"
                controls:DockAndWrapPanel.DockToEnd="True"
                Fill="#666666" />

            <controls:ToolButton
                Padding="6"
                controls:DockAndWrapPanel.DockToEnd="True"
                CanToggle="True"
                IconPath="{StaticResource IconLayers}"
                IsChecked="{Binding SidebarVisible, Mode=TwoWay}"
                ToolTip.Tip="Layers panel" />

            <controls:ToolButton
                Padding="6"
                controls:DockAndWrapPanel.DockToEnd="True"
                CanToggle="True"
                IconPath="{StaticResource IconPinned}"
                IsChecked="{Binding Topmost, Mode=TwoWay}"
                ToolTip.Tip="Always on top" />

        </controls:DockAndWrapPanel>

        <Grid x:Name="contentGrid" Grid.Row="1">
            <Grid.Styles>
                <Style Selector="GridSplitter#sidebarSplitter">
                    <Setter Property="Background" Value="#666666" />
                </Style>
                <Style Selector="GridSplitter#sidebarSplitter:pointerover">
                    <Setter Property="Background" Value="#808080" />
                </Style>
            </Grid.Styles>

            <!--  Column 3 is the resizable sidebar (reached in code as SidebarColumn); its pixel
                  Width/MinWidth are driven by ApplySidebarVisible, MaxWidth bounds the drag.  -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition
                    Width="230"
                    MinWidth="140"
                    MaxWidth="600" />
            </Grid.ColumnDefinitions>

            <Rectangle
                Grid.Column="0"
                Height="1"
                Margin="4,0,4,0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                Fill="#666666" />

            <!--  ItemWidth is required for DockToEnd to work in a vertical panel (see
                  DockAndWrapPanel.canDock); ToolButton is a fixed 30x30.  -->
            <controls:DockAndWrapPanel
                x:Name="ToolBar"
                Grid.Column="0"
                Margin="0,4,0,0"
                ItemWidth="30"
                Orientation="Vertical"
                UseLayoutRounding="True">

                <!--  The vector/raster tool buttons are generated in code-behind (RebuildToolStrip)
                      and inserted at the front of this panel; the fixed Undo/Redo/customize
                      buttons below always sit at the end of the strip.  -->

                <controls:ToolButton
                    Command="{Binding ElementName=drawingCanvas, Path=CommandUndo, Mode=OneWay}"
                    IconPath="{StaticResource IconUndo}"
                    ToolTip.Tip="Undo (Ctrl+Z)" />

                <controls:ToolButton
                    Command="{Binding ElementName=drawingCanvas, Path=CommandRedo, Mode=OneWay}"
                    IconPath="{StaticResource IconRedo}"
                    ToolTip.Tip="Redo (Ctrl+Y)" />

                <controls:ToolButton
                    x:Name="btnCustomize"
                    Padding="6"
                    controls:DockAndWrapPanel.DockToEnd="True"
                    Click="customize_Click"
                    IconPath="{StaticResource IconCustomize}"
                    ToolTip.Tip="Customize toolbar…" />

            </controls:DockAndWrapPanel>

            <Border
                Grid.Column="1"
                Background="#1e1e1e"
                ClipToBounds="True">
                <draw:DrawingCanvas
                    x:Name="drawingCanvas"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch" />
            </Border>

            <GridSplitter
                x:Name="sidebarSplitter"
                Grid.Column="2"
                Width="5"
                IsVisible="False"
                ResizeBehavior="PreviousAndNext"
                ResizeDirection="Columns"
                DragCompleted="sidebarSplitter_DragCompleted" />

            <Border
                x:Name="sidebarBorder"
                Grid.Column="3"
                Background="#454545"
                BorderBrush="#666666"
                BorderThickness="1,0,0,0"
                IsVisible="False">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Row="0"
                        Padding="10,6"
                        Background="#3d3d3d">
                        <TextBlock
                            FontSize="11"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="LAYERS" />
                    </Border>

                    <controls:LayersPanel
                        x:Name="layersPanel"
                        Grid.Row="1" />
                </Grid>
            </Border>

        </Grid>

        <Popup
            x:Name="miniColorPopup"
            HorizontalOffset="-5"
            IsLightDismissEnabled="True"
            Placement="Pointer"
            VerticalOffset="-5">
            <colors:MiniColorDialog
                x:Name="miniColor"
                Margin="10"
                Realtime="True" />
        </Popup>

        <Popup
            x:Name="customizePopup"
            HorizontalOffset="4"
            IsLightDismissEnabled="True"
            Placement="Right">
            <Border
                Width="240"
                Background="#454545"
                BorderBrush="#666666"
                BorderThickness="1">
                <StackPanel Margin="8">
                    <TextBlock
                        Margin="4,2,4,8"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="Customize toolbar" />
                    <StackPanel x:Name="customizeRows" />
                    <Button
                        Margin="4,8,4,0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Click="customizeResetOrder_Click"
                        Content="Reset Tool Order" />
                    <Button
                        Margin="4,4,4,2"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Classes="Danger"
                        Click="customizeResetSettings_Click"
                        Content="Reset Tool Settings" />
                </StackPanel>
            </Border>
        </Popup>

    </Grid>
</local:SystemThemedWindow>
