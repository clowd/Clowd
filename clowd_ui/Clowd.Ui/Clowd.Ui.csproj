<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>Clowd.UI</RootNamespace>
    <ApplicationIcon>Assets\clowd-default.ico</ApplicationIcon>
    <!-- NAudio's WASAPI MMDevice enumeration requires built-in COM (Windows-only at runtime) -->
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <NoWarn>$(NoWarn);CA2007</NoWarn>
    <!-- Avalonia 12 turns compiled bindings on by default. Our views bind against
         runtime-assigned DataContexts and untyped DataTemplate items, none of which carry
         an x:DataType, so keep the 11.x reflection binding behaviour. Annotating the views
         with x:DataType and flipping this back on is a worthwhile follow-up. -->
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.0" />
    <PackageReference Include="Semi.Avalonia" Version="12.1.0" />
    <PackageReference Include="Irihi.Ursa" Version="2.1.0" />
    <PackageReference Include="Irihi.Ursa.Themes.Semi" Version="2.1.0" />
    <PackageReference Include="SharpHook" Version="7.1.3" />
    <!-- WASAPI via built-in COM interop; all call sites are OperatingSystem.IsWindows()-guarded -->
    <PackageReference Include="NAudio.Wasapi" Version="2.3.0" />
    <PackageReference Include="Velopack" Version="1.2.0" />
    <PackageReference Include="Sentry" Version="6.8.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Clowd.Drawing\Clowd.Drawing.csproj" />
    <ProjectReference Include="..\Clowd.Shared\Clowd.Shared.csproj" />
    <ProjectReference Include="..\Clowd.Upload\Clowd.Upload.csproj" />
    <ProjectReference Include="..\Clowd.VideoSDK\Clowd.VideoSDK.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <!-- The macOS icon is consumed by vpk pack (release.yml) from the repo tree, not at
         runtime, so keep it out of the embedded Avalonia resources. -->
    <AvaloniaResource Remove="Assets\clowd-default.icns" />
  </ItemGroup>
  <!-- Clowd.VideoSDK pins SkiaSharp to $(SkiaSharpVersion) (Directory.Build.props) so the
       SDK and Avalonia share one native Skia in this process. NuGet silently unifies to the
       highest requested version, so an Avalonia upgrade that bumps SkiaSharp would otherwise
       drift past the pin unnoticed - fail the build instead and update the pin. -->
  <Target Name="VerifySkiaSharpMatchesAvalonia" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <_ResolvedSkiaSharp Include="@(RuntimeCopyLocalItems)"
                          Condition="'%(RuntimeCopyLocalItems.NuGetPackageId)' == 'SkiaSharp'" />
    </ItemGroup>
    <Error Condition="'@(_ResolvedSkiaSharp)' != '' AND '%(_ResolvedSkiaSharp.NuGetPackageVersion)' != '$(SkiaSharpVersion)'"
           Text="Clowd.Ui resolved SkiaSharp %(_ResolvedSkiaSharp.NuGetPackageVersion) but clowd_ui/Directory.Build.props pins SkiaSharpVersion=$(SkiaSharpVersion). Update the pin to the version Avalonia resolves." />
  </Target>
</Project>
