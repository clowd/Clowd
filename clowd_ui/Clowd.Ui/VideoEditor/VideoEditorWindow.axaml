<local:SystemThemedWindow
    x:Class="Clowd.UI.VideoEditor.VideoEditorWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Clowd.UI.Controls"
    xmlns:insp="clr-namespace:Clowd.UI.VideoEditor.Inspector"
    xmlns:local="clr-namespace:Clowd.UI"
    xmlns:tl="clr-namespace:Clowd.UI.VideoEditor.Timeline"
    xmlns:ve="clr-namespace:Clowd.UI.VideoEditor"
    Title="Edit Video - Clowd"
    Width="1100"
    Height="720"
    MinWidth="640"
    MinHeight="480"
    FontSize="13"
    Foreground="White"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!--  transport icons not in VectorIcons: frame-step (bar + triangle)  -->
        <StreamGeometry x:Key="IconFrameNext">M2,2 L2,14 L11,8 Z M12,2 L14,2 L14,14 L12,14 Z</StreamGeometry>
        <StreamGeometry x:Key="IconFramePrev">M14,2 L14,14 L5,8 Z M2,2 L4,2 L4,14 L2,14 Z</StreamGeometry>
        <!--  split-at-playhead: a vertical cut line between two half-blocks  -->
        <StreamGeometry x:Key="IconSplit">M7,1 L9,1 L9,15 L7,15 Z M1,4 L5,4 L5,12 L1,12 Z M11,4 L15,4 L15,12 L11,12 Z</StreamGeometry>
    </Window.Resources>

    <Grid x:Name="rootGrid" Background="#535353">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:DockAndWrapPanel
            x:Name="TopBar"
            HorizontalAlignment="Stretch"
            ItemHeight="30"
            Orientation="Horizontal">
            <controls:DockAndWrapPanel.Styles>
                <Style Selector="StackPanel">
                    <Setter Property="Margin" Value="4,0,4,0" />
                    <Setter Property="Height" Value="30" />
                    <Setter Property="Orientation" Value="Horizontal" />
                </Style>
            </controls:DockAndWrapPanel.Styles>

            <StackPanel>
                <TextBlock
                    x:Name="txtSessionName"
                    VerticalAlignment="Center"
                    FontWeight="Bold" />
                <TextBlock
                    x:Name="txtMediaSummary"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    Foreground="#CCCCCC" />
            </StackPanel>

            <StackPanel>
                <controls:ToolButton
                    Padding="6"
                    Command="{Binding CommandUndo}"
                    IconPath="{StaticResource IconUndo}"
                    ToolTip.Tip="Undo (Ctrl+Z)" />
                <controls:ToolButton
                    Padding="6"
                    Command="{Binding CommandRedo}"
                    IconPath="{StaticResource IconRedo}"
                    ToolTip.Tip="Redo (Ctrl+Y)" />
            </StackPanel>

            <StackPanel>
                <controls:ToolButton
                    x:Name="btnAddText"
                    Padding="7"
                    Command="{Binding CommandAddText}"
                    IconPath="{StaticResource IconToolText}"
                    ToolTip.Tip="Add text at the playhead" />
                <controls:ToolButton
                    x:Name="btnAddImage"
                    Padding="6"
                    Command="{Binding CommandAddImage}"
                    IconPath="{StaticResource IconPhoto}"
                    ToolTip.Tip="Add an image at the playhead" />
                <controls:ToolButton
                    x:Name="btnImportMedia"
                    Padding="6"
                    Command="{Binding CommandImportMedia}"
                    IconPath="{StaticResource IconVideo}"
                    ToolTip.Tip="Import video or audio at the playhead" />
            </StackPanel>

            <controls:ToolButton
                x:Name="btnRender"
                Padding="6"
                controls:DockAndWrapPanel.DockToEnd="True"
                Command="{Binding CommandRender}"
                IconPath="{StaticResource IconVideoMP4}"
                ToolTip.Tip="Render edited video" />

            <Rectangle
                Width="1"
                Height="20"
                Margin="6,0"
                VerticalAlignment="Center"
                controls:DockAndWrapPanel.DockToEnd="True"
                Fill="#666666" />

            <controls:ToolButton
                x:Name="btnInspector"
                Padding="6"
                controls:DockAndWrapPanel.DockToEnd="True"
                CanToggle="True"
                IconPath="{StaticResource IconCustomize}"
                IsChecked="{Binding SidebarVisible, Mode=TwoWay}"
                ToolTip.Tip="Properties panel" />

            <controls:ToolButton
                Padding="6"
                controls:DockAndWrapPanel.DockToEnd="True"
                CanToggle="True"
                IconPath="{StaticResource IconPinned}"
                IsChecked="{Binding Topmost, Mode=TwoWay}"
                ToolTip.Tip="Always on top" />

        </controls:DockAndWrapPanel>

        <Grid x:Name="contentGrid" Grid.Row="1">
            <Grid.Styles>
                <!--  The splitter is an invisible 8px grab zone straddling the sidebar's edge (its
                      column is 2px wide; negative margins overlap the neighbours) drawing only the
                      2px edge line — resizing should feel like grabbing the panel edge, not a
                      separate handle. Hover/drag brighten the line.  -->
                <Style Selector="GridSplitter#sidebarSplitter /template/ Rectangle#splitterLine">
                    <Setter Property="Fill" Value="#666666" />
                </Style>
                <Style Selector="GridSplitter#sidebarSplitter:pointerover /template/ Rectangle#splitterLine">
                    <Setter Property="Fill" Value="#999999" />
                </Style>
                <Style Selector="GridSplitter#sidebarSplitter:pressed /template/ Rectangle#splitterLine">
                    <Setter Property="Fill" Value="#B8B8B8" />
                </Style>
            </Grid.Styles>

            <!--  Column 2 is the resizable property sidebar (reached in code as SidebarColumn); its
                  pixel Width/MinWidth are driven by ApplySidebarVisible, MaxWidth bounds the drag.  -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition
                    Width="230"
                    MinWidth="140"
                    MaxWidth="600" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Background="#1e1e1e"
                ClipToBounds="True">
                <Panel>
                    <ve:VideoPreviewControl x:Name="preview" />
                    <Border
                        x:Name="statusOverlay"
                        Padding="14,10"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#B0000000"
                        CornerRadius="6"
                        IsVisible="False">
                        <TextBlock
                            x:Name="txtStatus"
                            MaxWidth="420"
                            Foreground="#E0FFFFFF"
                            TextWrapping="Wrap" />
                    </Border>
                </Panel>
            </Border>

            <GridSplitter
                x:Name="sidebarSplitter"
                Grid.Column="1"
                Width="8"
                Margin="-3,0"
                ZIndex="1"
                Background="Transparent"
                DragCompleted="sidebarSplitter_DragCompleted"
                IsVisible="False"
                ResizeBehavior="PreviousAndNext"
                ResizeDirection="Columns">
                <GridSplitter.Template>
                    <ControlTemplate>
                        <Panel Name="splitterZone" Background="{TemplateBinding Background}">
                            <Rectangle
                                Name="splitterLine"
                                Width="2"
                                HorizontalAlignment="Center" />
                        </Panel>
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>

            <Border
                x:Name="sidebarBorder"
                Grid.Column="2"
                Background="#454545"
                IsVisible="False">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Row="0"
                        Padding="10,6"
                        Background="#3d3d3d">
                        <TextBlock
                            FontSize="11"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="PROPERTIES" />
                    </Border>

                    <insp:InspectorPanel
                        x:Name="inspectorPanel"
                        Grid.Row="1"
                        DataContext="{Binding Inspector}" />
                </Grid>
            </Border>

        </Grid>

        <!--  transport bar  -->
        <Border
            Grid.Row="2"
            Background="#454545"
            BorderBrush="#666666"
            BorderThickness="0,1,0,0">
            <DockPanel
                Height="30"
                Margin="8,4"
                LastChildFill="True">

                <StackPanel
                    DockPanel.Dock="Left"
                    Orientation="Horizontal"
                    Spacing="2">
                    <controls:ToolButton
                        x:Name="btnStepBack"
                        Width="30"
                        Height="30"
                        Padding="8"
                        Command="{Binding CommandStepBack}"
                        IconPath="{StaticResource IconFramePrev}"
                        ToolTip.Tip="Previous frame (Left)" />
                    <controls:ToolButton
                        x:Name="btnPlayPause"
                        Width="30"
                        Height="30"
                        Padding="7"
                        Command="{Binding CommandPlayPause}"
                        IconPath="{StaticResource IconPlay}"
                        ToolTip.Tip="Play (Space)" />
                    <controls:ToolButton
                        x:Name="btnStepForward"
                        Width="30"
                        Height="30"
                        Padding="8"
                        Command="{Binding CommandStepForward}"
                        IconPath="{StaticResource IconFrameNext}"
                        ToolTip.Tip="Next frame (Right)" />

                    <TextBlock
                        x:Name="txtPosition"
                        Margin="10,0"
                        VerticalAlignment="Center"
                        FontFamily="Consolas,Cascadia Mono,monospace"
                        Text="00:00.0 / 00:00.0" />

                    <controls:ToolButton
                        x:Name="btnSplit"
                        Width="30"
                        Height="30"
                        Padding="7"
                        Command="{Binding CommandSplit}"
                        IconPath="{StaticResource IconSplit}"
                        ToolTip.Tip="Split every track at playhead (Ctrl+K) — right-click a clip to split just that one" />
                </StackPanel>

                <StackPanel
                    HorizontalAlignment="Right"
                    DockPanel.Dock="Right"
                    Orientation="Horizontal"
                    Spacing="4">
                    <Path
                        Width="16"
                        Height="16"
                        VerticalAlignment="Center"
                        Data="{StaticResource IconSpeakerEnabled}"
                        Fill="#CCCCCC"
                        Stretch="Uniform" />
                    <Slider
                        x:Name="volumeSlider"
                        Width="100"
                        VerticalAlignment="Center"
                        Maximum="1"
                        Minimum="0" />
                </StackPanel>

                <Panel />
            </DockPanel>
        </Border>

        <!--  timeline: sized to its rows (ruler + one row per track + scrollbar), capped so a
              project with many rows scrolls vertically instead of eating the preview  -->
        <Border
            Grid.Row="3"
            Background="#3a3a3a"
            BorderBrush="#666666"
            BorderThickness="0,1,0,0">
            <tl:TimelineControl
                x:Name="timeline"
                MinHeight="190"
                MaxHeight="320"
                Margin="0,2,0,0" />
        </Border>

    </Grid>
</local:SystemThemedWindow>
