<UserControl
    x:Class="Clowd.UI.VideoEditor.Inspector.InspectorPanel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Clowd.UI.Controls"
    xmlns:ve="clr-namespace:Clowd.UI.VideoEditor">

    <UserControl.Resources>
        <!--  Shape-picker icons. All four share a 100x100 box so Stretch="Uniform" renders them at
              matching sizes; the squircle is traced from the same MaskGeometry the compositor
              clips with, so the icon is the shape you get.  -->
        <RectangleGeometry x:Key="MaskIconSquare" Rect="0,0,100,100" />
        <EllipseGeometry x:Key="MaskIconCircle" Rect="0,0,100,100" />
        <RectangleGeometry
            x:Key="MaskIconRounded"
            RadiusX="26"
            RadiusY="26"
            Rect="0,0,100,100" />

        <!--  A shape-picker tile: the icon (Tag) over its name (Content), in a rounded box that
              borrows the Semi RadioButton's own brushes — grey ring unselected, a thicker accent
              ring selected — so it stays in step with the theme's other radio controls. The
              padding drops by 1 when selected, keeping the content box the same size as the
              border thickens.  -->
        <ControlTheme x:Key="MaskShapeTile" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border
                        Name="_box"
                        Padding="7"
                        Background="Transparent"
                        BorderBrush="{DynamicResource RadioButtonUncheckIconDefaultBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <DockPanel>
                            <TextBlock
                                Name="_label"
                                Margin="0,6,0,0"
                                DockPanel.Dock="Bottom"
                                FontSize="11"
                                Foreground="#CCCCCC"
                                Text="{TemplateBinding Content}"
                                TextAlignment="Center" />
                            <Path
                                Name="_icon"
                                Width="28"
                                Height="28"
                                HorizontalAlignment="Center"
                                Data="{TemplateBinding Tag}"
                                Fill="#CCCCCC"
                                Stretch="Uniform" />
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter>

            <Style Selector="^:pointerover /template/ Border#_box">
                <Setter Property="BorderBrush" Value="{DynamicResource RadioButtonUncheckIconPointeroverBorderBrush}" />
            </Style>
            <Style Selector="^:checked /template/ Border#_box">
                <Setter Property="Padding" Value="6" />
                <Setter Property="BorderBrush" Value="{DynamicResource RadioButtonCheckIconDefaultBackground}" />
                <Setter Property="BorderThickness" Value="2" />
            </Style>
            <Style Selector="^:checked /template/ Path#_icon">
                <Setter Property="Fill" Value="{DynamicResource RadioButtonCheckIconDefaultBackground}" />
            </Style>
            <Style Selector="^:checked /template/ TextBlock#_label">
                <Setter Property="Foreground" Value="White" />
            </Style>
        </ControlTheme>
    </UserControl.Resources>

    <!--  The editor window's chrome is a fixed dark palette (NOT Semi tokens), so this panel is
          hand-coloured to match the sidebar it lives in — the same trade LayersPanel makes.  -->
    <UserControl.Styles>
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#9A9A9A" />
        </Style>
        <!--  MinWidth, not Width: the labels still line up as a column, but a long one ("Text
              scale") grows instead of being clipped now that the editor beside it is no longer
              packed against it.  -->
        <Style Selector="TextBlock.label">
            <Setter Property="MinWidth" Value="60" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#CCCCCC" />
        </Style>
        <!--  a label docked left and the editor filling the rest, so every row's editor can put
              its right edge on the panel's — where the full-width text boxes and combo boxes
              already end. A horizontal StackPanel cannot do that: it sizes to content.  -->
        <Style Selector="DockPanel.row">
            <Setter Property="LastChildFill" Value="True" />
        </Style>
        <Style Selector="StackPanel.section">
            <Setter Property="Spacing" Value="6" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <!--  wider than the 70px the shared spinner theme picks: this panel puts a spinner on
              nearly every row, and 70px truncates the longer values (e.g. "-360 °"). Right-aligned
              inside the row's fill column so it lines up with the text boxes below it; the theme's
              4px left margin would otherwise push it off that edge.  -->
        <Style Selector="controls|SpinnerTextBox">
            <Setter Property="Width" Value="100" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>
        <Style Selector="TextBox.field">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#454545" />
            <Setter Property="BorderBrush" Value="#666666" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Padding" Value="4,2" />
        </Style>
    </UserControl.Styles>

    <Panel>
        <TextBlock
            Margin="10"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="#88FFFFFF"
            IsVisible="{Binding !HasSelection}"
            Text="Nothing selected"
            TextAlignment="Center"
            TextWrapping="Wrap" />

        <ScrollViewer HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasSelection}">
            <StackPanel Margin="10" Spacing="12">

                <!--  subject: which row/kind the numbers below belong to  -->
                <StackPanel Spacing="2">
                    <TextBlock
                        FontWeight="Bold"
                        Foreground="White"
                        Text="{Binding SubjectName}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        FontSize="11"
                        Foreground="#999999"
                        Text="{Binding SubjectKind}" />
                </StackPanel>

                <StackPanel Classes="section">
                    <CheckBox Content="Hide row" IsChecked="{Binding TrackHidden, Mode=TwoWay}" IsVisible="{Binding ShowTrackHidden}" />
                    <CheckBox Content="Mute row" IsChecked="{Binding TrackMuted, Mode=TwoWay}" IsVisible="{Binding ShowTrackMuted}" />
                    <Button
                        Command="{Binding CommandUnlink}"
                        Content="Unlink from recording"
                        IsVisible="{Binding IsLinked}"
                        ToolTip.Tip="Stops this row moving and splitting with the rest of the recording" />
                </StackPanel>

                <!--  transform  -->
                <StackPanel Classes="section" IsVisible="{Binding ShowTransform}">
                    <TextBlock Classes="section" Text="PLACEMENT" />

                    <DockPanel Classes="row">
                        <TextBlock Classes="label" Text="Center X" />
                        <controls:SpinnerTextBox
                            DisplayScale="100"
                            Max="1"
                            Min="0"
                            SpinAmount="0.01"
                            Suffix="%"
                            Value="{Binding PositionX, Mode=TwoWay}" />
                    </DockPanel>

                    <DockPanel Classes="row">
                        <TextBlock Classes="label" Text="Center Y" />
                        <controls:SpinnerTextBox
                            DisplayScale="100"
                            Max="1"
                            Min="0"
                            SpinAmount="0.01"
                            Suffix="%"
                            Value="{Binding PositionY, Mode=TwoWay}" />
                    </DockPanel>

                    <DockPanel Classes="row" IsVisible="{Binding ShowScale}">
                        <!--  "Size" for pictures, "Text scale" for text — the TEXT section below
                              has its own font-size "Size" row, and the gizmo writes this Scale
                              for text too, so it must be visible (and distinguishable) there.
                              Unlocking the aspect ratio splits it into Width and Height.  -->
                        <TextBlock Classes="label" Text="{Binding ScaleLabel}" />
                        <controls:SpinnerTextBox
                            DisplayScale="100"
                            Max="4"
                            Min="0.01"
                            SpinAmount="0.01"
                            Suffix="%"
                            Value="{Binding Scale, Mode=TwoWay}" />
                    </DockPanel>

                    <DockPanel Classes="row" IsVisible="{Binding ShowScaleHeight}">
                        <TextBlock Classes="label" Text="{Binding ScaleHeightLabel}" />
                        <controls:SpinnerTextBox
                            DisplayScale="100"
                            Max="4"
                            Min="0.01"
                            SpinAmount="0.01"
                            Suffix="%"
                            Value="{Binding ScaleHeight, Mode=TwoWay}" />
                    </DockPanel>

                    <CheckBox
                        Content="Locked aspect ratio"
                        IsChecked="{Binding AspectLocked, Mode=TwoWay}"
                        IsVisible="{Binding ShowScale}"
                        ToolTip.Tip="Keep the item's own proportions. Unlock it to size the width and height apart." />

                    <DockPanel Classes="row">
                        <TextBlock Classes="label" Text="Rotation" />
                        <controls:SpinnerTextBox
                            Max="360"
                            Min="-360"
                            SnapToWholeNumber="True"
                            SpinAmount="5"
                            Suffix="°"
                            Value="{Binding Rotation, Mode=TwoWay}" />
                    </DockPanel>

                    <DockPanel Classes="row">
                        <TextBlock Classes="label" Text="Opacity" />
                        <controls:SpinnerTextBox
                            DisplayScale="100"
                            Max="1"
                            Min="0"
                            SpinAmount="0.05"
                            Suffix="%"
                            Value="{Binding Opacity, Mode=TwoWay}" />
                    </DockPanel>
                </StackPanel>

                <!--  mask  -->
                <StackPanel Classes="section" IsVisible="{Binding ShowMask}">
                    <TextBlock Classes="section" Text="SHAPE" />

                    <!--  a 2x2 grid of tiles rather than a row of radios: the shape is the thing
                          being chosen, so each option shows it. Stretches with the sidebar.  -->
                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="6"
                        RowDefinitions="Auto,Auto"
                        RowSpacing="6">
                        <RadioButton
                            Grid.Row="0"
                            Grid.Column="0"
                            Content="Square"
                            GroupName="ItemMask"
                            IsChecked="{Binding MaskSquare, Mode=TwoWay}"
                            Tag="{StaticResource MaskIconSquare}"
                            Theme="{StaticResource MaskShapeTile}" />
                        <RadioButton
                            Grid.Row="0"
                            Grid.Column="1"
                            Content="Circle"
                            GroupName="ItemMask"
                            IsChecked="{Binding MaskCircle, Mode=TwoWay}"
                            Tag="{StaticResource MaskIconCircle}"
                            Theme="{StaticResource MaskShapeTile}" />
                        <RadioButton
                            Grid.Row="1"
                            Grid.Column="0"
                            Content="Rounded"
                            GroupName="ItemMask"
                            IsChecked="{Binding MaskRounded, Mode=TwoWay}"
                            Tag="{StaticResource MaskIconRounded}"
                            Theme="{StaticResource MaskShapeTile}" />
                        <RadioButton
                            Grid.Row="1"
                            Grid.Column="1"
                            Content="Squircle"
                            GroupName="ItemMask"
                            IsChecked="{Binding MaskSquircle, Mode=TwoWay}"
                            Tag="{x:Static ve:MaskOutlines.SquircleIcon}"
                            Theme="{StaticResource MaskShapeTile}" />
                    </Grid>

                    <DockPanel Classes="row" IsVisible="{Binding ShowCornerRadius}">
                        <TextBlock Classes="label" Text="Corners" />
                        <controls:SpinnerTextBox
                            DisplayScale="100"
                            Max="0.5"
                            Min="0"
                            SpinAmount="0.05"
                            Suffix="%"
                            Value="{Binding CornerRadius, Mode=TwoWay}" />
                    </DockPanel>
                </StackPanel>

                <!--  crop  -->
                <StackPanel Classes="section" IsVisible="{Binding ShowCrop}">
                    <TextBlock Classes="section" Text="CROP" />

                    <DockPanel Classes="row">
                        <TextBlock Classes="label" Text="Left" />
                        <controls:SpinnerTextBox
                            DisplayScale="100"
                            Max="0.95"
                            Min="0"
                            SpinAmount="0.01"
                            Suffix="%"
                            Value="{Binding CropLeft, Mode=TwoWay}" />
                    </DockPanel>

                    <DockPanel Classes="row">
                        <TextBlock Classes="label" Text="Top" />
                        <controls:SpinnerTextBox
                            DisplayScale="100"
                            Max="0.95"
                            Min="0"
                            SpinAmount="0.01"
                            Suffix="%"
                            Value="{Binding CropTop, Mode=TwoWay}" />
                    </DockPanel>

                    <DockPanel Classes="row">
                        <TextBlock Classes="label" Text="Right" />
                        <controls:SpinnerTextBox
                            DisplayScale="100"
                            Max="0.95"
                            Min="0"
                            SpinAmount="0.01"
                            Suffix="%"
                            Value="{Binding CropRight, Mode=TwoWay}" />
                    </DockPanel>

                    <DockPanel Classes="row">
                        <TextBlock Classes="label" Text="Bottom" />
                        <controls:SpinnerTextBox
                            DisplayScale="100"
                            Max="0.95"
                            Min="0"
                            SpinAmount="0.01"
                            Suffix="%"
                            Value="{Binding CropBottom, Mode=TwoWay}" />
                    </DockPanel>
                </StackPanel>

                <!--  text  -->
                <StackPanel Classes="section" IsVisible="{Binding ShowText}">
                    <TextBlock Classes="section" Text="TEXT" />

                    <TextBox
                        x:Name="txtText"
                        Classes="field"
                        AcceptsReturn="True"
                        MaxHeight="120"
                        Text="{Binding Text, Mode=TwoWay}"
                        TextWrapping="Wrap"
                        PlaceholderText="Text" />

                    <TextBox
                        x:Name="txtFont"
                        Classes="field"
                        Text="{Binding FontFamily, Mode=TwoWay}"
                        PlaceholderText="Default font" />

                    <DockPanel Classes="row">
                        <TextBlock Classes="label" Text="Size" />
                        <controls:SpinnerTextBox
                            Max="2000"
                            Min="1"
                            SnapToWholeNumber="True"
                            SpinAmount="2"
                            Suffix="px"
                            Value="{Binding FontSize, Mode=TwoWay}" />
                    </DockPanel>

                    <TextBox
                        x:Name="txtColor"
                        Classes="field"
                        Text="{Binding TextColorHex, Mode=TwoWay}"
                        PlaceholderText="#AARRGGBB" />

                    <ComboBox x:Name="comboAlign" SelectedItem="{Binding TextAlign, Mode=TwoWay}" />
                </StackPanel>

                <!--  audio  -->
                <StackPanel Classes="section" IsVisible="{Binding ShowAudio}">
                    <TextBlock Classes="section" Text="AUDIO" />

                    <DockPanel Classes="row">
                        <TextBlock Classes="label" Text="Volume" />
                        <controls:SpinnerTextBox
                            DisplayScale="100"
                            Max="2"
                            Min="0"
                            SpinAmount="0.05"
                            Suffix="%"
                            Value="{Binding Volume, Mode=TwoWay}" />
                    </DockPanel>
                </StackPanel>

                <!--  transitions  -->
                <StackPanel Classes="section" IsVisible="{Binding ShowTransitions}">
                    <TextBlock Classes="section" Text="ENTRY" />
                    <ComboBox x:Name="comboEntryKind" SelectedItem="{Binding EntryKind, Mode=TwoWay}" />

                    <DockPanel Classes="row" IsVisible="{Binding ShowEntryOptions}">
                        <TextBlock Classes="label" Text="Length" />
                        <controls:SpinnerTextBox
                            Max="10000"
                            Min="0"
                            SnapToWholeNumber="True"
                            SpinAmount="50"
                            Suffix="ms"
                            Value="{Binding EntryDurationMs, Mode=TwoWay}" />
                    </DockPanel>

                    <ComboBox
                        x:Name="comboEntryEasing"
                        IsVisible="{Binding ShowEntryOptions}"
                        SelectedItem="{Binding EntryEasing, Mode=TwoWay}" />

                    <TextBlock
                        Classes="section"
                        Margin="0,6,0,0"
                        Text="EXIT" />
                    <ComboBox x:Name="comboExitKind" SelectedItem="{Binding ExitKind, Mode=TwoWay}" />

                    <DockPanel Classes="row" IsVisible="{Binding ShowExitOptions}">
                        <TextBlock Classes="label" Text="Length" />
                        <controls:SpinnerTextBox
                            Max="10000"
                            Min="0"
                            SnapToWholeNumber="True"
                            SpinAmount="50"
                            Suffix="ms"
                            Value="{Binding ExitDurationMs, Mode=TwoWay}" />
                    </DockPanel>

                    <ComboBox
                        x:Name="comboExitEasing"
                        IsVisible="{Binding ShowExitOptions}"
                        SelectedItem="{Binding ExitEasing, Mode=TwoWay}" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Panel>

</UserControl>
