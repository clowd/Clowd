<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Identity keys mirror what vpk generates by default (verified against a shipped
         Clowd.app) — the additions are the commented keys below (LSUIElement, NSServices)
         and the *UsageDescription strings. TCC KILLS a
         bundled process that touches the mic or a system-audio tap without them.
         {{VERSION}} / {{SHORT_VERSION}} are substituted by release.yml before vpk pack. -->
    <key>CFBundleName</key>
    <string>Clowd</string>
    <key>CFBundleIdentifier</key>
    <string>com.Caelan_Sayler.Clowd</string>
    <key>CFBundleVersion</key>
    <string>{{VERSION}}</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleSignature</key>
    <string>????</string>
    <key>CFBundleExecutable</key>
    <string>Clowd.Ui</string>
    <key>CFBundleIconFile</key>
    <string>clowd-default.icns</string>
    <key>CFBundleShortVersionString</key>
    <string>{{SHORT_VERSION}}</string>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <key>NSHighResolutionCapable</key>
    <true />
    <!-- Agent app: keeps Clowd out of the Dock's "recent applications" section after the
         runtime activation-policy toggle (MacDockIcon) hides the live icon. -->
    <key>LSUIElement</key>
    <true />
    <!-- Finder right-click → "Upload with Clowd". Delivered to the in-process provider
         registered by MacServicesProvider (NSMessage → uploadFiles:userData:error:);
         NSPortName must match CFBundleName. Living in the bundle's own plist means the
         entry is registered and unregistered with the app itself — no install hooks. -->
    <key>NSServices</key>
    <array>
      <dict>
        <key>NSMenuItem</key>
        <dict>
          <key>default</key>
          <string>Upload with Clowd</string>
        </dict>
        <key>NSMessage</key>
        <string>uploadFiles</string>
        <!-- marks the service as contextual (file selections), which macOS enables BY
             DEFAULT — without it the service arrives unchecked in System Settings →
             Keyboard → Services and never shows in any menu. -->
        <key>NSRequiredContext</key>
        <dict>
          <key>NSTextContent</key>
          <string>FilePath</string>
        </dict>
        <key>NSPortName</key>
        <string>Clowd</string>
        <key>NSSendFileTypes</key>
        <array>
          <string>public.item</string>
        </array>
      </dict>
    </array>
    <key>NSMicrophoneUsageDescription</key>
    <string>Clowd records your microphone when you enable it for a screen recording, and shows a live level meter so you can check the right device is selected.</string>
    <key>NSAudioCaptureUsageDescription</key>
    <string>Clowd captures system audio when you enable speaker sound for a screen recording, and shows a live level meter so you can check it is working.</string>
  </dict>
</plist>
