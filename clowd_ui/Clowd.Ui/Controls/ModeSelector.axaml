<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Clowd.UI.Controls">

    <!-- The selector adds this file to its own Styles collection (the CollapsingSegmentedBar
         pattern), so the banner's chrome travels with the control rather than with whichever page
         hosts it. Everything the control builds in code carries a "Mode…" class, and every color
         is settled here, against the theme's dynamic resources, so the banner follows the light /
         dark switch and the user's accent (AccentTheme) without the control holding a single
         brush.

         The two states the banner can be in are the selector's own :off pseudo-class (the active
         option is the enum member named Off) and its absence ("running"). Each layer below
         eases between them, so one switch of the class fades the whole banner over. -->
    <Styles.Resources>

        <!-- The glow's falloff, as a mask over an accent-filled square: GradientStop colors cannot
             take a DynamicResource, but a mask only reads alpha, so the accent stays a brush on
             the square and this one never has to change. 30% at the center, gone by the edge. -->
        <RadialGradientBrush x:Key="ClowdModeGlowMask"
                             Center="50%,50%"
                             GradientOrigin="50%,50%"
                             RadiusX="50%"
                             RadiusY="50%">
            <GradientStop Offset="0" Color="#4D000000" />
            <GradientStop Offset="0.45" Color="#1A000000" />
            <GradientStop Offset="1" Color="#00000000" />
        </RadialGradientBrush>

        <!-- The Off state's hatch, also as a mask (the ink is the hatch rectangle's Fill, a theme
             brush). A 13px tile carrying the lines x+y=0, 13 and 26 — 135° hairlines 9px apart
             (13/√2), the CSS repeating-linear-gradient(135deg, …) of the mockup. The two corner
             stubs are the neighbouring tiles' lines: a 1px pen spills half a pixel past the line,
             and without them the spill at each tile corner would be clipped away and the lines
             would show a notch every 13px. Source and destination are the same absolute rect, so
             the drawing is neither scaled nor re-fitted to its own bounds. -->
        <DrawingBrush x:Key="ClowdModeHatchMask"
                      TileMode="Tile"
                      Stretch="None"
                      SourceRect="0,0,13,13"
                      DestinationRect="0,0,13,13">
            <DrawingBrush.Drawing>
                <GeometryDrawing Geometry="M -1,1 L 1,-1 M -1,14 L 14,-1 M 12,14 L 14,12">
                    <GeometryDrawing.Pen>
                        <Pen Brush="Black" Thickness="1" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <!-- One chip of the group on the right. A RadioButton (so screen readers announce a
             radio group) templated from scratch rather than styled on top of Semi's, for the same
             reason the segmented bar's items are: the resting / hover / checked fills are then
             decided by this one Background property, not by whichever theme wins.

             The checked fill is the accent (SemiColorPrimary: a fill under white text, which is
             what the dark theme's darkened accent is made for); the checked *Off* chip is ink
             instead — the text color as a fill with the window's ground as its label — so
             switching a feature off never wears the accent. -->
        <ControlTheme x:Key="ClowdModeChip" TargetType="RadioButton">
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CornerRadius" Value="99" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource SemiColorText2}" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.25" Easing="CubicEaseOut" />
                    <BrushTransition Property="Foreground" Duration="0:0:0.25" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="PART_Chip"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover">
                <Setter Property="Foreground" Value="{DynamicResource SemiColorText0}" />
            </Style>
            <Style Selector="^:checked">
                <Setter Property="Background" Value="{DynamicResource SemiColorPrimary}" />
                <Setter Property="Foreground" Value="{DynamicResource SemiColorWhite}" />
            </Style>
            <Style Selector="^:checked.off">
                <Setter Property="Background" Value="{DynamicResource SemiColorText0}" />
                <Setter Property="Foreground" Value="{DynamicResource ApplicationBackgroundBrush}" />
            </Style>
        </ControlTheme>

    </Styles.Resources>

    <!-- ===== the banner's ground ===== -->

    <!-- Two looks, stacked: the off look always underneath, the running look over it as one
         layer (ModeOnLayer) that fades out to reveal it and back in to cover it. Only that one
         opacity moves; every brush inside either look is fixed. Easing the brushes one by one
         instead lets them drift apart mid-way — the card goes pale before the tint has gone —
         and the banner flashes toward white between the two states. -->
    <Style Selector="controls|ModeSelector Panel.ModeOnLayer">
        <Setter Property="Opacity" Value="1" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.45" Easing="CubicEaseInOut" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="controls|ModeSelector:off Panel.ModeOnLayer">
        <Setter Property="Opacity" Value="0" />
    </Style>

    <!-- Off: a neutral veil with the plain border, and the hatch over it. -->
    <Style Selector="controls|ModeSelector Border.ModeOffGround">
        <Setter Property="Background" Value="{DynamicResource SemiColorFill0}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SemiColorBorder}" />
    </Style>

    <!-- Off: the diagonal hairline hatch. Secondary ink through the tiled mask, kept faint — it
         is texture saying "inactive", not a pattern to look at. -->
    <Style Selector="controls|ModeSelector Rectangle.ModeHatch">
        <Setter Property="Fill" Value="{DynamicResource SemiColorText2}" />
        <Setter Property="OpacityMask" Value="{StaticResource ClowdModeHatchMask}" />
        <Setter Property="Opacity" Value="0.22" />
    </Style>

    <!-- Running: the GroupBox sections' surface and outline, laid over the window's own
         background so the layer is opaque (it must hide the off look completely) even if the
         section surface is not. The tint, glow and ring above do the coloring. -->
    <Style Selector="controls|ModeSelector Border.ModeOnGround">
        <Setter Property="Background" Value="{DynamicResource ApplicationBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HeaderedContentControlBorderBrush}" />
    </Style>
    <Style Selector="controls|ModeSelector Border.ModeCard">
        <Setter Property="Background" Value="{DynamicResource HeaderedContentControlBackground}" />
    </Style>

    <!-- Running: the accent at 12% over the card. A layer at an opacity rather than a
         translucent brush, because a DynamicResource brush cannot be given an opacity of its own
         here. A fill, so SemiColorPrimary. -->
    <Style Selector="controls|ModeSelector Border.ModeTint">
        <Setter Property="Background" Value="{DynamicResource SemiColorPrimary}" />
        <Setter Property="Opacity" Value="0.12" />
    </Style>

    <!-- Running: the soft accent glow behind the icon, top-left. -->
    <Style Selector="controls|ModeSelector Border.ModeGlow">
        <Setter Property="Background" Value="{DynamicResource SemiColorPrimary}" />
        <Setter Property="OpacityMask" Value="{StaticResource ClowdModeGlowMask}" />
    </Style>

    <!-- Running: the accent outline, at 55% over the card's own border. A line on a surface, so
         ClowdAccentTextBrush — the lifted accent in the dark theme, where the fill accent would
         sink into the ground. -->
    <Style Selector="controls|ModeSelector Border.ModeRing">
        <Setter Property="BorderBrush" Value="{DynamicResource ClowdAccentTextBrush}" />
        <Setter Property="Opacity" Value="0.55" />
    </Style>

    <!-- ===== the icon disc ===== -->

    <!-- Layered like the banner: the off disc (the card's surface and a hairline border)
         underneath, the running disc (an accent coin) over it, fading out to reveal it. -->
    <Style Selector="controls|ModeSelector Border.ModeIconDiscOff">
        <Setter Property="Background" Value="{DynamicResource HeaderedContentControlBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SemiColorBorder}" />
    </Style>
    <Style Selector="controls|ModeSelector Border.ModeIconDiscOn">
        <Setter Property="Background" Value="{DynamicResource SemiColorPrimary}" />
        <Setter Property="Opacity" Value="1" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.45" Easing="CubicEaseInOut" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="controls|ModeSelector:off Border.ModeIconDiscOn">
        <Setter Property="Opacity" Value="0" />
    </Style>

    <!-- The glyph's colors follow the glyph on the flip's visible face (the "off" class the
         control sets on the glyph cell when it turns the Off glyph over), not the banner's :off,
         which changes at the click: the outgoing glyph keeps its colors while it turns away. No
         transition — the swap happens edge-on, where it can't be seen. -->
    <Style Selector="controls|ModeSelector Path.ModeIconGlyph">
        <Setter Property="Fill" Value="{DynamicResource SemiColorWhite}" />
    </Style>
    <Style Selector="controls|ModeSelector Grid.ModeGlyphs.off Path.ModeIconGlyph">
        <Setter Property="Fill" Value="{DynamicResource SemiColorText2}" />
    </Style>

    <!-- the stand-in for an option without a usable icon: its title's initial -->
    <Style Selector="controls|ModeSelector TextBlock.ModeIconInitial">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource SemiColorWhite}" />
    </Style>
    <Style Selector="controls|ModeSelector Grid.ModeGlyphs.off TextBlock.ModeIconInitial">
        <Setter Property="Foreground" Value="{DynamicResource SemiColorText2}" />
    </Style>

    <!-- ===== the text block ===== -->

    <Style Selector="controls|ModeSelector TextBlock.ModeEyebrow">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LetterSpacing" Value="0.8" />
        <Setter Property="Foreground" Value="{DynamicResource SemiColorText2}" />
        <Setter Property="Margin" Value="0,0,0,3" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="controls|ModeSelector TextBlock.ModeTitle">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource SemiColorText0}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="controls|ModeSelector TextBlock.ModeCaption">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource SemiColorText2}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- ===== the chip group ===== -->

    <!-- The pill the chips sit in: a 1px outline over a translucent wash of the card surface
         (the wash is its own layer, faded by opacity, for the same reason as the tint above). -->
    <Style Selector="controls|ModeSelector Border.ModeChipWash">
        <Setter Property="Background" Value="{DynamicResource HeaderedContentControlBackground}" />
        <Setter Property="Opacity" Value="0.7" />
    </Style>
    <Style Selector="controls|ModeSelector Border.ModeChipFrame">
        <Setter Property="BorderBrush" Value="{DynamicResource SemiColorBorder}" />
    </Style>

    <Style Selector="controls|ModeSelector RadioButton.ModeChip">
        <Setter Property="Theme" Value="{StaticResource ClowdModeChip}" />
        <!-- A style rather than a theme setter: a FocusAdorner set app-wide by a style would
             outrank the theme. Drawn just outside the pill (the group's 4px padding leaves room),
             in the theme's focus-ring color. -->
        <Setter Property="FocusAdorner">
            <FocusAdornerTemplate>
                <Border Margin="-2"
                        BorderThickness="2"
                        CornerRadius="99"
                        BorderBrush="{DynamicResource AdornerLayerBorderBrush}" />
            </FocusAdornerTemplate>
        </Setter>
    </Style>

</Styles>
