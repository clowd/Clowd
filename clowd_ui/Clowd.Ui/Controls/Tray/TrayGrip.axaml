<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="using:System"
                    xmlns:tray="using:Clowd.UI.Controls.Tray">

    <!-- The rotate button (spec §3): fills its cell of the grip (see below), no fill of its own, a dimmed
         glyph that comes up to full strength on hover over a 14 % white veil covering the whole cell — the
         same veil, on the same shape, as the dot handle's, so the two read as a matched pair. Its own
         ControlTheme rather than styles inside the grip's template, because the app's default Button look
         (fill, border, pressed transform) has to be replaced wholesale, not patched. The glyph is drawn at
         RotateGlyphSize with the 2.4-unit stroke the glyph data already carries. -->
    <ControlTheme x:Key="TrayGripRotateTheme" TargetType="Button">
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="{x:Static tray:TrayTokens.GripCorner}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Opacity" Value="0.5" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="{x:Static tray:TrayTokens.FillTransition}" />
            </Transitions>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <!-- transparent, but present: without a Background the cell is not hit-testable
                         and only the glyph's own ink would take the click -->
                    <Border Name="_bg"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}" />
                    <Border Name="_hover"
                            Background="{x:Static tray:TrayTokens.WhiteVeil14}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Opacity="0">
                        <Border.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity" Duration="{x:Static tray:TrayTokens.FillTransition}" />
                            </Transitions>
                        </Border.Transitions>
                    </Border>
                    <tray:TrayGlyphIcon Width="{x:Static tray:TrayTokens.RotateGlyphSize}"
                                        Height="{x:Static tray:TrayTokens.RotateGlyphSize}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="{x:Static tray:TrayTokens.FgBrush}"
                                        Glyph="{x:Static tray:TrayGlyphs.Rotate}" />
                </Panel>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:pointerover /template/ Border#_hover">
            <Setter Property="Opacity" Value="1" />
        </Style>
    </ControlTheme>

    <!-- The grip (spec §3, revised). Two EQUAL cells: the rotate button and the dot handle, each with the
         same hover veil on the same rounded shape, so the pair reads as two halves of one affordance
         rather than a grid with a small button tucked beside it.

         Horizontal: a GripLength-wide column at the row height, the cells stacked (rotate above handle).
         Vertical: a GripLength-tall row spanning the tray's inner width, the cells side by side (rotate
         left of handle). The dot grid turns with the strip (4x3 -> 3x4); nothing is rebuilt on a
         rotation, only restyled — the UniformGrid swaps its Rows/Columns, which ARE styleable, unlike a
         Grid's definitions.

         Rotate comes FIRST in both axes on purpose: the chassis anchors a rotation at the window's
         top-left, so the top-left cell is the one spot that is still under the pointer after the strip
         has turned, and a second click turns it straight back. -->
    <ControlTheme x:Key="{x:Type tray:TrayGrip}" TargetType="tray:TrayGrip">
        <Setter Property="Width" Value="{x:Static tray:TrayTokens.GripLength}" />
        <Setter Property="Height" Value="{x:Static tray:TrayTokens.ButtonHeight}" />
        <!-- the move affordance. SizeAll is the closest standard cursor to CSS `grab`; it is a
             Windows-only nicety, since a no-activate window never gets cursor rects honoured on macOS. -->
        <Setter Property="Cursor" Value="SizeAll" />
        <Setter Property="Template">
            <ControlTemplate>
                <UniformGrid Name="_cells" Rows="2" Columns="1">
                    <!-- first, so it is the top (row) / left (column) cell: see the note above -->
                    <Button Name="PART_Rotate"
                            AutomationProperties.Name="Rotate toolbar"
                            Theme="{StaticResource TrayGripRotateTheme}"
                            ToolTip.Tip="Rotate toolbar" />
                    <!-- Background=Transparent is load-bearing: the cell is most of the target the user
                         actually aims at, and an unpainted Border does not hit-test. -->
                    <Border Name="_handle"
                            Background="Transparent"
                            CornerRadius="{x:Static tray:TrayTokens.GripCorner}">
                        <Panel>
                            <Border Name="_handleHover"
                                    Background="{x:Static tray:TrayTokens.WhiteVeil14}"
                                    CornerRadius="{x:Static tray:TrayTokens.GripCorner}"
                                    Opacity="0"
                                    IsHitTestVisible="False">
                                <Border.Transitions>
                                    <Transitions>
                                        <DoubleTransition Property="Opacity" Duration="{x:Static tray:TrayTokens.FillTransition}" />
                                    </Transitions>
                                </Border.Transitions>
                            </Border>
                            <tray:TrayGripDots Name="_dots"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Orientation="{TemplateBinding Orientation}" />
                        </Panel>
                    </Border>
                </UniformGrid>
            </ControlTemplate>
        </Setter>

        <!-- The dots are quiet until the user is either hovering the handle cell or already moving the
             strip. The dragging case is not the same as hovering: the pointer is routinely dragged clean
             off the grip, and the dots going dim mid-move would read as the drag having been dropped. -->
        <Style Selector="^ /template/ tray|TrayGripDots#_dots">
            <Setter Property="Opacity" Value="0.45" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="{x:Static tray:TrayTokens.FillTransition}" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^ /template/ Border#_handle:pointerover tray|TrayGripDots#_dots">
            <Setter Property="Opacity" Value="0.85" />
        </Style>
        <Style Selector="^ /template/ Border#_handle:pointerover Border#_handleHover">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^[IsDragging=True] /template/ tray|TrayGripDots#_dots">
            <Setter Property="Opacity" Value="0.85" />
        </Style>

        <!-- Vertical strip: the grip lies down. GripLength high, full width, dots 3x4, rotate to the
             left of the handle. -->
        <Style Selector="^[Orientation=Vertical]">
            <Setter Property="Width" Value="{x:Static sys:Double.NaN}" />
            <Setter Property="Height" Value="{x:Static tray:TrayTokens.GripLength}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="^[Orientation=Vertical] /template/ UniformGrid#_cells">
            <Setter Property="Rows" Value="1" />
            <Setter Property="Columns" Value="2" />
        </Style>

        <!-- Spanning: the grip runs the tray's full cross extent instead of matching one row — rotate
             a GripLength square in the corner, the handle filling the rest. A different template
             rather than restyled cells, because the two cells are no longer equal; it keeps the same
             part names and handle children, so OnApplyTemplate and the dot/veil styles above still
             find them. The dot grid lies along the handle's long side (2 across, 7 along) rather than
             along the strip, so its own Orientation is set here instead of bound to the strip's. -->
        <Style Selector="^[Layout=Spanning]">
            <Setter Property="Height" Value="{x:Static sys:Double.NaN}" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Template">
                <ControlTemplate>
                    <DockPanel Name="_cells">
                        <Button Name="PART_Rotate"
                                AutomationProperties.Name="Rotate toolbar"
                                Theme="{StaticResource TrayGripRotateTheme}"
                                ToolTip.Tip="Rotate toolbar" />
                        <Border Name="_handle"
                                Background="Transparent"
                                CornerRadius="{x:Static tray:TrayTokens.GripCorner}">
                            <Panel>
                                <Border Name="_handleHover"
                                        Background="{x:Static tray:TrayTokens.WhiteVeil14}"
                                        CornerRadius="{x:Static tray:TrayTokens.GripCorner}"
                                        Opacity="0"
                                        IsHitTestVisible="False">
                                    <Border.Transitions>
                                        <Transitions>
                                            <DoubleTransition Property="Opacity" Duration="{x:Static tray:TrayTokens.FillTransition}" />
                                        </Transitions>
                                    </Border.Transitions>
                                </Border>
                                <tray:TrayGripDots Name="_dots"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                            </Panel>
                        </Border>
                    </DockPanel>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="^[Layout=Spanning] /template/ Button#PART_Rotate">
            <Setter Property="DockPanel.Dock" Value="Top" />
            <Setter Property="Height" Value="{x:Static tray:TrayTokens.GripLength}" />
        </Style>
        <Style Selector="^[Layout=Spanning] /template/ tray|TrayGripDots#_dots">
            <Setter Property="Orientation" Value="Vertical" />
            <Setter Property="LongCount" Value="7" />
            <Setter Property="ShortCount" Value="2" />
        </Style>

        <!-- Spanning in a vertical strip: the same grip laid along the top, GripLength tall and the
             tray's full width. Declared after both styles it combines so its setters win. -->
        <Style Selector="^[Layout=Spanning][Orientation=Vertical]">
            <Setter Property="Height" Value="{x:Static tray:TrayTokens.GripLength}" />
        </Style>
        <Style Selector="^[Layout=Spanning][Orientation=Vertical] /template/ Button#PART_Rotate">
            <Setter Property="DockPanel.Dock" Value="Left" />
            <Setter Property="Height" Value="{x:Static sys:Double.NaN}" />
            <Setter Property="Width" Value="{x:Static tray:TrayTokens.GripLength}" />
        </Style>
        <Style Selector="^[Layout=Spanning][Orientation=Vertical] /template/ tray|TrayGripDots#_dots">
            <Setter Property="Orientation" Value="Horizontal" />
        </Style>
    </ControlTheme>

</ResourceDictionary>
