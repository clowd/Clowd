<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Clowd.UI.Controls"
        x:Class="Clowd.UI.BorderWindow"
        Title="Clowd Recording Frame"
        WindowDecorations="None"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        CanResize="False"
        ShowActivated="False"
        Focusable="False">

    <!-- IsHitTestVisible=False is the Avalonia-level pass-through; the real click-through is the
         WS_EX_TRANSPARENT ex-style + WM_NCHITTEST->HTTRANSPARENT hook applied in code-behind. -->
    <Grid IsHitTestVisible="False">

        <!-- 2px accent frame with a 1px white inner line. The window is positioned/sized so both
             lines (plus >=1 physical px of slack) sit entirely OUTSIDE the recorded region. Edges
             without enough space outside a macOS screen are disabled in code-behind. -->
        <Border Name="AccentBorder" BorderThickness="2">
            <Border Name="InnerBorder" BorderThickness="1" BorderBrush="White" Background="Transparent" />
        </Border>

        <!-- 48pt overlay text ("WAIT…"/"START"): white glyphs with a real vector accent outline.
             Stroke is set to the accent color in code-behind. -->
        <controls:OutlinedTextBlock Name="OverlayText" IsVisible="False"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    FontSize="48" FontWeight="Black"
                                    Fill="White" StrokeThickness="6" LetterSpacing="4" />

    </Grid>

</Window>
