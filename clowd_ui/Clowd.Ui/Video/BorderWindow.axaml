<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Clowd.UI.Controls"
        x:Class="Clowd.UI.BorderWindow"
        Title="Clowd Recording Frame"
        WindowDecorations="None"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        CanResize="False"
        ShowActivated="False"
        Focusable="False">

    <!-- IsHitTestVisible=False is the Avalonia-level pass-through; the real click-through is the
         WS_EX_TRANSPARENT ex-style + WM_NCHITTEST->HTTRANSPARENT hook applied in code-behind. -->
    <Grid IsHitTestVisible="False">

        <!-- 3px accent frame with a 2px white inner line. The window is positioned/sized so both
             lines (plus >=1 physical px of slack) sit entirely OUTSIDE the recorded region.
             Thicknesses are set per-edge in code-behind from AccentLogicalWidth/InnerLogicalWidth,
             which always overwrite the values below: edges flush with a monitor edge are
             suppressed entirely (issue #56). -->
        <Border Name="AccentBorder" BorderThickness="3">
            <Border Name="InnerBorder" BorderThickness="2" BorderBrush="White" Background="Transparent" />
        </Border>

        <!-- 48pt overlay text ("WAIT…"/"PRESS START"): white glyphs with a real vector accent
             outline. Stroke is set to the accent color in code-behind. The Viewbox is DownOnly:
             48pt is the cap, but a small capture region scales the text (outline and all) down
             to fit inside the frame instead of clipping it. -->
        <Viewbox Name="OverlayBox" IsVisible="False" Stretch="Uniform" StretchDirection="DownOnly" Margin="10"
                 HorizontalAlignment="Center" VerticalAlignment="Center">
            <controls:OutlinedTextBlock Name="OverlayText"
                                        FontSize="48" FontWeight="Black"
                                        Fill="White" StrokeThickness="6" LetterSpacing="4" />
        </Viewbox>

        <!-- The struck-through eye, shown while the region is obscured for the people watching it
             (SetHiddenIndicator). Like the text above it renders INSIDE the region, which is only
             safe for exactly this state: what it marks is that the viewers are NOT seeing these
             pixels. Plain white, no accent outline — unlike the overlay text, which needs one to
             stay legible over whatever the region happens to contain, this glyph sits on an
             obscured region and is read as a shape rather than as letters. Scales down with the
             region rather than being clipped by a small one, and never takes a click: the whole
             Grid is IsHitTestVisible="False" and the window is click-through natively besides. -->
        <Viewbox Name="HiddenBox" IsVisible="False" Stretch="Uniform" StretchDirection="DownOnly" Margin="10"
                 Opacity="0.4" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Path Name="HiddenIcon"
                  Data="{StaticResource IconEyeOff}"
                  Width="128" Height="128" Stretch="Uniform"
                  Fill="White" />
        </Viewbox>

    </Grid>

</Window>
