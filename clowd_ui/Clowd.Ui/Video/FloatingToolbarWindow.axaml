<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Clowd.UI.Controls"
        xmlns:ui="using:Clowd"
        x:Class="Clowd.UI.FloatingToolbarWindow"
        Title="Clowd Recording Toolbar"
        WindowDecorations="None"
        SizeToContent="WidthAndHeight"
        Topmost="True"
        ShowInTaskbar="False"
        CanResize="False"
        ShowActivated="False"
        Background="Transparent"
        TransparencyLevelHint="Transparent">

    <!-- Styled to match the capture overlay's button panel (clowd_capture
         ui/components/panel/layout.rs + ui/gpu/panel.rs): buttons carry their own fill
         (accent / #373737) on a dark-gray panel backdrop (IdealBackgroundBrush, the same
         #373737 the overlay uses for its rects — matches the WPF FloatingButtonWindow
         backdrop), so the 3px gaps read as panel rather than screen. Gap pattern mirrors
         layout.rs (area→3→btn0→3→btn1, rest contiguous): 3px after the drag handle and
         3px after the primary button. Per-button IconSize values scale each glyph by its
         declared canvas ratio inside the fixed 26px icon slot, reproducing the overlay's
         canvas-fitted SVG rendering. OUTPUT (GIF) and DRAW are intentionally absent —
         GIF encoding lives on the Recents page and Live Draw was removed from
         clowd-rust. The primary and trailing buttons are moded by the code-behind:
         WAIT…/START -> PAUSE/RESUME once recording, CANCEL -> FINISH once recording
         (a rolling recording can be stopped but not discarded from the strip).
         MIC/SPK/CAM each get a device picker: the tile toggles the source, and a small pill
         floating just off the strip beside it opens the list of devices, so switching
         microphone or camera never costs a trip to the settings window. A pill only appears
         where there is more than one device to choose between (UpdateDevicePills) — with one
         camera, or one microphone that "default" already points at, the tile's own click is
         the whole interaction. The pills live in
         PillLayer rather than in the strip — the tile grid is the overlay's look, and a rail
         welded into it would read as another kind of button — and the lane they float in is
         reserved by RootBorder's margin, which the code-behind moves to whichever side the
         strip's placement left free (below a horizontal row, outboard of a vertical one).
         One markup, two profiles (FloatingToolbarProfile): everything below is the recording
         strip, and a share-region session collapses all of it but DRAG, BLUR and CANCEL — see
         the constructor for why the two halves are built separately rather than merely hidden. -->
    <Panel Name="RootPanel">
        <Border Name="RootBorder"
                Margin="0,0,0,16"
                Background="{x:Static ui:AppStyles.IdealBackgroundBrush}">
            <StackPanel Name="MainPanel" Orientation="Horizontal">

                <!-- drag handle: click rotates the toolbar, drag past 5px moves it (state machine in
                     code-behind; pointer events are wired as tunnel handlers there because Button's
                     class handler marks bubbling PointerPressed as handled). Becomes a zeroed
                     timer the moment recording starts and then carries the FPS/timer text the
                     statuses bring, or PAUSED while paused. The move glyph becomes
                     the Clowd mark once recording starts (UpdateDragIcon) — the strip is then a
                     recording indicator far more often than something you reposition — and comes
                     back while the pointer is over it, so the affordance is still there when wanted. -->
                <controls:CaptureToolButton Name="BtnDrag"
                                            Cursor="SizeAll"
                                            IconPath="{StaticResource IconToolNone}"
                                            IsDragHandle="True"
                                            Primary="True"
                                            ShowHover="False"
                                            Text="DRAG ME"
                                            ToolTip.Tip="Click to Rotate, Drag to Move" />

                <Rectangle Width="3" Height="3" />

                <!-- WAIT… -> START (page swaps the text via SetPrimaryText once obs-express is
                     initialized) -> PAUSE/RESUME while recording (SetRecordingState/SetPausedState).
                     The accent fill, the pulse and the button being pressable all arrive together,
                     the moment the recorder is up: during WAIT a press does nothing (the page gates
                     on _initialized), so the tile stays a plain panel-gray one rather than an accent
                     tile pulsing an invitation it cannot honor. UpdatePrimaryState owns all three
                     and runs in the constructor, which is why no initial state is declared here. -->
                <controls:CaptureToolButton Name="BtnStart"
                                            Click="StartButtonClicked"
                                            IconPath="{StaticResource IconPlay}"
                                            IconSize="16"
                                            Text="WAIT…" />

                <!-- ShareRegion profile only (hidden for a recording, which has nothing to
                     obscure): toggles the helper's blur over the mirrored region. It is slotted
                     into the primary tile's own cell — after START, before the 3px gap that
                     follows it — so neither strip pays for the other: the recording strip keeps
                     its DRAG|3|START|3|… rhythm untouched, and once the share profile collapses
                     START and the four middle tiles the same markup reads DRAG|3|BLUR|3|CANCEL.
                     SourceToggle because this is an on/off source in exactly the sense MIC/SPK
                     are — it buys the dimmed-off glyph and the red/green light, which is the
                     only thing that reads "the meeting is seeing through this" from across the
                     room. The tile can also be retired outright (SetBlurAvailable) when the
                     helper reports its GPU effect failed to build. -->
                <controls:CaptureToolButton Name="BtnBlur"
                                            Click="BlurClicked"
                                            IconPath="{StaticResource IconEffectNone}"
                                            IconPathAlternate="{StaticResource IconEffectBlur}"
                                            IsVisible="False"
                                            SourceToggle="True"
                                            Text="BLUR" />

                <Rectangle Width="3" Height="3" />

                <!-- ShowAlternateIcon (enabled glyph) tracks the capture toggle; the Overlay slot
                     hosts the live audio level bar (code-behind). SourceToggle adds the two things
                     that make off/on read from a distance — a dimmed off glyph and a red/green
                     light — since the two glyphs differ only by a slash. -->
                <controls:CaptureToolButton Name="BtnMic"
                                            Click="MicClicked"
                                            SourceToggle="True"
                                            IconPath="{StaticResource IconMicrophoneDisabled}"
                                            IconPathAlternate="{StaticResource IconMicrophoneEnabled}"
                                            Text="MIC" />

                <controls:CaptureToolButton Name="BtnSpeaker"
                                            Click="SpeakerClicked"
                                            SourceToggle="True"
                                            IconPath="{StaticResource IconSpeakerDisabled}"
                                            IconPathAlternate="{StaticResource IconSpeakerEnabled}"
                                            IconSize="21.7"
                                            Text="SPK" />

                <!-- CAM: a pipeline element, not a runtime mute like MIC/SPK — the recorder can only
                     add or drop the webcam source while it is still waiting, so the code-behind
                     disables this button once recording starts. No level meter (nothing to meter). -->
                <controls:CaptureToolButton Name="BtnWebcam"
                                            Click="WebcamClicked"
                                            SourceToggle="True"
                                            IconPath="{StaticResource IconWebcamDisabled}"
                                            IconPathAlternate="{StaticResource IconWebcamEnabled}"
                                            Text="CAM" />

                <controls:CaptureToolButton Name="BtnSettings"
                                            Click="SettingsButtonClicked"
                                            IconPath="{StaticResource IconSettings}"
                                            IconSize="21.7"
                                            Text="OPTIONS" />

                <!-- CANCEL until recording starts; FINISH (stop and save) afterwards -->
                <controls:CaptureToolButton Name="BtnCancel"
                                            Click="CancelButtonClicked"
                                            IconPath="{StaticResource IconClose}"
                                            IconSize="18"
                                            Text="CANCEL" />

            </StackPanel>
        </Border>

        <!-- The pills are positioned against their tiles at layout time (PlacePill) rather than
             laid out in a panel of their own: they have to line up with tiles that live inside a
             different container, and the strip rotates underneath them. Nothing else is in the
             canvas, so it never blocks a click on the strip. -->
        <Canvas Name="PillLayer">
            <controls:CaptureToolPill Name="BtnMicDevice"
                                      Click="MicDeviceClicked"
                                      ToolTip.Tip="Choose the microphone to record" />

            <!-- also never shown on macOS, where ScreenCaptureKit records the whole system mix and
                 there is no output device to pick (same reason SpeakerDeviceId is [HiddenOnMacOS]). -->
            <controls:CaptureToolPill Name="BtnSpeakerDevice"
                                      Click="SpeakerDeviceClicked"
                                      ToolTip.Tip="Choose the speakers to record" />

            <controls:CaptureToolPill Name="BtnWebcamDevice"
                                      Click="WebcamDeviceClicked"
                                      ToolTip.Tip="Choose the camera to record" />
        </Canvas>
    </Panel>

</Window>
