<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Clowd.Ui.Views.Dialogs.MessageDialog"
        Title="Clowd"
        Icon="/Assets/clowd.ico"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">
    <Grid Margin="22" RowDefinitions="Auto,Auto,Auto">
        <TextBlock Grid.Row="0"
                   x:Name="TitleText"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="0,0,0,10" />
        <TextBlock Grid.Row="1"
                   x:Name="BodyText"
                   TextWrapping="Wrap"
                   FontSize="13"
                   Margin="0,0,0,18" />
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10">
            <Button Content="OK" Click="OnOk" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
