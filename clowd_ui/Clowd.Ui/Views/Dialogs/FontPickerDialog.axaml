<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Clowd.Ui.Views.Dialogs.FontPickerDialog"
        Title="Choose font"
        Icon="/Assets/clowd.ico"
        Width="540" Height="520"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        ShowInTaskbar="False">
    <Grid Margin="16" RowDefinitions="Auto,*,Auto,Auto">

        <TextBox Grid.Row="0"
                 x:Name="FilterBox"
                 PlaceholderText="Filter families..."
                 Margin="0,0,0,8"
                 TextChanged="OnFilterChanged" />

        <ListBox Grid.Row="1"
                 x:Name="FamilyList"
                 SelectionChanged="OnFamilySelected">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}"
                               FontFamily="{Binding}"
                               FontSize="16"
                               Padding="4,2" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="2"
                Margin="0,12,0,0"
                BorderBrush="{DynamicResource SystemBaseLowColor}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="12,10"
                MinHeight="72">
            <TextBlock x:Name="PreviewText"
                       Text="The quick brown fox jumps over the lazy dog"
                       FontSize="20"
                       TextWrapping="Wrap" />
        </Border>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,12,0,0">
            <Button Content="OK" Click="OnOk" IsDefault="True" MinWidth="84" />
            <Button Content="Cancel" Click="OnCancel" IsCancel="True" MinWidth="84" />
        </StackPanel>
    </Grid>
</Window>
