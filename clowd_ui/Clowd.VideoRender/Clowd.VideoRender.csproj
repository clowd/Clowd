<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>Clowd.VideoRender</AssemblyName>
    <RootNamespace>Clowd.VideoRender</RootNamespace>
    <!-- The tool speaks a fixed ASCII line protocol on stdout and parses invariant JSON; no
         culture data is involved. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>$(NoWarn);CA2007</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Clowd.VideoSDK\Clowd.VideoSDK.csproj" />
  </ItemGroup>
</Project>
