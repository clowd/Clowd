[
  {
    "label": "Debug .NET",
    "adapter": "netcoredbg",
    "request": "launch",
    "program": "${ZED_WORKTREE_ROOT}/ui/Prisc.Ui/bin/Debug/net10.0/Prisc.Ui.dll",
    "cwd": "${ZED_WORKTREE_ROOT}/ui/Prisc.Ui/bin/Debug/net10.0",
    "build": {
      "command": "dotnet",
      "args": [
        "build",
        "${ZED_WORKTREE_ROOT}/ui/Prisc.Ui/Prisc.Ui.csproj",
        "-p:Configuration=Debug",
      ],
    },
  },
  {
    "label": "Debug prisc_capture",
    "adapter": "CodeLLDB",
    "request": "launch",
    "args": [
      "--accent-color",
      "#3B97D2",
      "--tips-mode",
      "hints",
      "--peek-threshold",
      "0.8",
    ],
    "build": {
      "command": "cargo",
      "args": ["build", "-p", "prisc_capture"],
    },
  },
]
