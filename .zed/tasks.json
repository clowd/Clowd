[
  {
    "label": "Build Prisc.Ui (Debug)",
    "command": "dotnet",
    "args": [
      "build",
      "${ZED_WORKTREE_ROOT}/ui/Prisc.Ui/Prisc.Ui.csproj",
      "-p:Configuration=Debug",
    ],
  },
  {
    "label": "Build prisc_capture (Debug)",
    "command": "cargo",
    "args": ["build", "-p", "prisc_capture"],
  },
  {
    "label": "Rebuild All",
    "command": "dotnet",
    "args": [
      "build",
      "${ZED_WORKTREE_ROOT}/ui/Prisc.Ui/Prisc.Ui.csproj",
      "-p:Configuration=Debug",
      ";",
      "cargo",
      "build",
      "-p",
      "prisc_capture",
    ],
  },
]
