[
  {
    "label": "Build Clowd.Ui (Debug)",
    "command": "dotnet",
    "args": [
      "build",
      "${ZED_WORKTREE_ROOT}/clowd_ui/Clowd.Ui/Clowd.Ui.csproj",
      "-p:Configuration=Debug",
    ],
  },
  {
    "label": "Build clowd_capture_wgpu (Debug)",
    "command": "cargo",
    "args": ["build", "-p", "clowd_capture_wgpu"],
  },
  {
    "label": "Rebuild All",
    "command": "dotnet",
    "args": [
      "build",
      "${ZED_WORKTREE_ROOT}/clowd_ui/Clowd.Ui/Clowd.Ui.csproj",
      "-p:Configuration=Debug",
      ";",
      "cargo",
      "build",
      "-p",
      "clowd_capture_wgpu",
    ],
  },
]
