                            </LinearGradientBrush>
                        </GeometryDrawing.Brush>
                    </GeometryDrawing>
                    <GeometryDrawing Geometry="F1 M9.83,26.866l-4.33-2.5 C5.022,24.09,4.858,23.478,5.134,23l10-17.321c0.276-0.478,0.888-0.642,1.366-0.366l4.33,2.5c0.478,0.276,0.642,0.888,0.366,1.366 l-10,17.321C10.92,26.978,10.309,27.142,9.83,26.866z">
                        <GeometryDrawing.Brush>
                            <LinearGradientBrush StartPoint="7.708,25.519" EndPoint="18.677,6.52">
                                <GradientStop Offset="0.174" Color="#D9D9D9" />
