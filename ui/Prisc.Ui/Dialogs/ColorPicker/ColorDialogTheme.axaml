                    <GeometryDrawing Geometry="F1 M20.83,7.813l-4.33-2.5 c-0.158-0.091-0.329-0.134-0.499-0.134c-0.346,0-0.682,0.179-0.867,0.5L5.134,23c-0.276,0.478-0.112,1.09,0.366,1.366l4.33,2.5 C9.988,26.957,10.16,27,10.329,27c0.346,0,0.682-0.179,0.867-0.5l10-17.32C21.472,8.701,21.309,8.089,20.83,7.813z M20.98,9.054 l-10,17.32c-0.134,0.231-0.383,0.375-0.65,0.375c-0.131,0-0.26-0.035-0.374-0.101l-4.33-2.5c-0.174-0.1-0.298-0.262-0.349-0.455 C5.224,23.5,5.25,23.298,5.351,23.125l10-17.32c0.134-0.231,0.383-0.375,0.651-0.375c0.131,0,0.26,0.035,0.374,0.101l4.33,2.5 C21.063,8.237,21.187,8.696,20.98,9.054z">
                        <GeometryDrawing.Brush>
                            <LinearGradientBrush StartPoint="13.165,5.179" EndPoint="13.165,27">
                                <GradientStop Offset="0" Color="#05000000" />
                                <GradientStop Offset="1" Color="#26000000" />
                            </LinearGradientBrush>
                        </GeometryDrawing.Brush>
                    </GeometryDrawing>
                    <GeometryDrawing Geometry="F1 M14,7.644L7,19.768v5.464l2.83,1.634 c0.478,0.276,1.09,0.112,1.366-0.366L14,21.644V7.644z">
                        <GeometryDrawing.Brush>
                            <LinearGradientBrush StartPoint="11.686,17.322" EndPoint="14.044,17.322">
                                <GradientStop Offset="0" Color="#4C000000" />
                                <GradientStop Offset="1" Color="#00000000" />
                            </LinearGradientBrush>
                        </GeometryDrawing.Brush>
                    </GeometryDrawing>
                    <GeometryDrawing Geometry="F1 M11,27H6c-0.552,0-1-0.448-1-1V6 c0-0.552,0.448-1,1-1h5c0.552,0,1,0.448,1,1v20C12,26.552,11.552,27,11,27z">
                        <GeometryDrawing.Brush>
                            <LinearGradientBrush StartPoint="8.5,26.891" EndPoint="8.5,4.954">
                                <GradientStop Offset="0.174" Color="#D9D9D9" />
                                <GradientStop Offset="0.187" Color="#D90000" />
                                <GradientStop Offset="0.443" Color="#D90000" />
                                <GradientStop Offset="0.456" Color="#FF3333" />
                                <GradientStop Offset="0.717" Color="#FF3333" />
                                <GradientStop Offset="0.73" Color="#FF7D7D" />
                            </LinearGradientBrush>
                        </GeometryDrawing.Brush>
                    </GeometryDrawing>
                    <GeometryDrawing Geometry="F1 M11,5H6C5.448,5,5,5.448,5,6v20 c0,0.552,0.448,1,1,1h5c0.552,0,1-0.448,1-1V6C12,5.448,11.552,5,11,5z M11.75,26c0,0.414-0.336,0.75-0.75,0.75H6 c-0.414,0-0.75-0.336-0.75-0.75V6c0-0.414,0.336-0.75,0.75-0.75h5c0.414,0,0.75,0.336,0.75,0.75V26z">
                        <GeometryDrawing.Brush>
                            <LinearGradientBrush StartPoint="8.5,5" EndPoint="8.5,27">
                                <GradientStop Offset="0" Color="#05000000" />
                                <GradientStop Offset="1" Color="#26000000" />
                            </LinearGradientBrush>
                        </GeometryDrawing.Brush>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage>

            <!--  The Oklch tab: a thumbnail of its Lightness chart at L 0.45 over the whole hue
                  circle (hue across, the most chroma sRGB has at each hue as the skyline), with the
                  skyline's lowest point a little below halfway so the valleys stay shallow. The
                  shape is generated from the gamut, not drawn, with a point every 3 degrees of hue.
                  The fill is not the chart's: five of the Simple icon's colors as five equal strips,
                  red to purple (its orange left out, too close to the yellow at this size), as a
                  gradient with paired stops so each edge is hard; the gamut's own colors read
                  muddy here.  -->
            <DrawingImage x:Key="ColorDialogRailIconOklch">
                <DrawingGroup>
                    <GeometryDrawing Brush="Transparent" Geometry="M0,0 h32 v32 h-32 Z" />
                    <GeometryDrawing Geometry="F1 M3,11.26 L3.22,11.31 3.43,11.35 3.65,11.38 3.87,11.39 4.08,11.38 4.30,11.36 4.52,11.33 4.73,11.28 4.95,11.21 5.17,11.36 5.38,12.07 5.60,12.66 5.82,13.15 6.03,13.57 6.25,13.92 6.47,14.22 6.68,14.48 6.90,14.70 7.12,14.90 7.33,15.06 7.55,15.21 7.77,15.33 7.98,15.43 8.20,15.52 8.42,15.59 8.63,15.64 8.85,15.69 9.07,15.72 9.28,15.73 9.50,15.74 9.72,15.73 9.93,15.70 10.15,15.67 10.37,15.62 10.58,15.56 10.80,15.48 11.02,15.39 11.23,15.28 11.45,15.15 11.67,15.00 11.88,14.82 12.10,14.62 12.32,14.38 12.53,14.10 12.75,13.78 12.97,13.41 13.18,12.96 13.40,13.07 13.62,13.67 13.83,14.15 14.05,14.55 14.27,14.89 14.48,15.16 14.70,15.40 14.92,15.60 15.13,15.78 15.35,15.92 15.57,16.05 15.78,16.16 16.00,16.25 16.22,16.32 16.43,16.38 16.65,16.43 16.87,16.46 17.08,16.49 17.30,16.50 17.52,16.50 17.73,16.49 17.95,16.47 18.17,16.43 18.38,16.39 18.60,16.33 18.82,16.26 19.03,16.17 19.25,16.07 19.47,15.94 19.68,15.80 19.90,15.63 20.12,15.42 20.33,15.19 20.55,14.90 20.77,14.56 20.98,14.14 21.20,13.62 21.42,12.95 21.63,12.04 21.85,10.66 22.07,7.37 22.28,5.29 22.50,5.69 22.72,6.06 22.93,6.40 23.15,6.72 23.37,7.01 23.58,7.28 23.80,7.53 24.02,7.76 24.23,7.99 24.45,8.20 24.67,8.40 24.88,8.59 25.10,8.78 25.32,8.96 25.53,9.14 25.75,9.32 25.97,9.49 26.18,9.66 26.40,9.82 26.62,9.98 26.83,10.14 27.05,10.29 27.27,10.43 27.48,10.57 27.70,10.70 27.92,10.82 28.13,10.93 28.35,11.03 28.57,11.12 28.78,11.19 29.00,11.26 L29,24 A3,3 0 0 1 26,27 L6,27 A3,3 0 0 1 3,24 Z">
                        <GeometryDrawing.Brush>
                            <LinearGradientBrush StartPoint="3,16" EndPoint="29,16">
                                <GradientStop Offset="0.0" Color="#FF4030" />
                                <GradientStop Offset="0.2" Color="#FF4030" />
                                <GradientStop Offset="0.2" Color="#FFD200" />
                                <GradientStop Offset="0.4" Color="#FFD200" />
                                <GradientStop Offset="0.4" Color="#49DB23" />
                                <GradientStop Offset="0.6" Color="#49DB23" />
                                <GradientStop Offset="0.6" Color="#0099FF" />
                                <GradientStop Offset="0.8" Color="#0099FF" />
                                <GradientStop Offset="0.8" Color="#D738FF" />
                                <GradientStop Offset="1.0" Color="#D738FF" />
                            </LinearGradientBrush>
                        </GeometryDrawing.Brush>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage>

            <!--  ===== Buttons =====
                  Templated from scratch rather than layered on Semi's, so each look is decided by
                  these few brushes alone and nothing of the app theme's own button states shows
                  through. Every one draws its keyboard ring as a box shadow in the strong accent.  -->

            <!--  The Simple tab's HEX / RGB / HSL copy buttons, in the editors' bar metrics: the 8px
                  radius of their tool buttons, on the Semi fill their bar fields wear, with the
                  tool buttons' hover fill.  -->
            <ControlTheme x:Key="ColorDialogBarChipButton" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource SemiColorFill0}" />
                <Setter Property="Foreground" Value="{DynamicResource ColorDialogTextBrush}" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Name="PART_Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                            <Panel>
                                <!--  the copy flash (the .copied class), over the fill and under the label  -->
                                <Border Name="PART_Flash"
                                        Background="{DynamicResource ColorDialogCopiedBrush}"
                                        CornerRadius="{TemplateBinding CornerRadius}"
                                        IsHitTestVisible="False"
                                        Opacity="0" />
                                <ContentPresenter Name="PART_ContentPresenter"
                                                  Padding="{TemplateBinding Padding}"
                                                  HorizontalContentAlignment="Center"
                                                  VerticalContentAlignment="Center"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Foreground="{TemplateBinding Foreground}" />
                            </Panel>
                        </Border>
                    </ControlTemplate>
                </Setter>
                <Style Selector="^:pointerover">
                    <Setter Property="Background" Value="{DynamicResource SemiColorFill1}" />
                </Style>
                <!--  A copy succeeded: green at once, held a moment, then faded back to the fill. Code
                      re-adds the class for each copy (ColorSimpleTab.FlashCopied), which restarts it.  -->
                <Style Selector="^.copied /template/ Border#PART_Flash">
                    <Style.Animations>
                        <Animation Duration="0:0:1.2" Easing="SineEaseInOut">
                            <KeyFrame Cue="0%">
                                <Setter Property="Opacity" Value="1" />
                            </KeyFrame>
                            <KeyFrame Cue="20%">
                                <Setter Property="Opacity" Value="1" />
                            </KeyFrame>
                            <KeyFrame Cue="100%">
                                <Setter Property="Opacity" Value="0" />
                            </KeyFrame>
                        </Animation>
                    </Style.Animations>
                </Style>
                <Style Selector="^:pressed">
                    <Setter Property="Background" Value="{DynamicResource SemiColorFill2}" />
                </Style>
                <Style Selector="^:disabled">
                    <Setter Property="Opacity" Value="0.45" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Style>
                <Style Selector="^:focus-visible /template/ Border#PART_Border">
                    <Setter Property="BoxShadow" Value="{DynamicResource ColorDialogFocusRing}" />
                </Style>
            </ControlTheme>

            <!--  No fill until hovered, like the editors' tool buttons: the top bar's Initial
                  button, and small icon buttons on the surface (a header's Copy all).  -->
            <ControlTheme x:Key="ColorDialogGhostButton"
                          BasedOn="{StaticResource ColorDialogBarChipButton}"
                          TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Padding" Value="8,0" />
            </ControlTheme>

            <!--  A button drawn ON a color (a palette bar's hex and its hover actions). Its fill and
                  ink are set per bar from the color's luminance (PaletteBars), so hover cannot be a
                  fill swap: it is a veil of the button's own ink laid over the fill.  -->
            <ControlTheme x:Key="ColorDialogOnColorButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Width" Value="30" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="7" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Name="PART_Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                            <Panel>
                                <Border Name="PART_Veil"
                                        Background="{TemplateBinding Foreground}"
                                        CornerRadius="{TemplateBinding CornerRadius}"
                                        Opacity="0" />
                                <ContentPresenter Name="PART_ContentPresenter"
                                                  Padding="{TemplateBinding Padding}"
                                                  HorizontalContentAlignment="Center"
                                                  VerticalContentAlignment="Center"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Foreground="{TemplateBinding Foreground}" />
                            </Panel>
                        </Border>
                    </ControlTemplate>
                </Setter>
                <Style Selector="^:pointerover /template/ Border#PART_Veil">
                    <Setter Property="Opacity" Value="0.14" />
                </Style>
                <Style Selector="^:pressed /template/ Border#PART_Veil">
                    <Setter Property="Opacity" Value="0.24" />
                </Style>
                <Style Selector="^:focus-visible /template/ Border#PART_Border">
                    <Setter Property="BoxShadow" Value="{DynamicResource ColorDialogFocusRing}" />
                </Style>
            </ControlTheme>
        </ResourceDictionary>
    </Styles.Resources>

    <!--  ===== Text =====  -->

    <!--  A section caption (FROM IMAGE, PALETTE, MOOD): written in capitals in the markup, and
          tracked out by .06em of its 11px.  -->
    <Style Selector="TextBlock.colorDialogCaption">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LetterSpacing" Value="0.66" />
        <Setter Property="Foreground" Value="{DynamicResource ColorDialogMutedTextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--  Quieter text on the surface: hints, a field's label.  -->
    <Style Selector="TextBlock.colorDialogMuted">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{DynamicResource ColorDialogMutedTextBrush}" />
    </Style>

    <!--  ===== Fields =====
          Semi's text box with its fill, border and states restated in the dialog's tokens. Semi
          paints its hover and focus states straight onto the template's border, so those are
          restated on the same part: a window style outranks the control theme's own.  -->
    <Style Selector="TextBox.colorDialogField">
        <Setter Property="Background" Value="{DynamicResource ColorDialogInputBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ColorDialogInputBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Foreground" Value="{DynamicResource ColorDialogTextBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource ColorDialogTextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox.colorDialogField /template/ Border#PART_ContentPresenterBorder">
        <Setter Property="Background" Value="{DynamicResource ColorDialogInputBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ColorDialogInputBorderBrush}" />
    </Style>
    <Style Selector="TextBox.colorDialogField:pointerover /template/ Border#PART_ContentPresenterBorder">
        <Setter Property="BorderBrush" Value="{DynamicResource ColorDialogInputHoverBorderBrush}" />
    </Style>
    <Style Selector="TextBox.colorDialogField:focus /template/ Border#PART_ContentPresenterBorder">
        <Setter Property="BorderBrush" Value="{DynamicResource ColorDialogAccentStrongBrush}" />
    </Style>

    <!--  ===== The rail =====
          A vertical TabStrip: a tab list to assistive tech, with arrow keys between the items
          (ColorDialog handles them, so they wrap and never fall through to the content).  -->
    <Style Selector="TabStrip.colorDialogRail">
        <!--  bare: the app theme's tab strip draws a rule under its items  -->
        <Setter Property="Template">
            <ControlTemplate>
                <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
            </ControlTemplate>
        </Setter>
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <StackPanel Orientation="Vertical" Spacing="4" />
            </ItemsPanelTemplate>
        </Setter>
    </Style>
    <Style Selector="TabStrip.colorDialogRail > TabStripItem">
        <Setter Property="Theme">
            <!--  56 x 56, a little over the brief's 54 x 50: the full-color icons read best at 30px,
                  and this dialog's rail has the room.  -->
            <ControlTheme TargetType="TabStripItem">
                <Setter Property="Width" Value="56" />
                <Setter Property="Height" Value="56" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource ColorDialogRailTextBrush}" />
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Name="PART_Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <!--  Stretched, not centered: a centered label stack takes its width from the
                                  label, which the selected tab's semibold widens, and rounding that
                                  re-centering nudged the icon and text a pixel each way between tabs.
                                  Filling the fixed 56px item, each centers on the same line always.  -->
                            <ContentPresenter Name="PART_ContentPresenter"
                                              HorizontalContentAlignment="Stretch"
                                              VerticalContentAlignment="Center"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Foreground="{TemplateBinding Foreground}" />
                        </Border>
                    </ControlTemplate>
                </Setter>
                <Style Selector="^:pointerover">
                    <Setter Property="Background" Value="{DynamicResource ColorDialogGhostHoverBrush}" />
                </Style>
                <!--  The icons are full color, so selection cannot tint them, and they stay at full
                      strength on every tab (dimmed, they washed out on dark): the selected tab is
                      marked by its fill and its bold label alone.  -->
                <Style Selector="^:selected">
                    <Setter Property="Background" Value="{DynamicResource ColorDialogRailSelectedBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource ColorDialogRailSelectedTextBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </Style>
                <Style Selector="^:focus-visible /template/ Border#PART_Border">
                    <Setter Property="BoxShadow" Value="{DynamicResource ColorDialogFocusRing}" />
                </Style>
            </ControlTheme>
        </Setter>
    </Style>
</Styles>
