                    <GeometryDrawing Geometry="F1 M26,20H6c-0.552,0-1,0.448-1,1v5 c0,0.552,0.448,1,1,1h20c0.552,0,1-0.448,1-1v-5C27,20.448,26.552,20,26,20z M26.75,26c0,0.414-0.336,0.75-0.75,0.75H6 c-0.414,0-0.75-0.336-0.75-0.75v-5c0-0.414,0.336-0.75,0.75-0.75h20c0.414,0,0.75,0.336,0.75,0.75V26z">
