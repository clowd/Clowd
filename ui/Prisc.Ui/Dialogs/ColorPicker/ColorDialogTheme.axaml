<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Prisc.UI.Controls"
        xmlns:cp="using:Prisc.UI.Dialogs.ColorPicker">

    <!--  The color dialog's look, in one place for all three of its tabs (ColorDialog includes it
          in its window styles, so nothing here leaks into the rest of the app). It wears the
          editors' modern chrome: the bars on the window's own backdrop, the content on a raised
          surface that takes the editors' canvas surround, edge and shadow (AppResources) so the
          three windows cannot drift apart.

          Every color is a token below, keyed "ColorDialog*" and split by theme variant. The dark
          values are the mockup's. The light ones were not mocked: they follow the editors' light
          chrome role for role (the #E9E9E9 surround, a faint black veil where the dark theme has a
          white one, white fields), with the accent stepped darker for anything that is a mark
          rather than a fill, and muted text chosen to keep 4.5:1 on the surface.  -->

    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <!--  ink: body text on the surface and the bars, and the quieter labels  -->
                    <SolidColorBrush x:Key="ColorDialogTextBrush" Color="#F2F2F4" />
                    <!--  7.3:1 on the #1E1E1E surface  -->
                    <SolidColorBrush x:Key="ColorDialogMutedTextBrush" Color="#A9ADB4" />
                    <!--  the top bar's Initial / Selected labels, over the backdrop  -->
                    <SolidColorBrush x:Key="ColorDialogBarLabelBrush" Color="#B9BCC2" />

                    <!--  hairlines: inside the surface, and the top bar's divider over the backdrop  -->
                    <SolidColorBrush x:Key="ColorDialogDividerBrush" Color="#2C2C2F" />
                    <SolidColorBrush x:Key="ColorDialogBarDividerBrush" Color="#29FFFFFF" />

                    <!--  text and number fields  -->
                    <SolidColorBrush x:Key="ColorDialogInputBrush" Color="#161618" />
                    <SolidColorBrush x:Key="ColorDialogInputBorderBrush" Color="#3A3D43" />
                    <SolidColorBrush x:Key="ColorDialogInputHoverBorderBrush" Color="#4D5158" />

                    <!--  the OKLCH tab's charts and tracks where sRGB has no color: the field fill,
                          dark enough to set off every color but the darkest  -->
                    <SolidColorBrush x:Key="ColorDialogGamutEmptyBrush" Color="#161618" />

                    <!--  neutral chips and buttons on the surface (Cancel, mood chips, the bottom slots)  -->
                    <SolidColorBrush x:Key="ColorDialogChipBrush" Color="#262629" />
                    <SolidColorBrush x:Key="ColorDialogChipHoverBrush" Color="#2F2F33" />
                    <SolidColorBrush x:Key="ColorDialogChipBorderBrush" Color="#3A3D43" />

                    <!--  faint veils: the empty palette bars, and the rail's tabs  -->
                    <SolidColorBrush x:Key="ColorDialogBarChipBrush" Color="#14FFFFFF" />
                    <SolidColorBrush x:Key="ColorDialogGhostHoverBrush" Color="#14FFFFFF" />
                    <!--  a copy button's success flash, under its light label  -->
                    <SolidColorBrush x:Key="ColorDialogCopiedBrush" Color="#1F8F4E" />
                    <SolidColorBrush x:Key="ColorDialogRailSelectedBrush" Color="#1FFFFFFF" />
                    <SolidColorBrush x:Key="ColorDialogRailTextBrush" Color="#B8FFFFFF" />
                    <SolidColorBrush x:Key="ColorDialogRailSelectedTextBrush" Color="#FFFFFF" />

                    <!--  The accent. The fill is Prisc's own blue on both variants (OK, with the
                          dark ink on it); the "strong" one is for marks — rings, selected icons,
                          focus — and is lighter here so it reads on the dark surface.  -->
                    <SolidColorBrush x:Key="ColorDialogAccentBrush" Color="#00AFF0" />
                    <SolidColorBrush x:Key="ColorDialogAccentStrongBrush" Color="#4CC8F5" />
                    <Color x:Key="ColorDialogAccentStrongColor">#4CC8F5</Color>
                    <!--  the faint fill of a selected chip or preset button  -->
                    <SolidColorBrush x:Key="ColorDialogAccentFaintBrush" Color="#2900AFF0" />
                    <BoxShadows x:Key="ColorDialogFocusRing">0 0 0 2 #4CC8F5</BoxShadows>

                    <!--  a color chip's inner hairline, so a chip that matches the surface still has an edge  -->
                    <SolidColorBrush x:Key="ColorDialogSwatchEdgeBrush" Color="#24FFFFFF" />
                    <!--  a harmony preset glyph's spokes, from its centre out to its dots  -->
                    <SolidColorBrush x:Key="ColorDialogGlyphLineBrush" Color="#80FFFFFF" />
                    <!--  the same for a palette bar, fainter since a bar is far bigger than a chip  -->
                    <SolidColorBrush x:Key="ColorDialogBarEdgeBrush" Color="#14FFFFFF" />
                    <!--  the content surface: the editors' canvas surround  -->
                    <SolidColorBrush x:Key="ColorDialogSurfaceBrush" Color="#1E1E1E" />
                    <!--  what shows through the gap between a palette bar and its accent ring: the surface  -->
                    <Color x:Key="ColorDialogSurfaceColor">#1E1E1E</Color>

                    <!--  the alpha track's checkerboard  -->
                    <DrawingBrush x:Key="ColorDialogCheckerBrush"
                                  DestinationRect="0,0,8,8"
                                  SourceRect="0,0,8,8"
                                  Stretch="None"
                                  TileMode="Tile">
                        <DrawingBrush.Drawing>
                            <DrawingGroup>
                                <GeometryDrawing Brush="#3A3D42" Geometry="M0,0 H8 V8 H0 Z" />
                                <GeometryDrawing Brush="#5A5D63" Geometry="M0,0 H4 V4 H0 Z M4,4 H8 V8 H4 Z" />
                            </DrawingGroup>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </ResourceDictionary>

                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ColorDialogTextBrush" Color="#0D0D0F" />
                    <!--  5.0:1 on the #E9E9E9 surface  -->
                    <SolidColorBrush x:Key="ColorDialogMutedTextBrush" Color="#565A60" />
                    <SolidColorBrush x:Key="ColorDialogBarLabelBrush" Color="#4E5258" />

                    <SolidColorBrush x:Key="ColorDialogDividerBrush" Color="#D2D2D6" />
                    <SolidColorBrush x:Key="ColorDialogBarDividerBrush" Color="#24000000" />

                    <SolidColorBrush x:Key="ColorDialogInputBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ColorDialogInputBorderBrush" Color="#C4C7CC" />
                    <SolidColorBrush x:Key="ColorDialogInputHoverBorderBrush" Color="#A9ADB4" />

                    <!--  the OKLCH tab's charts and tracks where sRGB has no color: a mid gray, not the
                          white field fill, so the lightest colors still show where the gamut ends  -->
                    <SolidColorBrush x:Key="ColorDialogGamutEmptyBrush" Color="#C9C9CE" />

                    <SolidColorBrush x:Key="ColorDialogChipBrush" Color="#F7F7F8" />
                    <SolidColorBrush x:Key="ColorDialogChipHoverBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ColorDialogChipBorderBrush" Color="#C4C7CC" />

                    <SolidColorBrush x:Key="ColorDialogBarChipBrush" Color="#0F000000" />
                    <SolidColorBrush x:Key="ColorDialogGhostHoverBrush" Color="#0F000000" />
                    <!--  a copy button's success flash, under its dark label  -->
                    <SolidColorBrush x:Key="ColorDialogCopiedBrush" Color="#7FD69D" />
                    <SolidColorBrush x:Key="ColorDialogRailSelectedBrush" Color="#14000000" />
                    <SolidColorBrush x:Key="ColorDialogRailTextBrush" Color="#4A4E54" />
                    <SolidColorBrush x:Key="ColorDialogRailSelectedTextBrush" Color="#0D0D0F" />

                    <SolidColorBrush x:Key="ColorDialogAccentBrush" Color="#00AFF0" />
                    <!--  the light theme's mark is the accent taken darker (3.9:1 on the surround, past
                          the 3:1 a ring or an icon needs), where the dark theme's is taken lighter  -->
                    <SolidColorBrush x:Key="ColorDialogAccentStrongBrush" Color="#0080B8" />
                    <Color x:Key="ColorDialogAccentStrongColor">#0080B8</Color>
                    <SolidColorBrush x:Key="ColorDialogAccentFaintBrush" Color="#2200AFF0" />
                    <BoxShadows x:Key="ColorDialogFocusRing">0 0 0 2 #0080B8</BoxShadows>

                    <SolidColorBrush x:Key="ColorDialogSwatchEdgeBrush" Color="#24000000" />
                    <SolidColorBrush x:Key="ColorDialogGlyphLineBrush" Color="#59000000" />
                    <SolidColorBrush x:Key="ColorDialogBarEdgeBrush" Color="#14000000" />
                    <!--  the content surface: a touch lighter than the editors' #E9E9E9 canvas surround,
                          nearer white, since here it holds the controls rather than framing a canvas  -->
                    <SolidColorBrush x:Key="ColorDialogSurfaceBrush" Color="#F2F2F2" />
                    <Color x:Key="ColorDialogSurfaceColor">#F2F2F2</Color>

                    <DrawingBrush x:Key="ColorDialogCheckerBrush"
                                  DestinationRect="0,0,8,8"
                                  SourceRect="0,0,8,8"
                                  Stretch="None"
                                  TileMode="Tile">
                        <DrawingBrush.Drawing>
                            <DrawingGroup>
                                <GeometryDrawing Brush="#FFFFFF" Geometry="M0,0 H8 V8 H0 Z" />
                                <GeometryDrawing Brush="#D3D5D9" Geometry="M0,0 H4 V4 H0 Z M4,4 H8 V8 H4 Z" />
                            </DrawingGroup>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!--  Text drawn on a color (a palette bar's hex, a BASE tag) is not themed: it follows the
                  color under it (cp:ColorDialogInk picks between these two by luminance).  -->
            <SolidColorBrush x:Key="ColorDialogInkDarkBrush" Color="#16181C" />
            <SolidColorBrush x:Key="ColorDialogInkLightBrush" Color="#FFFFFF" />

            <!--  Line icons, drawn by cp:LineIcon: 24-unit stroke paths (the mockup's), so they keep
                  its 1.7-unit stroke at whatever size they are shown.  -->
            <StreamGeometry x:Key="ColorDialogIconCopy">M10,8 H18 A2,2 0 0 1 20,10 V18 A2,2 0 0 1 18,20 H10 A2,2 0 0 1 8,18 V10 A2,2 0 0 1 10,8 Z M16,8 V6 A2,2 0 0 0 14,4 H6 A2,2 0 0 0 4,6 V14 A2,2 0 0 0 6,16 H8</StreamGeometry>
            <StreamGeometry x:Key="ColorDialogIconCheck">M20,6 L9,17 L4,12</StreamGeometry>
            <StreamGeometry x:Key="ColorDialogIconArrowRight">M5,12 H19 M13,6 L19,12 L13,18</StreamGeometry>
            <StreamGeometry x:Key="ColorDialogIconImage">M5,3 H19 A2,2 0 0 1 21,5 V19 A2,2 0 0 1 19,21 H5 A2,2 0 0 1 3,19 V5 A2,2 0 0 1 5,3 Z M7,9 A2,2 0 1 0 11,9 A2,2 0 1 0 7,9 Z M21,15 L17.9,11.9 A2,2 0 0 0 15.1,11.9 L6,21</StreamGeometry>
            <StreamGeometry x:Key="ColorDialogIconPalette">M5.2,3 H18.8 A1.2,1.2 0 0 1 20,4.2 V5.8 A1.2,1.2 0 0 1 18.8,7 H5.2 A1.2,1.2 0 0 1 4,5.8 V4.2 A1.2,1.2 0 0 1 5.2,3 Z M5.2,10 H18.8 A1.2,1.2 0 0 1 20,11.2 V12.8 A1.2,1.2 0 0 1 18.8,14 H5.2 A1.2,1.2 0 0 1 4,12.8 V11.2 A1.2,1.2 0 0 1 5.2,10 Z M5.2,17 H18.8 A1.2,1.2 0 0 1 20,18.2 V19.8 A1.2,1.2 0 0 1 18.8,21 H5.2 A1.2,1.2 0 0 1 4,19.8 V18.2 A1.2,1.2 0 0 1 5.2,17 Z</StreamGeometry>
            <StreamGeometry x:Key="ColorDialogIconReplace">M3,12 A9,9 0 0 1 18,5.3 L21,8 M21,3 V8 H16 M21,12 A9,9 0 0 1 6,18.7 L3,16 M3,21 V16 H8</StreamGeometry>

            <!--  The rail's tab icons: the user's own full-color icons (icons8, 32-unit viewBox), as
                  drawings rather than geometries because each carries its own palette, gradients and
                  all. Each opens with a transparent square that sets the box it scales into, cropped
                  round its own ink so the three balance by visual weight rather than by viewBox:
                  Image (a wide rectangle) and Palette (a fan) have their larger extent fill 5/6 of
                  the box, which gives them the same inked area; Simple, a disc, would read smaller
                  at that ratio, so it fills 0.883 instead, the ratio that gives it the same area.
                  Not themed: the same colors on either variant.  -->
            <DrawingImage x:Key="ColorDialogRailIconSimple">
                <DrawingGroup>
                    <GeometryDrawing Brush="Transparent" Geometry="M0.981,0.981 h30.039 v30.039 h-30.039 Z" />
                    <GeometryDrawing Brush="#0099FF" Geometry="F1 M23.983,26.247C19.197,24.683,15.135,21.194,16,16c-5.201,1.855-5.862,7.686-4.885,12.044 c1.447,0.569,3.431,1.189,6.351,0.861C19.511,28.675,21.752,27.993,23.983,26.247z" />
                    <GeometryDrawing Brush="#49DB23" Geometry="F1 M11.117,28.038C10.078,23.111,11.069,17.848,16,16c-4.207-3.577-9.587-1.233-12.873,1.791 c0.231,1.538,0.686,3.566,2.430,5.930C6.779,25.378,8.490,26.978,11.117,28.038z" />
                    <GeometryDrawing Brush="#FFD200" Geometry="F1 M3.134,17.790C6.882,14.427,11.934,12.654,16,16c0.994-5.432-3.726-8.920-7.988-10.253 c-1.216,0.969-2.745,2.377-3.921,5.070C3.268,12.703,2.738,14.985,3.134,17.790z" />
                    <GeometryDrawing Brush="#FFA000" Geometry="F1 M8.017,5.753C12.803,7.317,16.865,10.806,16,16c5.201-1.855,5.862-7.686,4.885-12.044 c-1.447-0.569-3.431-1.189-6.351-0.861C12.489,3.325,10.248,4.007,8.017,5.753z" />
                    <GeometryDrawing Brush="#FF4030" Geometry="F1 M20.883,3.962C21.922,8.890,20.932,14.152,16.001,16c4.207,3.577,9.587,1.233,12.873-1.791 c-0.231-1.538-0.686-3.566-2.430-5.930C25.222,6.622,23.511,5.022,20.883,3.962z" />
                    <GeometryDrawing Brush="#D738FF" Geometry="F1 M28.867,14.210c-3.748,3.363-8.800,5.137-12.866,1.790c-0.994,5.432,3.726,8.920,7.988,10.253 c1.216-0.969,2.745-2.377,3.921-5.070C28.732,19.297,29.262,17.015,28.867,14.210z" />
                </DrawingGroup>
            </DrawingImage>

            <DrawingImage x:Key="ColorDialogRailIconImage">
                <DrawingGroup>
                    <GeometryDrawing Brush="Transparent" Geometry="M0,0 h48 v48 h-48 Z" />
                    <GeometryDrawing Brush="#F57C00" Geometry="M40,41H8c-2.2,0-4-1.8-4-4V11c0-2.2,1.8-4,4-4h32c2.2,0,4,1.8,4,4v26C44,39.2,42.2,41,40,41z" />
                    <GeometryDrawing Brush="#FFF9C4" Geometry="M35 13A3 3 0 1 0 35 19A3 3 0 1 0 35 13Z" />
                    <GeometryDrawing Brush="#942A09" Geometry="M20 16L9 32 31 32z" />
                    <GeometryDrawing Brush="#BF360C" Geometry="M31 22L23 32 39 32z" />
                </DrawingGroup>
            </DrawingImage>

            <DrawingImage x:Key="ColorDialogRailIconPalette">
                <DrawingGroup>
                    <GeometryDrawing Brush="Transparent" Geometry="M2.643,2.785 h26.571 v26.571 h-26.571 Z" />
                    <GeometryDrawing Geometry="F1 M5,26v-5c0-0.552,0.448-1,1-1h20c0.552,0,1,0.448,1,1v5c0,0.552-0.448,1-1,1H6 C5.448,27,5,26.552,5,26z">
