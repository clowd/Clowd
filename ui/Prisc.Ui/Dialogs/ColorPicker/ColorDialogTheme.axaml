                    </GeometryDrawing>
                    <GeometryDrawing Geometry="F1 M7.634,26.5l-2.5-4.33 c-0.276-0.478-0.112-1.09,0.366-1.366l17.321-10c0.478-0.276,1.09-0.112,1.366,0.366l2.5,4.33c0.276,0.478,0.112,1.09-0.366,1.366 L9,26.866C8.522,27.142,7.91,26.978,7.634,26.5z">
                        <GeometryDrawing.Brush>
                            <LinearGradientBrush StartPoint="6.481,24.269" EndPoint="25.479,13.3">
                                <GradientStop Offset="0.174" Color="#D9D9D9" />
                                <GradientStop Offset="0.183" Color="#009C1A" />
                                <GradientStop Offset="0.445" Color="#009C1A" />
                                <GradientStop Offset="0.458" Color="#1ABA35" />
                                <GradientStop Offset="0.719" Color="#1ABA35" />
                                <GradientStop Offset="0.731" Color="#50DE68" />
