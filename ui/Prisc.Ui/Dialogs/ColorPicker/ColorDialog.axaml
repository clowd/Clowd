<ui:SystemThemedWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Prisc.UI.Controls"
        xmlns:cp="using:Prisc.UI.Dialogs.ColorPicker"
        xmlns:ui="using:Prisc.UI"
        x:Class="Prisc.UI.Dialogs.ColorPicker.ColorDialog"
        Title="Color Wheel"
        Width="720"
        Height="520"
        CanResize="False"
        CanMinimize="False"
        CanMaximize="False"
        FontSize="13"
        UseLayoutRounding="True">

    <!--  The color dialog (COLOR_VIEWER_REWORK.md): the editors' modern chrome at dialog size. The
          top bar and the rail sit on the window's own backdrop (Mica where the compositor grants
          it); the tabs sit on the raised surface, rounded where the two bars meet it.  -->
    <Window.Styles>
        <StyleInclude Source="avares://Prisc.Ui/Dialogs/ColorPicker/ColorDialogTheme.axaml" />
    </Window.Styles>

    <!--  "modern" is the editors' chrome class: the shared bar styles key off it.  -->
    <Grid x:Name="rootGrid"
          Classes="modern"
          ColumnDefinitions="64,*"
          RowDefinitions="42,*"
          TextElement.Foreground="{DynamicResource ColorDialogTextBrush}">
        <Grid.Styles>
            <!--  The editors' tool buttons, and their top bar's metrics (VideoEditorWindow's TopBar
                  rules): a 32px lane, 5px above and below it, groups 6px apart, buttons 2px apart.  -->
            <StyleInclude Source="avares://Prisc.Ui/Assets/EditorChromeStyles.axaml" />
            <Style Selector="controls|DockAndWrapPanel#topBar">
                <Setter Property="ItemHeight" Value="32" />
                <Setter Property="Margin" Value="4,5,4,5" />
            </Style>
            <Style Selector="controls|DockAndWrapPanel#topBar &gt; controls|ToolButton">
                <Setter Property="Margin" Value="1,0" />
            </Style>
            <Style Selector="Border.colorChip">
                <Setter Property="Height" Value="24" />
                <Setter Property="MinWidth" Value="84" />
                <Setter Property="Padding" Value="9,0" />
                <Setter Property="BorderBrush" Value="{DynamicResource ColorDialogSwatchEdgeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>
            <Style Selector="Border.colorChip &gt; TextBlock">
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
                <Setter Property="FontSize" Value="12" />
            </Style>
            <Style Selector="controls|DockAndWrapPanel#topBar &gt; StackPanel">
                <Setter Property="Height" Value="32" />
                <Setter Property="Margin" Value="6,0" />
                <Setter Property="Orientation" Value="Horizontal" />
            </Style>
        </Grid.Styles>

        <!--  Parks focus when a click lands on anything but a text field, so a field being typed
              in commits (on focus loss) the moment the user moves on. Focusable, never a tab stop.  -->
        <Control x:Name="focusSink"
                 Focusable="True"
                 IsTabStop="False" />

        <!--  ===== Top bar =====
              The editors' modern strip, item for item: the same panel and chrome classes, the same
              32px lane with 5px either side, the same groups 6px apart, the same tool buttons
              (Assets/EditorChromeStyles.axaml). Everything packs to the left after the tab's name,
              where the editors show their session's; only the pin docks to the far end.  -->
        <controls:DockAndWrapPanel x:Name="topBar"
                                   Grid.ColumnSpan="2"
                                   Background="Transparent"
                                   Classes="chromeBar tipBridge"
                                   Orientation="Horizontal">

            <!--  Clears the macOS traffic lights, which sit in this bar; zero-width elsewhere.  -->
            <Border Width="{DynamicResource MacTitleBarGutterHorz}" />

            <!--  The active tab's name. The window's own title stays "Color Wheel". The panel also
                  holds an invisible copy of every name (added in code), so it is as wide as the
                  longest and the rest of the bar holds still as the tab changes.  -->
            <StackPanel>
                <Panel x:Name="tabNameHost">
                    <TextBlock x:Name="tabNameText"
                               VerticalAlignment="Center"
                               FontWeight="Bold" />
                </Panel>
            </StackPanel>

            <!--  The colors as small chips, the hex inside in ink chosen against the fill: "Initial"
                  (it restores that color) only when the dialog opened with one, then "Selected".
                  A checkerboard sits under each so a translucent color reads as such, and
                  the swatches' hairline keeps white visible on the light bar.  -->
            <StackPanel>
                <Button x:Name="btnInitial"
                        AutomationProperties.Name="Restore initial color"
                        Theme="{StaticResource ColorDialogGhostButton}"
                        ToolTip.Tip="Restore initial color">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource ColorDialogBarLabelBrush}"
                                   Text="Initial" />
                        <Panel VerticalAlignment="Center">
                            <!--  inset by the chip's edge so the translucent edge lies on the surface,
                                  not the checker, which would show through it around an opaque color  -->
                            <Border Margin="1"
                                    Background="{DynamicResource ColorDialogCheckerBrush}"
                                    CornerRadius="5" />
                            <Border x:Name="initialChip"
                                    Classes="colorChip">
                                <TextBlock x:Name="initialHex" />
                            </Border>
                        </Panel>
                    </StackPanel>
                </Button>
                <!--  Not a button (the Open buttons carry it to another tab): a plain readout, padded
                      as the Initial button is so the two line up.  -->
                <Border Padding="8,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource ColorDialogBarLabelBrush}"
                                   Text="Selected" />
                        <Panel VerticalAlignment="Center">
                            <Border Margin="1"
                                    Background="{DynamicResource ColorDialogCheckerBrush}"
                                    CornerRadius="5" />
                            <Border x:Name="selectedChip"
                                    Classes="colorChip">
                                <TextBlock x:Name="selectedHex" />
                            </Border>
                        </Panel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!--  Copies the Selected color's hex; the icon turns into a check for a moment.  -->
            <controls:ToolButton x:Name="btnCopy"
                                 Classes="wide"
                                 AutomationProperties.Name="Copy selected hex"
                                 IconPath="{StaticResource IconCopySmall}"
                                 ToolTip.Tip="Copy selected hex" />

            <!--  Carry the Selected color to another tab: as the Simple tab's color, the Palette tab's
                  base, or the Oklch tab's color. In rail order; each is hidden on the tab it would
                  open (OnActiveTabChanged).  -->
            <controls:ToolButton x:Name="btnOpenSimple"
                                 Classes="wide"
                                 AutomationProperties.Name="Open selected in Simple"
                                 IconPath="{StaticResource IconColorWheel}"
                                 ToolTip.Tip="Open selected in Simple" />
            <controls:ToolButton x:Name="btnOpenPalette"
                                 Classes="wide"
                                 AutomationProperties.Name="Open selected in Palette"
                                 IconPath="{StaticResource IconPaletteSwatches}"
                                 ToolTip.Tip="Open selected in Palette" />
            <controls:ToolButton x:Name="btnOpenOklch"
                                 Classes="wide"
                                 AutomationProperties.Name="Open selected in Oklch"
                                 IconPath="{StaticResource IconOklch}"
                                 ToolTip.Tip="Open selected in Oklch" />

            <!--  Samples into the Simple tab, or the Palette tab's base, live while dragging. The
                  tooltip lives in EyedropperButton (it swaps to the permission hint).  -->
            <cp:EyedropperButton x:Name="btnEyedropper"
                                 controls:DockAndWrapPanel.DockToEnd="True"
                                 AutomationProperties.Name="Pick from screen"
                                 IconPath="{StaticResource IconEyedropper}" />

            <!--  The editors' pin, declared as they declare it: a toggle on the window's own Topmost.  -->
            <controls:ToolButton Classes="wide"
                                 controls:DockAndWrapPanel.DockToEnd="True"
                                 CanToggle="True"
                                 IconPath="{StaticResource IconPinned}"
                                 IsChecked="{Binding $parent[Window].Topmost, Mode=TwoWay}"
                                 ToolTip.Tip="Always on top" />
        </controls:DockAndWrapPanel>

        <!--  ===== Rail =====  -->
        <TabStrip x:Name="rail"
                  Grid.Row="1"
                  Margin="0,4,0,0"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Top"
                  AutomationProperties.Name="Mode"
                  Classes="colorDialogRail">
            <TabStripItem AutomationProperties.Name="Simple">
                <StackPanel Spacing="3">
                    <Image Width="30" Height="30" HorizontalAlignment="Center" Source="{DynamicResource ColorDialogRailIconSimple}" />
                    <TextBlock HorizontalAlignment="Center" Text="Simple" />
                </StackPanel>
            </TabStripItem>
            <TabStripItem AutomationProperties.Name="Image">
                <StackPanel Spacing="3">
                    <Image Width="30" Height="30" HorizontalAlignment="Center" Source="{DynamicResource ColorDialogRailIconImage}" />
                    <TextBlock HorizontalAlignment="Center" Text="Image" />
                </StackPanel>
            </TabStripItem>
            <TabStripItem AutomationProperties.Name="Palette">
                <StackPanel Spacing="3">
                    <Image Width="30" Height="30" HorizontalAlignment="Center" Source="{DynamicResource ColorDialogRailIconPalette}" />
                    <TextBlock HorizontalAlignment="Center" Text="Palette" />
                </StackPanel>
            </TabStripItem>
            <TabStripItem AutomationProperties.Name="OKLCH">
                <StackPanel Spacing="3">
                    <Image Width="30" Height="30" HorizontalAlignment="Center" Source="{DynamicResource ColorDialogRailIconOklch}" />
                    <TextBlock HorizontalAlignment="Center" Text="Oklch" />
                </StackPanel>
            </TabStripItem>
        </TabStrip>

        <!--  ===== Content surface =====
              The editors' canvas surround (a little lighter in the light theme), its shadow cast
              over both bars. The hairline along the two edges that face the bars is a sibling laid
              over the content (as in the editors), so nothing inside can cover it.  -->
        <Border x:Name="contentSurface"
                Grid.Row="1"
                Grid.Column="1"
                Background="{DynamicResource ColorDialogSurfaceBrush}"
                BoxShadow="{DynamicResource PriscEditorSurfaceShadow}"
                CornerRadius="12,0,0,0" />

        <!--  The body's tips are the bars' strip tips (ColorDialogTips), shown by this one host. The
              transparent fill keeps the gaps (between swatches, say) inside the host, as tipBridge's
              does, so the tip is carried across them instead of closing and reopening.  -->
        <Grid Grid.Row="1"
              Grid.Column="1"
              Margin="20"
              Background="Transparent"
              controls:StripToolTips.IsEnabled="True"
              RowDefinitions="*,Auto">

            <!--  Every tab lives for the whole session and is only hidden while another shows, so
                  each keeps its state across trips round the rail.  -->
            <Panel x:Name="tabHost">
                <cp:ColorSimpleTab x:Name="simpleTab" />
                <cp:ColorImageTab x:Name="imageTab" IsVisible="False" />
                <cp:ColorPaletteTab x:Name="paletteTab" IsVisible="False" />
                <cp:ColorOkLchTab x:Name="oklchTab" IsVisible="False" />
            </Panel>

            <Border Grid.Row="1"
                    Margin="0,14,0,0"
                    Padding="0,14,0,0"
                    BorderBrush="{DynamicResource ColorDialogDividerBrush}"
                    BorderThickness="0,1,0,0">
                <!--  ordered, and pruned to the mode's buttons, in code (ColorDialog.BuildFooter); the
                     underlined letter clicks each, as in the old dialog  -->
                <StackPanel x:Name="footer"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            Spacing="8">
                    <controls:AcceleratedButton x:Name="btnOK"
                                                MinWidth="80"
                                                HorizontalContentAlignment="Center"
                                                Classes="Primary"
                                                Content="_OK"
                                                Theme="{StaticResource SolidButton}" />
                    <controls:AcceleratedButton x:Name="btnCancel"
                                                MinWidth="80"
                                                HorizontalContentAlignment="Center"
                                                Content="_Cancel" />
                    <controls:AcceleratedButton x:Name="btnClose"
                                                MinWidth="80"
                                                HorizontalContentAlignment="Center"
                                                Content="_Close" />
                </StackPanel>
            </Border>
        </Grid>

        <Border x:Name="contentOutline"
                Grid.Row="1"
                Grid.Column="1"
                BorderBrush="{DynamicResource PriscEditorSurfaceEdgeBrush}"
                BorderThickness="1,1,0,0"
                CornerRadius="12,0,0,0"
                IsHitTestVisible="False" />
    </Grid>
</ui:SystemThemedWindow>
