<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:Clowd.UI.Controls">

    <!-- Both spinners are in the template and one is hidden; ThemedSpinner.SyncVisibility picks.
         Building them on demand instead would mean rebinding on every chrome switch for a control
         that is a few dozen bytes either way. Each child is stretched and stripped of the width and
         margin its own theme wants, so the ThemedSpinner is the single thing that sizes the field
         and the two chromes line up on the same footprint. -->
    <ControlTheme x:Key="{x:Type controls:ThemedSpinner}" TargetType="controls:ThemedSpinner">
        <Setter Property="Width" Value="70" />
        <Setter Property="Margin" Value="4,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <controls:CompactSpinner Name="PART_Compact"
                                             Width="NaN"
                                             Margin="0"
                                             HorizontalAlignment="Stretch" />
                    <controls:ScrollableUrsaSpinner Name="PART_Modern"
                                                    HorizontalAlignment="Stretch"
                                                    IsVisible="False" />
                </Panel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

</ResourceDictionary>
