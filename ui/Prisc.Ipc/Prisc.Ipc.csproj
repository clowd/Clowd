<Project Sdk="Microsoft.NET.Sdk">
  <!-- The helper protocol's C# side (crates/prisc_capture/HELPER_PROTOCOL.md §7): the message
       types and codecs generated from crates/prisc_ipc into Generated/HelperMessages.g.cs. No
       package references, so Prisc.Ui, Prisc.VideoSDK and Prisc.VideoRender can all use it. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>Prisc.Ipc</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Prisc.Ipc.Tests" />
  </ItemGroup>
</Project>
