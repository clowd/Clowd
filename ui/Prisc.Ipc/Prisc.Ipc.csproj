<Project Sdk="Microsoft.NET.Sdk">
  <!-- The helper protocol's C# side (crates/prisc_capture/HELPER_PROTOCOL.md §7): the message
       types and codecs generated from crates/prisc_ipc into Generated/HelperMessages.g.cs, and the
       locator, client and child plumbing around them. No package references, so Prisc.Ui,
       Prisc.VideoSDK and Prisc.VideoRender can all use it. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>Prisc.Ipc</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- NativeProbe (the one helper and library probe), EnvVars, and the prisc_interop wrappers
         behind the stdout guard, the kill-on-close job and the foreground grant. -->
    <ProjectReference Include="..\Prisc.Interop\Prisc.Interop.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Prisc.Ipc.Tests" />
    <!-- for HelperLocator.Override, the seam DenoiseGeneratorTests and MatteGeneratorTests use -->
    <InternalsVisibleTo Include="Prisc.VideoSDK.Tests" />
  </ItemGroup>
</Project>
