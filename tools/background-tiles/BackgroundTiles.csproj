<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>Prisc.Tools.BackgroundTiles</RootNamespace>
    <!-- dev tool, never shipped; it exists only so the sprite sheets under
         ui/Prisc.Ui/Assets/BackgroundTiles are generated by the same renderer the app
         draws with rather than by a second implementation that could drift from it. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <!-- The whole point: the frames come out of BackgroundRenderer, the public entry point
         FrameComposer and the inspector tiles both call. -->
    <ProjectReference Include="..\..\ui\Prisc.VideoSDK\Prisc.VideoSDK.csproj" />
  </ItemGroup>

</Project>
