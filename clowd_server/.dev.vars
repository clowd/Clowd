# Local development variables — loaded automatically by `wrangler dev`.
# DEV_ALLOW_DISCARD enables the `discard` destination (relays to nowhere, commit
# is a no-op) so the full create -> chunk -> tail -> complete flow can be
# exercised locally with no real Azure/S3 bucket. NEVER set this in production
# (it is deliberately absent from wrangler.jsonc).
DEV_ALLOW_DISCARD=true

# Turn Sentry error reporting off locally. The Worker has no debug/release split
# to key off (worker-build always builds release), so this variable is what plays
# the role that `#[cfg(debug_assertions)]` plays in clowd_capture and `#if DEBUG`
# in Clowd.Ui: local failures belong in `wrangler tail`, not the issue tracker.
# Same variable name all three components honor. Any non-empty value disables.
CLOWD_DISABLE_TELEMETRY=1
