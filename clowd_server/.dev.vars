# Local development variables — loaded automatically by `wrangler dev`.
# DEV_ALLOW_DISCARD enables the `discard` destination (relays to nowhere, commit
# is a no-op) so the full create -> chunk -> tail -> complete flow can be
# exercised locally with no real Azure/S3 bucket. NEVER set this in production
# (it is deliberately absent from wrangler.jsonc).
DEV_ALLOW_DISCARD=true
