# These files are consumed on Linux CI (the weekly credits-refresh job) and by
# GitHub's workflow parser, so pin them to LF regardless of core.autocrlf. A
# CRLF shebang would make the shell script fail on the runner, and CRLF in the
# generated JSON would show up as a line-ending-only diff every week.
tools/gen-credits.sh                     text eol=lf
.github/workflows/update-credits.yml     text eol=lf
ui/Prisc.Ui/Assets/credits.json          text eol=lf

# Shell scripts run on Linux and macOS runners, and tools/linux-build/*.sh are
# bind-mounted into the Linux build image, so a CRLF checkout (core.autocrlf=true
# on a Windows dev box) would break their shebangs.
*.sh    text eol=lf

# Generated by prisc_hotkeys (src/csharp.rs), which always writes LF. Pinned so that a regen on a
# CRLF checkout does not show up as a line-ending-only diff.
ui/Prisc.Shared/Hotkeys/HotkeyKey.g.cs            text eol=lf
ui/Prisc.Ui/Services/Hotkeys/HotkeysAbi.g.cs      text eol=lf

# Binary assets: never line-ending-converted or diffed as text, whatever core.autocrlf
# says. (A text-mode sweep once rewrote the app icon .icns's LFs as CRLFs and broke it.)
*.icns  binary
*.ico   binary
*.cur   binary
*.png   binary
*.webp  binary
*.gif   binary
*.ttf   binary
*.onnx  binary
# prisc_vid2gif test fixtures (crates/prisc_vid2gif/tests/fixtures/clip.{mp4,mkv}).
*.mp4   binary
*.mkv   binary
