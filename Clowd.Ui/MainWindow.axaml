<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Clowd.Ui.ViewModels"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
        x:Class="Clowd.Ui.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Clowd"
        Width="900" Height="600"
        MinWidth="700" MinHeight="450"
        Background="{DynamicResource SystemRegionBrush}">

    <Grid ColumnDefinitions="220,*">

        <!-- Sidebar -->
        <Border Grid.Column="0"
                Background="{DynamicResource SystemAltMediumColor}"
                BorderBrush="{DynamicResource SystemBaseLowColor}"
                BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True" Margin="0,16,0,16">

                <!-- Logo header -->
                <StackPanel DockPanel.Dock="Top" Margin="20,0,20,24" Orientation="Horizontal" Spacing="10">
                    <Viewbox Width="28" Height="28">
                        <Path Data="{StaticResource LogoGeometry}" Fill="#00AFF0" />
                    </Viewbox>
                    <StackPanel VerticalAlignment="Center" Spacing="0">
                        <TextBlock Text="CLOWD"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#00AFF0" />
                        <TextBlock Text="Screen Capture Tool"
                                   FontSize="10"
                                   Opacity="0.6" />
                    </StackPanel>
                </StackPanel>

                <!-- Nav list -->
                <ListBox ItemsSource="{Binding NavItems}"
                         SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="8,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="vm:NavItem">
                            <Grid ColumnDefinitions="32,*" Height="36">
                                <Viewbox Grid.Column="0" Width="18" Height="18">
                                    <Path Data="{Binding Icon}"
                                          Fill="{DynamicResource SystemBaseHighColor}" />
                                </Viewbox>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Label}"
                                           VerticalAlignment="Center"
                                           FontSize="14" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="8,2" />
                            <Setter Property="CornerRadius" Value="6" />
                            <Setter Property="Margin" Value="0,2" />
                        </Style>
                    </ListBox.Styles>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Content area -->
        <Border Grid.Column="1" Padding="32,28">
            <ContentControl Content="{Binding CurrentView}" />
        </Border>
    </Grid>
</Window>
