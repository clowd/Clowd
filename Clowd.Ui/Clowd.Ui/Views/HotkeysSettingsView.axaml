<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Clowd.Ui.ViewModels.Pages"
             xmlns:settings="using:Clowd.Ui.Models.Settings"
             x:Class="Clowd.Ui.Views.HotkeysSettingsView"
             x:DataType="vm:HotkeysViewModel">
    <ScrollViewer>
        <StackPanel Spacing="20" MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Text="Hotkeys" FontSize="24" FontWeight="SemiBold" />

            <Border Background="{DynamicResource SystemAccentColorLight2}"
                    CornerRadius="6"
                    Padding="14,10">
                <TextBlock Text="Note: global hotkeys are handled by the Clowd capture process. They are saved here but not active in this build."
                           TextWrapping="Wrap"
                           FontSize="12" />
            </Border>

            <ItemsControl ItemsSource="{Binding Entries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:HotkeyEntry">
                        <Grid ColumnDefinitions="*,200,Auto" Margin="0,0,0,8" VerticalAlignment="Center">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding Label}"
                                       VerticalAlignment="Center" />
                            <Border Grid.Column="1"
                                    BorderBrush="{DynamicResource SystemBaseLowColor}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="10,6"
                                    Margin="12,0">
                                <TextBlock Text="{Binding Trigger.KeyGestureText}"
                                           FontFamily="Consolas, monospace"
                                           VerticalAlignment="Center"
                                           Opacity="0.85" />
                            </Border>
                            <Button Grid.Column="2"
                                    Content="Change..."
                                    Click="OnChangeClicked"
                                    Tag="{Binding Trigger}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
