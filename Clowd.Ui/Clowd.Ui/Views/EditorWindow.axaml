<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:drawing="clr-namespace:Clowd.Drawing;assembly=Clowd.Drawing"
        xmlns:converters="clr-namespace:Clowd.Ui.Converters"
        x:Class="Clowd.Ui.Views.EditorWindow"
        x:CompileBindings="False"
        Title="Edit - Clowd"
        Width="1050"
        Height="750"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <converters:SkillFlagConverter x:Key="SkillFlag" />
        <converters:ToolEqualityConverter x:Key="ToolEquals" />

        <!-- ================= Vector icons (ported from WPF VectorIcons.xaml) ================= -->
        <!-- The Data strings are the exact path-mini-language geometries from
             C:\Source\Clowd\src\Clowd\Assets\VectorIcons.xaml, sized to fit the
             44x40 tool buttons / 26x26 command buttons. -->

