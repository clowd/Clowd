<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Clowd.Ui.Controls.ColorPicker"
        x:Class="Clowd.Ui.Views.Dialogs.ColorPickerDialog"
        Title="Clowd - Color Picker"
        Icon="/Assets/clowd.ico"
        SizeToContent="WidthAndHeight"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Window.Styles>
        <Style Selector="local|ColorSlider">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Height" Value="16" />
            <Setter Property="ClipToBounds" Value="False" />
        </Style>
        <Style Selector="local|ColorPaletteItem">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
        </Style>
        <Style Selector="TextBlock.row">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>
        <Style Selector="TextBox.swatch">
            <!-- Override Fluent's default MinHeight (32) and Padding (~12,5) so
                 the TextBox fits inside the original 28px row without clipping
                 the descenders of its content. -->
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="Margin" Value="10,2,0,1" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.copy">
            <Setter Property="Margin" Value="10,0,0,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.footer">
            <Setter Property="Padding" Value="18,6" />
            <Setter Property="MinWidth" Value="84" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Styles>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Left column: spectrum + palette -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <local:ColorWheel x:Name="Wheel"
                              Width="200"
                              Height="200"
                              Margin="20" />

            <WrapPanel x:Name="ColorPaletteHost"
                       Grid.Row="1"
                       Width="256"
                       Height="96"
                       Margin="10,0,10,10"
                       VerticalAlignment="Bottom"
                       Orientation="Horizontal"
                       ItemWidth="16"
                       ItemHeight="16" />
        </Grid>

        <!-- Right column: numeric controls + footer -->
        <Grid Grid.Column="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="80" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="28" />
                <RowDefinition Height="16" />
                <RowDefinition Height="28" />
                <RowDefinition Height="28" />
                <RowDefinition Height="28" />
                <RowDefinition Height="28" />
                <RowDefinition Height="28" />
                <RowDefinition Height="16" />
                <RowDefinition Height="28" />
                <RowDefinition Height="28" />
                <RowDefinition Height="28" />
                <RowDefinition Height="28" />
                <RowDefinition Height="16" />
                <RowDefinition Height="*" />
                <RowDefinition Height="40" />
            </Grid.RowDefinitions>

            <!-- HEX -->
            <TextBlock Grid.Row="0" Classes="row" Text="HEX:" />
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtHex" Margin="0" />
            <Button  Grid.Row="0" Grid.Column="2" x:Name="BtnCopyHex"
                     Classes="copy" Click="OnCopyHex" Content="Copy HEX" />

            <!-- RGB summary + copy -->
            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="LblRgb"
                       HorizontalAlignment="Left" VerticalAlignment="Center"
                       FontFamily="Consolas" />
            <Button    Grid.Row="2" Grid.Column="2" x:Name="BtnCopyRgb"
                       Classes="copy" Click="OnCopyRgb" Content="Copy RGB" />

            <!-- R / G / B / A sliders -->
            <TextBlock Grid.Row="3" Classes="row" Text="R:" />
            <local:ColorSlider Grid.Row="3" Grid.Column="1" x:Name="SldR" ValueMax="255" />
            <TextBox Grid.Row="3" Grid.Column="2" x:Name="TxtR" Classes="swatch" />

            <TextBlock Grid.Row="4" Classes="row" Text="G:" />
            <local:ColorSlider Grid.Row="4" Grid.Column="1" x:Name="SldG" ValueMax="255" />
            <TextBox Grid.Row="4" Grid.Column="2" x:Name="TxtG" Classes="swatch" />

            <TextBlock Grid.Row="5" Classes="row" Text="B:" />
            <local:ColorSlider Grid.Row="5" Grid.Column="1" x:Name="SldB" ValueMax="255" />
            <TextBox Grid.Row="5" Grid.Column="2" x:Name="TxtB" Classes="swatch" />

            <TextBlock Grid.Row="6" Classes="row" Text="A:" />
            <local:ColorSlider Grid.Row="6" Grid.Column="1" x:Name="SldA" ValueMax="1" />
            <TextBox Grid.Row="6" Grid.Column="2" x:Name="TxtA" Classes="swatch" />

            <!-- HSL summary + copy -->
            <TextBlock Grid.Row="8" Grid.Column="1" x:Name="LblHsl"
                       HorizontalAlignment="Left" VerticalAlignment="Center"
                       FontFamily="Consolas" />
            <Button    Grid.Row="8" Grid.Column="2" x:Name="BtnCopyHsl"
                       Classes="copy" Click="OnCopyHsl" Content="Copy HSL" />

            <!-- H / S / L sliders -->
            <TextBlock Grid.Row="9" Classes="row" Text="H:" />
            <local:ColorSlider Grid.Row="9" Grid.Column="1" x:Name="SldH" ValueMax="360" />
            <TextBox Grid.Row="9" Grid.Column="2" x:Name="TxtH" Classes="swatch" />

            <TextBlock Grid.Row="10" Classes="row" Text="S:" />
            <local:ColorSlider Grid.Row="10" Grid.Column="1" x:Name="SldS" ValueMax="1" />
            <TextBox Grid.Row="10" Grid.Column="2" x:Name="TxtS" Classes="swatch" />

            <TextBlock Grid.Row="11" Classes="row" Text="L:" />
            <local:ColorSlider Grid.Row="11" Grid.Column="1" x:Name="SldL" ValueMax="1" />
            <TextBox Grid.Row="11" Grid.Column="2" x:Name="TxtL" Classes="swatch" />

            <!-- Footer: prev/new swatch + Cancel + OK -->
            <StackPanel Grid.Row="14" Grid.ColumnSpan="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Spacing="10">
                <Border Width="108"
                        Height="28"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource SystemBaseMediumColor}">
                    <Panel x:Name="PrevColorHost" ClipToBounds="True" />
                </Border>
                <Button x:Name="BtnCancel"
                        Classes="footer"
                        Click="OnCancel"
                        IsCancel="True"
                        Content="Cancel" />
                <Button x:Name="BtnOK"
                        Classes="footer"
                        Click="OnOk"
                        IsDefault="True"
                        Content="OK" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
