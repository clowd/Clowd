<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Clowd.Ui.ViewModels.Pages"
             x:Class="Clowd.Ui.Views.AboutView"
             x:DataType="vm:AboutViewModel">
    <ScrollViewer>
        <StackPanel Spacing="14" MaxWidth="640" HorizontalAlignment="Left">

            <TextBlock Text="CLOWD"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#00AFF0" />

            <TextBlock Text="{Binding Version}"
                       FontSize="14"
                       Opacity="0.7" />

            <TextBlock Text="{Binding Description}"
                       TextWrapping="Wrap"
                       FontSize="13" />

            <TextBlock Text="Settings can be reached from the system tray icon. Press the Print Screen key (or your configured hotkey) to start a capture."
                       TextWrapping="Wrap"
                       FontSize="13"
                       Opacity="0.85" />

            <Button Content="Open project on GitHub"
                    Click="OnOpenGitHub"
                    HorizontalAlignment="Left"
                    Margin="0,4,0,0" />

            <TextBlock Text="Built with the help of these open source projects:"
                       Margin="0,12,0,4"
                       FontSize="13"
                       Opacity="0.85" />

            <ItemsControl ItemsSource="{Binding Dependencies}" Margin="12,0,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:DependencyInfo">
                        <TextBlock Text="{Binding Name}" Margin="0,2" Opacity="0.85" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
