<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Clowd.Ui.Views.Dialogs.KeyCaptureDialog"
        Title="Press a key combination"
        Width="380" Height="180"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">
    <Grid Margin="22">
        <StackPanel Spacing="14" VerticalAlignment="Center">
            <TextBlock Text="Press the keys you want to assign..."
                       FontSize="14"
                       HorizontalAlignment="Center" />

            <Border BorderBrush="{DynamicResource SystemBaseLowColor}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14,10"
                    HorizontalAlignment="Center"
                    MinWidth="220">
                <TextBlock x:Name="GestureText"
                           Text="(waiting...)"
                           FontFamily="Consolas, monospace"
                           FontSize="14"
                           HorizontalAlignment="Center" />
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                <Button Content="Save" Click="OnSave" IsDefault="True" />
                <Button Content="Cancel" Click="OnCancel" IsCancel="True" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
